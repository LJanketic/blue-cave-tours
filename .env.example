PUBLIC_SITE_URL=https://hello-blue-cave.netlify.app

# Cloudflare Turnstile — contact form bot protection.
# Leave unset locally: the widget/verification are skipped when empty, so
# `pnpm dev` keeps working without keys. Set both in Netlify before launch.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Admin (/admin). Without ADMIN_PASSWORD the admin is locked; in `pnpm dev`
# the password defaults to "demo". ADMIN_SESSION_SECRET is optional: set a
# long random string to sign login cookies with something other than the password.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Where booking and enquiry notifications go (defaults to the contact address).
ADMIN_EMAIL=

# Email delivery. Leave empty for the showcase: every email is still recorded
# and readable in /admin/emails, just not sent. Set both to send through Brevo
# (needs a verified sender on the new domain).
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=Hello Blue Cave
# While checkout is the demo, real emails only go to ADMIN_EMAIL and these
# addresses (comma-separated), e.g. the boss's own address for the showcase.
EMAIL_DEMO_ALLOWLIST=
