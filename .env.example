PUBLIC_SITE_URL=https://hello-blue-cave.netlify.app

# Cloudflare Turnstile — contact form bot protection.
# Leave unset locally: the widget/verification are skipped when empty, so
# `pnpm dev` keeps working without keys. Set both in Netlify before launch.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Server settings in this file are read by `pnpm dev` (copied into process.env
# in dev only). On Netlify, set them as site environment variables instead.

# Admin (/admin). Without ADMIN_PASSWORD and ADMIN_SESSION_SECRET the admin is
# locked; in `pnpm dev` the password defaults to "demo". ADMIN_SESSION_SECRET
# signs login cookies and is never derived from the password; changing it signs
# everyone out. Generate with: openssl rand -base64 32
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Where booking and enquiry notifications go (defaults to the contact address).
ADMIN_EMAIL=

# Email delivery through Resend (resend.com, free: 100 emails a day). Leave
# RESEND_API_KEY empty for the showcase: every email is still recorded and
# readable in /admin/emails, just not sent. Without EMAIL_FROM, mail goes out
# from Resend's test sender (onboarding@resend.dev), which Resend only
# delivers to the address the Resend account was created with. Set EMAIL_FROM
# once our own domain is verified in Resend.
# Even with a key, nothing is sent unless EMAIL_SENDING=on is also set
# (per Netlify deploy context). Without it, emails are quietly only saved.
RESEND_API_KEY=
EMAIL_SENDING=
EMAIL_FROM=
EMAIL_FROM_NAME=Hello Blue Cave
# While checkout is the demo, real emails only go to ADMIN_EMAIL and these
# addresses (comma-separated), e.g. the boss's own address for the showcase.
EMAIL_DEMO_ALLOWLIST=

# Booking cookie and rate-limit salt (required in production). The booking in
# progress is kept in a sealed cookie; rate-limit buckets store a keyed hash,
# never the IP. Each secret is used for its one job only, and none is derived
# from another or from the admin password. Without them, online booking is
# switched off (it fails closed); `pnpm dev` uses fixed dev-only keys.
# Generate each with: openssl rand -base64 32 (at least 32 characters)
BOOKING_COOKIE_SECRET=
RATE_LIMIT_SALT=
