# pnpm's default isolated node_modules layout confuses @vercel/nft (used by
# @astrojs/netlify to bundle the SSR function): it statically traces sharp's
# per-platform optional native binaries and crashes when it can't realpath
# the ones that aren't installed for the current machine (only one platform's
# binary is ever installed). A hoisted, npm-like layout is the documented fix.
node-linker=hoisted
