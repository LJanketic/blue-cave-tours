---
import '../styles/global.css';
import '../styles/icons.css';
import iconFontUrl from '../assets/fonts/tabler-icons-subset.woff2?url';
import {
	APPLE_TOUCH_ICON_PATH,
	FAVICON_PATH,
	SITE_DEFAULT_DESCRIPTION,
	SITE_NAME,
	SITE_THEME_COLOR,
} from '../config/site';
import { DEFAULT_OG_IMAGE } from '../lib/seo';

type Props = {
	title: string;
	description?: string;
	ogImage?: string;
	ogImageAlt?: string;
	/** False on pages that shouldn't declare a canonical URL (the 404 page). */
	canonical?: boolean;
	robots?: string;
	jsonLd?: Record<string, unknown> | Record<string, unknown>[];
};

const {
	title,
	description = SITE_DEFAULT_DESCRIPTION,
	ogImage,
	ogImageAlt = `${SITE_NAME} — Split boat tours`,
	canonical: showCanonical = true,
	robots,
	jsonLd,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, String(Astro.site ?? Astro.url));
const ogImagePath = ogImage ?? DEFAULT_OG_IMAGE;
const ogImageUrl = new URL(ogImagePath, Astro.site ?? Astro.url).href;
const jsonLdBlocks = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={FAVICON_PATH} />
		<link rel="apple-touch-icon" href={APPLE_TOUCH_ICON_PATH} />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content={SITE_THEME_COLOR} />
		<meta name="description" content={description} />
		{robots && <meta name="robots" content={robots} />}
		{showCanonical && <link rel="canonical" href={canonical.href} />}

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={SITE_NAME} />
		<meta property="og:locale" content="en_GB" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		{showCanonical && <meta property="og:url" content={canonical.href} />}
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={ogImageAlt} />
		<meta property="og:image:type" content="image/jpeg" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />
		<meta name="twitter:image:alt" content={ogImageAlt} />

		<!--
			Self-hosted subset of the Tabler icon font (scripts/icons.mjs): ~13 KB
			instead of ~450 KB from a CDN. Preloaded so icons don't pop in late.
		-->
		<link rel="preload" href={iconFontUrl} as="font" type="font/woff2" crossorigin />

		<title>{title}</title>

		{
			jsonLdBlocks.map((block) => (
				<script is:inline type="application/ld+json" set:html={JSON.stringify(block)} />
			))
		}

		<slot name="head" />
	</head>
	<body>
		<slot />
	</body>
</html>
