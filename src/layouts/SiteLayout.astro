---
// The public stylesheet. Admin pages load src/styles/admin.css instead (AdminLayout).
import '../styles/global.css';
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

type Props = {
	title: string;
	description?: string;
	/** Checkout mode — hides the full site Header/Footer so pages can use the
	 * minimal MiniNav + TrustStrip chrome instead (reduces mid-funnel fall-off). */
	checkout?: boolean;
	ogImage?: string;
	ogImageAlt?: string;
	/** False on pages that shouldn't declare a canonical URL (the 404 page). */
	canonical?: boolean;
	solidNav?: boolean;
	robots?: string;
	jsonLd?: Record<string, unknown> | Record<string, unknown>[];
	/** Passed to BaseLayout: preload the display font on pages with a display hero. */
	fontPreload?: boolean;
	/** Space above the footer (spec §5.2), e.g. 'var(--section-gap)'. Default 0. */
	footerGap?: string;
};

const {
	title,
	description,
	checkout = false,
	ogImage,
	ogImageAlt,
	canonical = true,
	solidNav = true,
	robots,
	jsonLd,
	fontPreload = false,
	footerGap,
} = Astro.props;
---

<BaseLayout
	title={title}
	description={description}
	ogImage={ogImage}
	ogImageAlt={ogImageAlt}
	canonical={canonical}
	robots={robots}
	jsonLd={jsonLd}
	fontPreload={fontPreload}
>
	<slot name="head" slot="head" />
	<div class:list={['site-shell', checkout && 'site-shell--checkout']}>
		<a class="skip-link" href="#main">Skip to content</a>
		{!checkout && <Header solid={solidNav} />}
		<slot />
		{!checkout && <Footer gap={footerGap} />}
	</div>
</BaseLayout>
