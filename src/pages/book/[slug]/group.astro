---
export const prerender = true;

/**
 * Group booking, step 2 (spec §8.1.2). With JavaScript: the GroupBookingFlow
 * island. Without it: a plain form with native inputs that posts to the same
 * endpoint (§3.5); the page shows whichever applies.
 */
import { Image } from 'astro:assets';
import { pageTitle } from '../../../config/site';
import { SEASON_END, SEASON_START, seasonLabel } from '../../../config/season';
import SiteLayout from '../../../layouts/SiteLayout.astro';
import BookingShell from '../../../components/booking/BookingShell.astro';
import GroupBookingFlow from '../../../components/vue/GroupBookingFlow.vue';
import { getAllTours, getTourCardPhoto } from '../../../lib/tours';
import { DEFAULT_AGE_BANDS } from '../../../data/tour-catalog';
import { MAX_GUESTS, meetingPointShort, supportsInstantBook } from '../../../lib/booking';
import { businessDate } from '../../../lib/bookings/dates';
import { mandatoryFeeLabel } from '../../../lib/cards';
import type { TourDetail } from '../../../types/tour';

// Quote-only tours have no instant-book price; they're routed to the contact form everywhere.
export function getStaticPaths() {
	return getAllTours()
		.filter((tour) => supportsInstantBook(tour))
		.map((tour) => ({ params: { slug: tour.slug }, props: { tour } }));
}

type Props = { tour: TourDetail };
const { tour } = Astro.props;
// Split's date, so the calendar's "today" matches the server's (§8.1.2).
const renderedOn = businessDate();
const photo = getTourCardPhoto(tour);
const ageBands = tour.ageBands ?? DEFAULT_AGE_BANDS;
const fee = mandatoryFeeLabel(tour);
const counts = (max: number, min = 0) => Array.from({ length: max - min + 1 }, (_, i) => i + min);
---

<SiteLayout title={pageTitle(`Book: ${tour.title}`)} description={`Book ${tour.title}: choose a date, guests and contact details.`} checkout robots="noindex, nofollow">
	<BookingShell step={2} exitHref={`/tours/${tour.slug}/`} heading={`Book ${tour.title}`}>
		<div class="snap">
			{
				photo.src ? (
					<Image src={photo.src} alt="" widths={[112, 168]} sizes="56px" quality={70} format="webp" class="snap__img" />
				) : (
					<span class="snap__img snap__img--empty" aria-hidden="true">
						<i class="ti ti-sailboat" />
					</span>
				)
			}
			<div>
				<p class="snap__name">{tour.title}</p>
				<p class="snap__meta">{tour.duration} · {meetingPointShort(tour.meetingPoint)}</p>
			</div>
		</div>

		<div class="with-js">
			<GroupBookingFlow
				client:load
				tourSlug={tour.slug}
				tourTitle={tour.title}
				departures={tour.departures}
				adultPrice={tour.adultPrice}
				childPrice={tour.childPrice}
				priceNotes={tour.priceNotes}
				mandatoryFeeLabel={fee}
				ageBands={ageBands}
				renderedOn={renderedOn}
				seasonStart={SEASON_START}
				seasonEnd={SEASON_END}
				seasonLabel={seasonLabel()}
			/>
		</div>

		<!-- Without JavaScript: native controls, the same endpoint, a plain form post. -->
		<form class="no-js" method="post" action="/api/bookings/draft">
			<input type="hidden" name="tourId" value={tour.slug} />
			<p class="no-js__note">Fields marked * are required. Tours run {seasonLabel()}.</p>
			<label>Date *<input type="date" name="date" required min={renderedOn} /></label>
			{
				tour.departures.length > 1 ? (
					<label>
						Departure time
						<select name="slot">
							{tour.departures.map((d) => (
								<option value={d.time}>{d.time}</option>
							))}
						</select>
					</label>
				) : (
					<input type="hidden" name="slot" value={tour.departures[0]?.time ?? ''} />
				)
			}
			<label>Adults ({ageBands.adult}) *<select name="adults">{counts(MAX_GUESTS, 1).map((n) => <option selected={n === 2}>{n}</option>)}</select></label>
			<label>Children ({ageBands.child})<select name="children">{counts(MAX_GUESTS - 1).map((n) => <option>{n}</option>)}</select></label>
			<label>Infants (under {ageBands.infantMaxAge + 1}, free)<select name="infants">{counts(MAX_GUESTS - 1).map((n) => <option>{n}</option>)}</select></label>
			<p class="no-js__note">Up to {MAX_GUESTS} guests in total, infants included.</p>
			<label>First name *<input name="firstName" required autocomplete="given-name" /></label>
			<label>Last name *<input name="lastName" required autocomplete="family-name" /></label>
			<label>Email *<input name="email" type="email" required autocomplete="email" /></label>
			<label>Phone<input name="phone" type="tel" autocomplete="tel" /></label>
			<label>Anything the crew should know? (optional)<textarea name="notes" maxlength="500"></textarea></label>
			<button type="submit">Review booking</button>
		</form>
	</BookingShell>
</SiteLayout>

<style>
	@layer pages {
		.snap {
			display: flex;
			align-items: center;
			gap: var(--space-3);
			margin-bottom: var(--space-5);
			padding: var(--space-3) 14px;
			border-radius: var(--radius-lg);
			background: var(--color-background-secondary);
		}

		.snap__img {
			flex-shrink: 0;
			width: 56px;
			height: 56px;
			border-radius: var(--radius-md);
			object-fit: cover;
		}

		.snap__img--empty {
			display: flex;
			align-items: center;
			justify-content: center;
			background: var(--color-background-primary);
			color: var(--color-border-secondary);
			font-size: 24px;
		}

		.snap__name {
			margin: 0;
			font-weight: var(--font-weight-medium);
		}

		.snap__meta {
			margin: 0;
			font-size: var(--font-size-sm);
			color: var(--color-text-secondary);
		}

		/* One or the other: the island with JavaScript, the plain form without. */
		.no-js {
			display: none;
		}

		@media (scripting: none) {
			.with-js {
				display: none;
			}

			.no-js {
				display: grid;
				gap: var(--space-3);
			}
		}

		.no-js label {
			display: grid;
			gap: 4px;
			font-size: var(--font-size-sm);
			font-weight: var(--font-weight-medium);
		}

		.no-js input,
		.no-js select,
		.no-js textarea {
			min-height: 40px;
			padding: var(--space-2) 10px;
			border: 1px solid var(--color-border-input);
			border-radius: var(--radius-md);
			font: inherit;
		}

		.no-js button {
			min-height: 46px;
			border: 0;
			border-radius: var(--radius-btn);
			background: var(--color-background-brand);
			color: var(--color-text-on-image);
			font: inherit;
			font-weight: var(--font-weight-semibold);
		}

		.no-js__note {
			margin: 0;
			font-size: var(--font-size-sm);
			color: var(--color-text-secondary);
		}
	}
</style>
