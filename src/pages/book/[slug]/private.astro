---
export const prerender = true;

import { getAllTours, getTourBySlug } from '../../../lib/tours';
import { contactHrefForTour } from '../../../lib/booking';

export function getStaticPaths() {
	return getAllTours().map((tour) => ({
		params: { slug: tour.slug },
	}));
}

const slug = Astro.params.slug;
const tour = slug ? getTourBySlug(slug) : undefined;
if (!tour) {
	return Astro.redirect('/tours');
}

// No real private-charter booking flow exists yet — send guests to the
// contact form rather than the group flow, which would misrepresent a
// private-charter request as an instant group booking.
return Astro.redirect(contactHrefForTour(tour));
---
