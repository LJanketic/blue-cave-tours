---
export const prerender = false;

/**
 * Group booking, step 3: review (spec §8.1.3). Everything shown comes from
 * the sealed booking cookie; the price is recomputed here and again on the
 * server when the booking is made. "Continue to payment" posts only the
 * terms version the customer saw.
 */
import { Image } from 'astro:assets';
import { pageTitle } from '../../../config/site';
import { TERMS_VERSION } from '../../../config/legal';
import { CANCELLATION_FULL, CANCELLATION_SHORT } from '../../../config/cancellation';
import SiteLayout from '../../../layouts/SiteLayout.astro';
import BookingShell from '../../../components/booking/BookingShell.astro';
import Badge from '../../../components/ui/Badge.astro';
import Notice from '../../../components/ui/Notice.astro';
import Button from '../../../components/ui/Button.astro';
import { getTourBySlug, getTourCardPhoto } from '../../../lib/tours';
import { contactHrefForTour, formatBookingDate, guestSummaryFromCounts, meetingPointShort, supportsInstantBook } from '../../../lib/booking';
import { computeBookingTotal, lineItemsFor } from '../../../lib/price';
import { BOOKING_ERRORS, isBookingError } from '../../../lib/bookings/service';
import { BOOKING_COOKIE, openDraft } from '../../../lib/bookings/session';

const slug = Astro.params.slug;
const tour = slug ? getTourBySlug(slug) : undefined;
if (!tour) return Astro.redirect('/404');
// Quote-only tours have no instant-book review: they're routed to the contact form.
if (!supportsInstantBook(tour)) return Astro.redirect(contactHrefForTour(tour));

// From the sealed cookie, never the URL (S-2). No cookie, an expired one, or one for
// another tour: back to step 2. Old links with details in the query get the same.
const PERSONAL_PARAMS = ['firstName', 'lastName', 'email', 'phone', 'notes', 'adults', 'date'];
const draft = openDraft(Astro.cookies.get(BOOKING_COOKIE)?.value);
if (!draft || draft.tourSlug !== tour.slug || PERSONAL_PARAMS.some((p) => Astro.url.searchParams.has(p))) {
	return Astro.redirect(`/book/${tour.slug}/group/?error=session-expired`, 303);
}
Astro.response.headers.set('Cache-Control', 'no-store');
Astro.response.headers.set('Referrer-Policy', 'no-referrer');

const errorParam = Astro.url.searchParams.get('error');
const bookingError = isBookingError(errorParam) ? BOOKING_ERRORS[errorParam] : null;
// Step 2 refills itself from the cookie (WCAG 3.3.7).
const editHref = `/book/${tour.slug}/group/`;

const total = computeBookingTotal(tour, draft.adults, draft.children);
const items = lineItemsFor(tour, draft.adults, draft.children, draft.infants) ?? [];
const fees = tour.additionalFees.filter((fee) => fee.mandatory);
const photo = getTourCardPhoto(tour);
---

<SiteLayout title={pageTitle(`Review booking: ${tour.title}`)} description={`Review your booking for ${tour.title}.`} checkout robots="noindex, nofollow">
	<BookingShell step={3} exitHref={`/tours/${tour.slug}/`} heading="Review your booking">
		{bookingError && <Notice tone="danger" alert class="review__alert">{bookingError}</Notice>}

		<section class="review__card" aria-labelledby="trip-heading">
			<div class="review__head">
				<h2 id="trip-heading"><i class="ti ti-sailboat" aria-hidden="true"></i> Tour details</h2>
				<a href={editHref} aria-label="Edit tour details">Edit</a>
			</div>
			<div class="review__trip">
				{
					photo.src ? (
						<Image src={photo.src} alt="" widths={[128, 192]} sizes="64px" quality={70} format="webp" class="review__thumb" />
					) : (
						<span class="review__thumb review__thumb--empty" aria-hidden="true">
							<i class="ti ti-sailboat" />
						</span>
					)
				}
				<div>
					<p class="review__tour">{tour.title}</p>
					<Badge tone="brand" icon="users">Group tour</Badge>
				</div>
			</div>
			<dl class="review__rows">
				<div><dt><i class="ti ti-calendar" aria-hidden="true"></i> Date</dt><dd>{formatBookingDate(draft.date)}</dd></div>
				<div><dt><i class="ti ti-clock" aria-hidden="true"></i> Departure</dt><dd>{draft.slot || 'Confirmed at booking'}</dd></div>
				<div><dt><i class="ti ti-hourglass" aria-hidden="true"></i> Duration</dt><dd>{tour.duration}</dd></div>
				<div><dt><i class="ti ti-map-pin" aria-hidden="true"></i> Meeting point</dt><dd>{meetingPointShort(tour.meetingPoint)}</dd></div>
			</dl>
		</section>

		<section class="review__card" aria-labelledby="guests-heading">
			<div class="review__head">
				<h2 id="guests-heading"><i class="ti ti-users" aria-hidden="true"></i> Guests</h2>
				<a href={editHref} aria-label="Edit guests">Edit</a>
			</div>
			<p class="review__line">{guestSummaryFromCounts(draft.adults, draft.children, draft.infants)}</p>
		</section>

		<section class="review__card" aria-labelledby="details-heading">
			<div class="review__head">
				<h2 id="details-heading"><i class="ti ti-user" aria-hidden="true"></i> Guest details</h2>
				<a href={editHref} aria-label="Edit guest details">Edit</a>
			</div>
			<dl class="review__rows">
				<div><dt>Name</dt><dd>{draft.firstName} {draft.lastName}</dd></div>
				<div><dt>Email</dt><dd>{draft.email}</dd></div>
				<div><dt>Phone</dt><dd>{draft.phone || 'Not given'}</dd></div>
				<div><dt>Notes</dt><dd class="review__wrap">{draft.notes || 'None'}</dd></div>
			</dl>
		</section>

		<section class="review__card" aria-labelledby="price-heading">
			<div class="review__head">
				<h2 id="price-heading"><i class="ti ti-receipt" aria-hidden="true"></i> Price</h2>
			</div>
			<dl class="review__rows">
				{
					items.map((item) => (
						<div>
							<dt>{item.amount === 0 && item.unit === 0 ? item.label : `${item.label} (${item.qty} × €${item.unit})`}</dt>
							<dd>€{item.amount}</dd>
						</div>
					))
				}
			</dl>
			<p class="review__total"><span>Total</span><span>{total !== null ? `€${total}` : 'On request'}</span></p>
			{fees.map((fee) => <p class="review__fee">+ {fee.shortText}{fee.amountLabel && ` (${fee.amountLabel})`}</p>)}
			<p class="review__fee">{tour.priceNotes}</p>
		</section>

		<section class="review__card" aria-labelledby="policy-heading">
			<div class="review__head">
				<h2 id="policy-heading"><i class="ti ti-shield-check review__ok" aria-hidden="true"></i> Cancellation policy</h2>
			</div>
			<p class="review__policy">{CANCELLATION_FULL}</p>
		</section>

		<form method="post" action="/api/bookings" class="review__form">
			<!-- Only the terms version: the booking itself comes from the sealed cookie. -->
			<input type="hidden" name="termsVersion" value={TERMS_VERSION} />
			<!-- Pre-contract information (§8.1.3); the lawyer confirms the wording (PR 11). -->
			<p class="review__legal">
				This booking is for a leisure service on a fixed date, so the 14-day right of withdrawal for online purchases
				does not apply. You can still cancel under our <a href="/legal/cancellation/">cancellation policy</a>:
				{CANCELLATION_SHORT.toLowerCase()}. By continuing you agree to our <a href="/legal/terms/">Terms</a>. How we use
				your data: <a href="/legal/privacy/">Privacy policy</a>.
			</p>
			<Button type="submit" size="lg" block iconEnd="arrow-right">Continue to payment</Button>
		</form>
	</BookingShell>
</SiteLayout>

<style>
	@layer pages {
		:global(.review__alert) {
			margin-bottom: var(--space-3);
		}

		.review__card {
			margin-bottom: var(--space-3);
			padding: 1.25rem;
			border: 1px solid var(--color-border-card);
			border-radius: var(--radius-lg);
		}

		.review__head {
			display: flex;
			align-items: center;
			justify-content: space-between;
			margin-bottom: var(--space-3);
		}

		.review__head h2 {
			display: flex;
			align-items: center;
			gap: var(--space-2);
			margin: 0;
			font-size: var(--font-size-lg);
			font-weight: var(--font-weight-medium);
		}

		.review__head .ti {
			font-size: 16px;
			color: var(--color-accent);
		}

		.review__head .review__ok {
			color: var(--color-text-success);
		}

		.review__head a {
			display: inline-flex;
			align-items: center;
			min-height: 24px;
			font-size: var(--font-size-sm);
			color: var(--color-text-info);
		}

		.review__trip {
			display: flex;
			align-items: center;
			gap: var(--space-3);
			margin-bottom: var(--space-3);
		}

		.review__thumb {
			flex-shrink: 0;
			width: 64px;
			height: 64px;
			border-radius: var(--radius-md);
			object-fit: cover;
		}

		.review__thumb--empty {
			display: flex;
			align-items: center;
			justify-content: center;
			background: var(--color-background-secondary);
			color: var(--color-border-secondary);
			font-size: 24px;
		}

		.review__tour {
			margin: 0 0 4px;
			font-weight: var(--font-weight-medium);
		}

		.review__rows {
			margin: 0;
		}

		.review__rows div {
			display: flex;
			justify-content: space-between;
			gap: var(--space-4);
			padding: 5px 0;
			font-size: var(--font-size-base);
		}

		.review__rows dt {
			display: flex;
			align-items: center;
			gap: 6px;
			flex-shrink: 0;
			color: var(--color-text-secondary);
		}

		.review__rows dt .ti {
			font-size: 13px;
			color: var(--color-text-tertiary);
		}

		.review__rows dd {
			margin: 0;
			font-weight: var(--font-weight-medium);
			text-align: right;
			overflow-wrap: anywhere;
		}

		.review__wrap {
			white-space: pre-line;
		}

		.review__line {
			margin: 0;
		}

		.review__total {
			display: flex;
			justify-content: space-between;
			margin: var(--space-3) 0 0;
			padding-top: var(--space-3);
			border-top: 0.5px solid var(--color-border-tertiary);
			font-size: var(--font-size-xl);
			font-weight: var(--font-weight-medium);
		}

		.review__fee {
			margin: 6px 0 0;
			font-size: var(--font-size-xs);
			color: var(--color-text-secondary);
		}

		.review__policy {
			margin: 0;
			padding: var(--space-3);
			border-radius: var(--radius-md);
			background: var(--color-background-secondary);
			font-size: var(--font-size-body-sm);
			line-height: var(--line-height-body-sm);
			color: var(--color-text-secondary);
		}

		.review__form {
			margin-top: var(--space-4);
		}

		.review__legal {
			margin: 0 0 var(--space-3);
			font-size: var(--font-size-sm);
			line-height: var(--line-height-normal);
			color: var(--color-text-secondary);
		}

		.review__legal a {
			color: var(--color-text-info);
		}
	}
</style>
