---
export const prerender = false;

/**
 * Group booking and private experience, step 3: review (spec §8.1.3, plan P). Everything shown comes from
 * the sealed booking cookie; the price is recomputed here and again on the
 * server when the booking is made. "Continue to payment" posts only the
 * terms version the customer saw.
 */
import { pageTitle } from '../../../config/site';
import { TERMS_VERSION } from '../../../config/legal';
import { CANCELLATION_FULL_PREFIX, CANCELLATION_FULL_SUFFIX, CANCELLATION_PRIVATE_HREF, CANCELLATION_PRIVATE_SHORT, CANCELLATION_SHORT, CANCELLATION_WINDOW } from '../../../config/cancellation';
import { PAYMENTS_ARE_DEMO } from '../../../config/payments';
import { DEFAULT_PICKUP_ID, privatePickup } from '../../../config/private';
import SiteLayout from '../../../layouts/SiteLayout.astro';
import BookingShell from '../../../components/booking/BookingShell.astro';
import Badge from '../../../components/ui/Badge.astro';
import Notice from '../../../components/ui/Notice.astro';
import Button from '../../../components/ui/Button.astro';
import { getTourBySlug, getTourCardPhoto } from '../../../lib/tours';
import { thumbImage } from '../../../data/destination-photos';
import { feeLabel } from '../../../lib/cards';
import {
	contactHrefForTour,
	formatBookingDate,
	guestSummaryFromCounts,
	meetingPointShort,
	privateBookHref,
	supportsInstantBook,
	supportsPrivateBook,
} from '../../../lib/booking';
import { computeBookingTotal, formatEuro, lineItemsFor, lineItemsTotal, privateLineItems } from '../../../lib/price';
import { BOOKING_ERRORS, isBookingError } from '../../../lib/bookings/service';
import { BOOKING_COOKIE, openDraft } from '../../../lib/bookings/session';

const slug = Astro.params.slug;
const tour = slug ? getTourBySlug(slug) : undefined;
if (!tour) return Astro.redirect('/404');
const instant = supportsInstantBook(tour);
const privateBook = supportsPrivateBook(tour);
// Quote-only tours have no review: they're routed to the contact form.
if (!instant && !privateBook) return Astro.redirect(contactHrefForTour(tour, 'group'));

// From the sealed cookie, never the URL (S-2). No cookie, an expired one, or one for
// another tour: back to step 2. Old links with details in the query get the same.
const PERSONAL_PARAMS = ['firstName', 'lastName', 'email', 'phone', 'notes', 'adults', 'date'];
const draft = openDraft(Astro.cookies.get(BOOKING_COOKIE)?.value);
const isPrivate = draft?.kind === 'private';
// Which step 2 this is: the draft's kind, or, once the cookie for this tour is gone, the
// `flow` the private flow puts in its review links (nothing personal). Step 2 refills
// itself from the cookie (WCAG 3.3.7).
const privateFlow = draft?.tourSlug === tour.slug ? isPrivate : Astro.url.searchParams.get('flow') === 'private';
const editHref = (privateFlow && privateBook) || !instant ? privateBookHref(tour) : `/book/${tour.slug}/group/`;
if (!draft || draft.tourSlug !== tour.slug || (isPrivate ? !privateBook : !instant) || PERSONAL_PARAMS.some((p) => Astro.url.searchParams.has(p))) {
	return Astro.redirect(`${editHref}?error=session-expired`, 303);
}
Astro.response.headers.set('Cache-Control', 'no-store');

const errorParam = Astro.url.searchParams.get('error');
const bookingError = isBookingError(errorParam) ? BOOKING_ERRORS[errorParam] : null;

// Priced by the tour date's season (not today's), as createPendingBooking charges it.
// A private experience: the boat, the extras and the pick-up (src/config/private.ts).
const priced = isPrivate ? privateLineItems(tour.slug, draft.date, draft.extras ?? [], draft.pickup ?? '') : null;
// The lists changed since the draft was made (an extra or pick-up withdrawn): choose again, never a €0 total.
if (isPrivate && !priced) return Astro.redirect(`${editHref}?error=${privatePickup(draft.pickup ?? '') ? 'extras' : 'pickup'}`, 303);
const privateItems = priced ?? [];
const total = isPrivate ? lineItemsTotal(privateItems) : computeBookingTotal(tour, draft.date, draft.adults, draft.children);
const items = isPrivate ? privateItems : (lineItemsFor(tour, draft.date, draft.adults, draft.children, draft.infants) ?? []);
const fee = feeLabel(tour);
// Board 06a: the departure with its return ("07:20 (back 18:00)"); a private boat can leave later, so just its time.
const back = tour.returnTime.replace(/^Approx\.\s*/, '').replace(/^\d{2}:\d{2}[–-]/, '');
const departure = isPrivate ? draft.slot : `${draft.slot} (back ${back})`;
// Board 06a: "Includes all taxes and fees · Blue Cave ticket paid on site".
const includes = ['Includes all taxes and fees', ...(fee ? [fee.replace(/^\+\s*/, '')] : [])].join(' · ');
const notes = draft.notes?.trim() ?? '';
const pickup = isPrivate && draft.pickup && draft.pickup !== DEFAULT_PICKUP_ID ? privatePickup(draft.pickup)?.label : undefined;
const thumb = thumbImage(getTourCardPhoto(tour));
---

<SiteLayout title={pageTitle(`Review booking: ${tour.title}`)} description={`Review your booking for ${tour.title}.`} checkout robots="noindex, nofollow">
	<BookingShell step={3} exitHref={`/tours/${tour.slug}/`} heading="Review your booking">
		{bookingError && <Notice tone="danger" alert class="review__alert">{bookingError}</Notice>}

		<section class="review__card" aria-labelledby="trip-heading">
			<div class="review__head">
				<h2 id="trip-heading"><i class="ti ti-sailboat" aria-hidden="true"></i> Tour details</h2>
				<a href={editHref} aria-label="Edit tour details">Edit</a>
			</div>
			<div class="review__trip">
				{
					thumb ? (
						<img src={thumb.src} srcset={thumb.srcset} sizes="64px" width="64" height="64" alt="" class="review__thumb" />
					) : (
						<span class="review__thumb review__thumb--empty" aria-hidden="true">
							<i class="ti ti-sailboat" />
						</span>
					)
				}
				<div>
					<p class="review__tour">{tour.title}</p>
					{isPrivate ? <Badge tone="private" icon="crown">Private experience</Badge> : <Badge tone="brand" icon="users">Group tour</Badge>}
				</div>
			</div>
			<dl class="review__rows">
				<div><dt><i class="ti ti-calendar" aria-hidden="true"></i> Date</dt><dd>{formatBookingDate(draft.date)}</dd></div>
				<div><dt><i class="ti ti-clock" aria-hidden="true"></i> Departure</dt><dd>{departure}</dd></div>
				<div><dt><i class="ti ti-hourglass" aria-hidden="true"></i> Duration</dt><dd>{tour.duration}</dd></div>
				{
					pickup ? (
						<div><dt><i class="ti ti-map-pin" aria-hidden="true"></i> Pick-up</dt><dd>{pickup}</dd></div>
					) : (
						<div><dt><i class="ti ti-map-pin" aria-hidden="true"></i> Meeting point</dt><dd>{meetingPointShort(tour.meetingPoint)}</dd></div>
					)
				}
			</dl>
		</section>

		<section class="review__card" aria-labelledby="guests-heading">
			<div class="review__head">
				<h2 id="guests-heading"><i class="ti ti-users" aria-hidden="true"></i> Guests</h2>
				<a href={editHref} aria-label="Edit guests">Edit</a>
			</div>
			{
				isPrivate ? (
					<p class="review__line">{guestSummaryFromCounts(draft.adults, draft.children, draft.infants)}</p>
				) : (
					<dl class="review__rows">
						{items.map((item) => (
							<div><dt>{item.label.replace(' (free)', '')}</dt><dd>{item.unit ? `${item.qty} × ${formatEuro(item.unit)}` : `${item.qty} × free`}</dd></div>
						))}
					</dl>
				)
			}
		</section>

		<section class="review__card" aria-labelledby="details-heading">
			<div class="review__head">
				<h2 id="details-heading"><i class="ti ti-user" aria-hidden="true"></i> Guest details</h2>
				<a href={editHref} aria-label="Edit guest details">Edit</a>
			</div>
			<dl class="review__rows">
				<div><dt>Name</dt><dd>{draft.firstName} {draft.lastName}</dd></div>
				<div><dt>Email</dt><dd>{draft.email}</dd></div>
				<div><dt>Phone</dt><dd>{draft.phone || 'Not given'}</dd></div>
				<div><dt>Special requests</dt><dd>{notes ? 'Yes' : 'None'}</dd></div>
			</dl>
			{notes && <p class="review__quote"><i class="ti ti-message" aria-hidden="true"></i> <q>{notes}</q></p>}
		</section>

		<section class="review__card" aria-labelledby="price-heading">
			<div class="review__head">
				<h2 id="price-heading">Price breakdown</h2>
			</div>
			<dl class="review__rows">
				{
					items.map((item) => (
						<div>
							<dt>{isPrivate || (item.amount === 0 && item.unit === 0) ? item.label : `${item.label} (${item.qty} × ${formatEuro(item.unit)})`}</dt>
							<dd>{formatEuro(item.amount)}</dd>
						</div>
					))
				}
			</dl>
			<p class="review__total"><span>Total</span><span>{total !== null ? formatEuro(total) : 'On request'}</span></p>
			<p class="review__fee review__fee--end">{includes}</p>
			{isPrivate && <p class="review__fee review__fee--end">The price is for the whole boat with skipper, whatever the number of guests.</p>}
		</section>

		<section class="review__card" aria-labelledby="policy-heading">
			<div class="review__head">
				<h2 id="policy-heading"><i class="ti ti-shield-check review__ok" aria-hidden="true"></i> Cancellation policy</h2>
			</div>
			{
				isPrivate ? (
					<p class="review__policy">
						{CANCELLATION_PRIVATE_SHORT}: see <a href={CANCELLATION_PRIVATE_HREF}>section 3 of our cancellation policy</a>.
					</p>
				) : (
					<p class="review__policy">
						{CANCELLATION_FULL_PREFIX}<strong>{CANCELLATION_WINDOW}</strong>{CANCELLATION_FULL_SUFFIX}
					</p>
				)
			}
		</section>

		<form method="post" action="/api/bookings" class="review__form">
			<!-- Only the terms version and the draft stamp: the booking itself comes from the sealed cookie. -->
			<input type="hidden" name="termsVersion" value={TERMS_VERSION} />
			<!-- Which draft this page showed: another tab may have replaced the cookie since. -->
			<input type="hidden" name="draftAt" value={String(draft.createdAt)} />
			<!-- Pre-contract information (§8.1.3); the lawyer confirms the wording (PR 11). -->
			<p class="review__legal">
				This booking is for a leisure service on a fixed date, so the 14-day right of withdrawal for online purchases
				does not apply. You can still cancel under our <a href={isPrivate ? CANCELLATION_PRIVATE_HREF : '/legal/cancellation/'}>cancellation policy</a>{
					isPrivate ? ' for private experiences' : `: ${CANCELLATION_SHORT.toLowerCase()}`
				}. By continuing you agree to our <a href="/legal/terms/">Terms</a>. How we use your data:
				<a href="/legal/privacy/">Privacy policy</a>.
			</p>
			<Button type="submit" size="lg" block iconEnd="arrow-right">Continue to payment</Button>
			{/* Board 06a; while payments are a demo nothing goes to Teya, and the checkout strip says so instead. */}
			{!PAYMENTS_ARE_DEMO && <p class="review__secure"><i class="ti ti-lock" aria-hidden="true"></i> Secure payment handled by Teya</p>}
		</form>
	</BookingShell>
</SiteLayout>

<style>
	@layer pages {
		:global(.review__alert) {
			margin-bottom: var(--space-3);
		}

		.review__card {
			margin-bottom: var(--space-3);
			padding: 1.25rem;
			border: 1px solid var(--color-border-card);
			border-radius: var(--radius-lg);
		}

		.review__head {
			display: flex;
			align-items: center;
			justify-content: space-between;
			margin-bottom: var(--space-3);
		}

		.review__head h2 {
			display: flex;
			align-items: center;
			gap: var(--space-2);
			margin: 0;
			font-size: var(--font-size-lg);
			font-weight: var(--font-weight-medium);
		}

		.review__head .ti {
			font-size: 16px;
			color: var(--color-accent);
		}

		.review__head .review__ok {
			color: var(--color-text-success);
		}

		.review__head a {
			display: inline-flex;
			align-items: center;
			min-height: 24px;
			font-size: var(--font-size-sm);
			color: var(--color-text-info);
		}

		.review__trip {
			display: flex;
			align-items: center;
			gap: var(--space-3);
			margin-bottom: var(--space-3);
		}

		.review__thumb {
			flex-shrink: 0;
			width: 64px;
			height: 64px;
			border-radius: var(--radius-md);
			object-fit: cover;
		}

		.review__thumb--empty {
			display: flex;
			align-items: center;
			justify-content: center;
			background: var(--color-background-secondary);
			color: var(--color-border-secondary);
			font-size: 24px;
		}

		.review__tour {
			margin: 0 0 4px;
			font-weight: var(--font-weight-medium);
		}

		.review__rows {
			margin: 0;
		}

		.review__rows div {
			display: flex;
			justify-content: space-between;
			gap: var(--space-4);
			padding: 5px 0;
			font-size: var(--font-size-base);
		}

		.review__rows dt {
			display: flex;
			align-items: center;
			gap: 6px;
			flex-shrink: 0;
			color: var(--color-text-secondary);
		}

		.review__rows dt .ti {
			font-size: 13px;
			color: var(--color-text-tertiary);
		}

		.review__rows dd {
			margin: 0;
			font-weight: var(--font-weight-medium);
			text-align: right;
			overflow-wrap: anywhere;
		}

		.review__quote {
			display: flex;
			gap: var(--space-2);
			margin: var(--space-2) 0 0;
			padding: var(--space-2) var(--space-3);
			border-radius: var(--radius-md);
			background: var(--color-background-secondary);
			font-size: var(--font-size-sm);
			font-style: italic;
			white-space: pre-line;
			overflow-wrap: anywhere;
		}

		.review__quote .ti {
			flex-shrink: 0;
			margin-top: 2px;
			font-style: normal;
			color: var(--color-text-tertiary);
		}

		.review__fee--end {
			text-align: right;
		}

		.review__secure {
			display: flex;
			align-items: center;
			justify-content: center;
			gap: 6px;
			margin: var(--space-2) 0 0;
			font-size: var(--font-size-sm);
			color: var(--color-text-secondary);
		}

		.review__line {
			margin: 0;
		}

		.review__total {
			display: flex;
			justify-content: space-between;
			margin: var(--space-3) 0 0;
			padding-top: var(--space-3);
			border-top: 0.5px solid var(--color-border-tertiary);
			font-size: var(--font-size-xl);
			font-weight: var(--font-weight-medium);
		}

		.review__fee {
			margin: 6px 0 0;
			font-size: var(--font-size-xs);
			color: var(--color-text-secondary);
		}

		.review__policy a {
			color: var(--color-text-info);
		}

		.review__policy {
			margin: 0;
			padding: var(--space-3);
			border-radius: var(--radius-md);
			background: var(--color-background-secondary);
			font-size: var(--font-size-body-sm);
			line-height: var(--line-height-body-sm);
			color: var(--color-text-secondary);
		}

		.review__form {
			margin-top: var(--space-4);
		}

		.review__legal {
			margin: 0 0 var(--space-3);
			font-size: var(--font-size-sm);
			line-height: var(--line-height-normal);
			color: var(--color-text-secondary);
		}

		.review__legal a {
			color: var(--color-text-info);
		}
	}
</style>
