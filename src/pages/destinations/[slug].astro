---
export const prerender = true;

/**
 * Destination detail (spec §6.5, board 10): gallery, intro, highlights,
 * location, insider tips and the tours that visit; the "at a glance" aside
 * follows the main column on phones (D-24). No "best time" chart, "also
 * nearby" or weather (D-11, D-13).
 */
import { pageTitle } from '../../config/site';
import SiteLayout from '../../layouts/SiteLayout.astro';
import ImageGallery, { type GalleryTag } from '../../components/vue/ImageGallery.vue';
import TourCard from '../../components/vue/TourCard.vue';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import InfoTile from '../../components/ui/InfoTile.astro';
import InfoTileGrid from '../../components/ui/InfoTileGrid.astro';
import MapLink from '../../components/ui/MapLink.astro';
import MobileActionBar from '../../components/ui/MobileActionBar.astro';
import DestinationHighlights from '../../components/destination/DestinationHighlights.astro';
import DestinationGlance from '../../components/destination/DestinationGlance.astro';
import {
	bestSeasonLabel,
	getAllDestinations,
	getDestinationGallery,
	getDestinationPhoto,
	getDestinationsForTour,
	getToursForDestination,
} from '../../lib/destinations';
import { getTourCardPhoto } from '../../lib/tours';
import { toTourCardDTO } from '../../lib/cards';
import { breadcrumbJsonLd, destinationJsonLd, socialImageFor } from '../../lib/seo';
import { GALLERY_CARD_SIZE, GALLERY_PHOTO_SIZE, toCardPhoto, toGalleryView } from '../../data/tour-photos';
import { MAP_IMAGES } from '../../data/map-images';

export function getStaticPaths() {
	return getAllDestinations().map((destination) => ({ params: { slug: destination.slug }, props: { destination } }));
}

const TAG_ICONS: Record<string, string> = {
	Swimming: 'swimming',
	Island: 'beach',
	Cave: 'droplet',
	Culture: 'building-castle',
	'Half-day': 'clock',
	Snorkelling: 'mask',
	'Must-see': 'star',
	'Hidden bays': 'beach',
};

const { destination } = Astro.props;
const tours = getToursForDestination(destination.slug);
const tourCards = await Promise.all(
	tours.map(async (tour) =>
		toTourCardDTO(tour, getDestinationsForTour(tour.slug).map((d) => d.slug), await toCardPhoto(getTourCardPhoto(tour), GALLERY_CARD_SIZE)),
	),
);

const shortName = destination.name.split('(')[0].trim();

// The gallery opens on the first real photo. Places without one (Trogir,
// Korčula, Dubrovnik, Brač) get the icon placeholder, labelled as what it is:
// the registry's alt describes a photo that doesn't exist yet.
const destinationPhoto = getDestinationPhoto(destination);
const galleryRefs = getDestinationGallery(destination);
const galleryPhotos = await Promise.all(
	(galleryRefs.some((photo) => photo.src) ? galleryRefs : [{ ...destinationPhoto, alt: `No photo of ${shortName} yet` }]).map((photo) =>
		toGalleryView(photo, 'sailboat', GALLERY_PHOTO_SIZE),
	),
);
const galleryTags: GalleryTag[] = [
	...destination.tags.map((tag): GalleryTag => ({ icon: TAG_ICONS[tag] ?? 'star', label: tag, tone: 'brand' })),
	...(destination.tipTag ? [{ icon: destination.tipTag.icon, label: destination.tipTag.label, tone: 'tip' as const }] : []),
];

const distance = destination.geo.find((g) => /^distance/i.test(g.label));
const travel = destination.geo.find((g) => /travel time/i.test(g.label));
const mapLabel = distance ? `View on map: ${distance.value.replace(/^~/, 'about ')} from Split` : `View ${shortName} on the map`;
const toursHeading = `Tours that visit ${shortName} (${tours.length})`;

const shareImage = await socialImageFor(destinationPhoto);
const siteUrl = Astro.site ? String(Astro.site).replace(/\/$/, '') : '';
const jsonLd = siteUrl
	? [
			destinationJsonLd(destination, siteUrl),
			breadcrumbJsonLd([
				{ name: 'Home', url: `${siteUrl}/` },
				{ name: 'Destinations', url: `${siteUrl}/destinations/` },
				{ name: destination.name, url: `${siteUrl}/destinations/${destination.slug}/` },
			]),
		]
	: undefined;
const titleSegment = `${destination.name} boat trips from Split`;
---

<SiteLayout
	title={pageTitle(titleSegment)}
	description={destination.shortDescription}
	ogImage={shareImage.src}
	ogImageAlt={shareImage.alt}
	jsonLd={jsonLd}
>
	<main id="main" class="dest">
		<Breadcrumb items={[{ label: 'Destinations', href: '/destinations/' }, { label: destination.name }]} />
		<ImageGallery client:visible photos={galleryPhotos} tags={galleryTags} />

		<div class="dest__layout">
			<div class="dest__main">
				<h1 class="dest__title">{destination.name}</h1>
				<p class="dest__intro">{destination.intro}</p>

				<section class="dest__section" aria-labelledby="highlights-heading">
					<SectionHeader variant="plain" title="Highlights" id="highlights-heading" />
					<DestinationHighlights items={destination.highlights} />
				</section>

				<section class="dest__section" aria-labelledby="location-heading">
					<SectionHeader variant="plain" title="Location & getting there" id="location-heading" />
					<MapLink href={destination.mapUrl} caption={mapLabel} map={MAP_IMAGES[destination.slug]} height={100} />
					<InfoTileGrid>
						{destination.geo.map((fact) => <InfoTile label={fact.label}>{fact.value}</InfoTile>)}
					</InfoTileGrid>
				</section>

				<section class="dest__section" aria-labelledby="tips-heading">
					<SectionHeader variant="plain" title="Insider tips" id="tips-heading" />
					<ol class="dest__tips" role="list">
						{
							destination.insiderTips.map((tip, index) => (
								<li>
									<span class="dest__tip-num" aria-hidden="true">
										{index + 1}
									</span>
									{tip}
								</li>
							))
						}
					</ol>
				</section>

				<section class="dest__section" id="tours" aria-labelledby="tours-heading">
					<SectionHeader variant="plain" title={toursHeading} id="tours-heading" />
					<ul class="dest__tours" role="list">
						{
							tourCards.map((tour) => (
								<li>
									<TourCard tour={tour} />
								</li>
							))
						}
					</ul>
				</section>
			</div>

			<DestinationGlance
				name={destination.name}
				slug={destination.slug}
				tourCount={tours.length}
				bestSeason={bestSeasonLabel(destination.bestTimeMonths)}
				fromSplit={travel ? { label: 'From Split', value: travel.value } : undefined}
			/>
		</div>

		<MobileActionBar target="tours" label="See tours">
			<p><strong>{tours.length} {tours.length === 1 ? 'tour' : 'tours'}</strong> visit {shortName}</p>
		</MobileActionBar>
	</main>
</SiteLayout>

<style>
	@layer pages {
		/* width: 100%: <main> is a flex item of the page shell, and auto margins
		   would shrink it to its content until the gallery lays out (CLS). */
		.dest {
			width: 100%;
			max-width: var(--content-max);
			margin: 0 auto;
			padding: var(--space-6) var(--page-gutter) 0;
		}

		.dest__layout {
			display: grid;
			grid-template-columns: minmax(0, 1fr) var(--aside-width);
			column-gap: var(--space-7);
			align-items: start;
			margin-bottom: var(--detail-gap);
		}

		.dest__title {
			margin: 0 0 var(--space-3);
			font-size: var(--font-size-hero);
			font-weight: var(--font-weight-medium);
			line-height: var(--line-height-tight);
		}

		.dest__intro {
			margin: 0 0 var(--detail-gap);
			font-size: var(--font-size-body-md);
			line-height: var(--line-height-body-md);
			color: var(--color-text-secondary);
		}

		.dest__section {
			margin-bottom: var(--detail-gap);
		}

		.dest__section:last-child {
			margin-bottom: 0;
		}

		.dest__tips {
			display: grid;
			gap: var(--space-2);
			margin: 0;
			padding: 0;
			list-style: none;
		}

		.dest__tips li {
			display: flex;
			gap: 10px;
			padding: 10px var(--space-3);
			border-radius: var(--radius-md);
			background: var(--color-background-secondary);
			font-size: var(--font-size-body-sm);
			line-height: var(--line-height-body-sm);
			color: var(--color-text-secondary);
		}

		.dest__tip-num {
			flex-shrink: 0;
			font-weight: var(--font-weight-semibold);
			color: var(--color-accent);
		}

		#tours {
			scroll-margin-top: 72px;
		}

		.dest__tours {
			display: grid;
			grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
			gap: 14px;
			margin: 0;
			padding: 0;
			list-style: none;
		}

		.dest__tours > li {
			display: flex;
		}

		.dest__tours > li > :global(*) {
			flex: 1;
		}

		@media (max-width: 768px) {
			.dest__layout {
				grid-template-columns: minmax(0, 1fr);
				row-gap: var(--detail-gap);
			}
		}
	}
</style>
