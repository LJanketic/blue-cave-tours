---
export const prerender = true;

import { pageTitle } from '../../config/site';
import SiteLayout from '../../layouts/SiteLayout.astro';
import PhotoHero from '../../components/ui/PhotoHero.astro';
import Button from '../../components/ui/Button.astro';
import DestinationFilters from '../../components/vue/DestinationFilters.vue';
import DestinationsCatalog from '../../components/vue/DestinationsCatalog.vue';
import { getAllDestinations, getDestinationPhoto, getToursForDestination } from '../../lib/destinations';
import { toDestinationCardDTO } from '../../lib/cards';
import { GALLERY_CARD_SIZE, toCardPhoto } from '../../data/tour-photos';
import { firstPhotoForDestination } from '../../data/destination-photos';

const cards = await Promise.all(
	getAllDestinations().map(async (d) =>
		toDestinationCardDTO(d, getToursForDestination(d.slug).length, await toCardPhoto(getDestinationPhoto(d), GALLERY_CARD_SIZE)),
	),
);

// The design's hero photo isn't cleared for use (C-17): the site's own aerial
// of the Pakleni islands, with contrast measured behind the text.
const heroPhoto = firstPhotoForDestination('pakleni', 3);
if (!heroPhoto?.src) throw new Error('Destinations hero photo missing');
---

<SiteLayout
	title={pageTitle('Islands and caves we visit from Split')}
	description="Islands, caves, and swim stops on our Split boat tours: Blue Cave, Vis, Hvar, Pakleni, Blue Lagoon, and more."
	solidNav={false}
	fontPreload
	footerGap="56px"
>
	<main id="main">
		<PhotoHero
			image={heroPhoto.src}
			imagePosition="center 60%"
			eyebrow="Islands · Caves · Old towns"
			title="Destinations"
			lead="From Split's Riva to the outer islands, here's where our boats take you."
		>
			<DestinationFilters client:idle />
		</PhotoHero>

		<div class="destinations">
			<DestinationsCatalog client:visible destinations={cards} />

			<aside class="destinations__also" aria-label="Browse tours instead">
				<div>
					<p class="destinations__also-title">Not sure where to go?</p>
					<p class="destinations__also-text">Browse all tours and filter by type or duration instead.</p>
				</div>
				<Button href="/tours/" variant="secondary" size="sm" iconEnd="arrow-right">Browse tours</Button>
			</aside>
		</div>
	</main>
</SiteLayout>

<style>
	@layer pages {
		.destinations {
			max-width: var(--content-max);
			margin: 0 auto;
			padding: 0 var(--page-gutter);
		}

		/* board 04 .also-strip */
		.destinations__also {
			display: flex;
			flex-wrap: wrap;
			align-items: center;
			justify-content: space-between;
			gap: var(--space-3);
			margin-top: var(--space-2);
			padding: 1rem 1.25rem;
			border-radius: var(--radius-lg);
			background: var(--color-background-secondary);
		}

		.destinations__also-title {
			margin: 0 0 2px;
			font-size: var(--font-size-base);
			font-weight: var(--font-weight-medium);
		}

		.destinations__also-text {
			margin: 0;
			font-size: var(--font-size-base);
			line-height: var(--line-height-relaxed);
			color: var(--color-text-secondary);
		}
	}
</style>
