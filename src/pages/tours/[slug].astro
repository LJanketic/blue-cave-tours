---
export const prerender = true;

import TourDetailView from '../../components/tour/TourDetailView.astro';
import { pageTitle } from '../../config/site';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getAllTours, getTourBySlug, getTourCardPhoto } from '../../lib/tours';
import { tourBreadcrumbs } from '../../lib/tour-display';
import { breadcrumbJsonLd, socialImageFor, tourJsonLd } from '../../lib/seo';

export function getStaticPaths() {
	return getAllTours().map((tour) => ({ params: { slug: tour.slug } }));
}

const { slug } = Astro.params;
const tour = slug ? getTourBySlug(slug) : undefined;

// getStaticPaths only lists real tours, so every built page has one.
if (!tour) throw new Error(`Unknown tour: ${slug}`);

const siteUrl = Astro.site ? String(Astro.site).replace(/\/$/, '') : '';
// Same trail as the visible breadcrumb in TourDetailView.astro, with Home first.
const jsonLd =
	siteUrl
		? [
				tourJsonLd(tour, siteUrl),
				breadcrumbJsonLd([
					{ name: 'Home', url: `${siteUrl}/` },
					...tourBreadcrumbs(tour).map((crumb) => ({ name: crumb.label, url: `${siteUrl}${crumb.href}` })),
				]),
			]
		: undefined;
const shareImage = await socialImageFor(getTourCardPhoto(tour));
---

<SiteLayout
	title={pageTitle(tour.title)}
	description={tour.shortDescription}
	jsonLd={jsonLd}
	ogImage={shareImage.src}
	ogImageAlt={shareImage.alt}
>
	<main id="main">
		<TourDetailView tour={tour} />
	</main>
</SiteLayout>
