---
export const prerender = true;

/**
 * Contact (spec §7.5, board 14). The form posts to /api/contact: as JSON from
 * the page script, or as a plain form without JavaScript (then the API
 * redirects to /contact/sent/ or /contact/problem/).
 */
import {
	MEETING_POINT_LABEL,
	MEETING_POINT_MAP_URL,
	OFFICE_HOURS,
	REPLY_TIME,
	pageTitle,
	SITE_EMAIL,
	SITE_NAME,
	SITE_PHONE,
	SITE_PHONE_DISPLAY,
} from '../../config/site';
import { seasonLabel } from '../../config/season';
import { CONTACT_TOPICS, HONEYPOT_FIELD } from '../../lib/contact-validation';
import SiteLayout from '../../layouts/SiteLayout.astro';
import FormField from '../../components/ui/FormField.astro';
import Button from '../../components/ui/Button.astro';
import MapLink from '../../components/ui/MapLink.astro';
import { MAP_IMAGES } from '../../data/map-images';
import { getAllTours } from '../../lib/tours';

// "Which tour?" follows the private route order of the 20 Oct handoff, with
// the custom day last. Tours not listed here (a new one) follow in catalog order.
const TOUR_ORDER = [
	'blue-cave-hvar-5-islands',
	'golden-horn-brac-hvar',
	'blue-lagoon-morning',
	'blue-lagoon-afternoon',
	'hvar-red-rocks-pakleni',
	'dubrovnik-one-way',
	'create-perfect-day-private',
];
const rank = (slug: string) => (TOUR_ORDER.includes(slug) ? TOUR_ORDER.indexOf(slug) : TOUR_ORDER.length);
const tours = [...getAllTours()].sort((a, b) => rank(a.slug) - rank(b.slug));
const whatsappUrl = `https://wa.me/${SITE_PHONE.replace(/\D/g, '')}`;
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '';

const CARDS = [
	{ type: 'Phone', icon: 'phone', tone: 'brand', value: SITE_PHONE_DISPLAY, sub: 'Call or text us', href: `tel:${SITE_PHONE}` },
	{ type: 'WhatsApp', icon: 'brand-whatsapp', tone: 'brand', value: SITE_PHONE_DISPLAY, sub: 'Message us on WhatsApp', href: whatsappUrl, external: true },
	{ type: 'Email', icon: 'mail', tone: 'info', value: SITE_EMAIL, sub: 'For bookings, invoices and detailed requests', href: `mailto:${SITE_EMAIL}` },
	{ type: 'Find us', icon: 'map-pin', tone: 'warm', value: MEETING_POINT_LABEL, sub: 'Where every tour starts', href: MEETING_POINT_MAP_URL, external: true },
];
---

<SiteLayout
	title={pageTitle('Contact us: Riva stand 14, Split')}
	description={`Reach ${SITE_NAME} on Split's Riva, stand 14, or send a message about tours and private charters.`}
	footerGap="32px"
>
	<main id="main" class="contact">
		<h1 class="contact__title">Contact us</h1>
		<p class="contact__lead">
			Questions, special requests, or not sure which tour is right for you? Get in touch: we reply {REPLY_TIME}.
		</p>

		<ul class="contact__cards" role="list">
			{
				CARDS.map((card) => (
					<li>
						<a class="contact__card" href={card.href} {...(card.external ? { target: '_blank', rel: 'noopener' } : {})}>
							<span class={`contact__icon contact__icon--${card.tone}`} aria-hidden="true">
								<i class={`ti ti-${card.icon}`} />
							</span>
							<span class="contact__type">{card.type}</span>
							<span class="contact__value">{card.value}</span>
							<span class="contact__sub">
								{card.sub}
								{card.external && <span class="sr-only"> (opens in a new tab)</span>}
							</span>
						</a>
					</li>
				))
			}
		</ul>

		<div class="contact__hours">
			<div>
				<h2 class="contact__hours-label">Response time</h2>
				{OFFICE_HOURS && <p class="contact__hours-line">{OFFICE_HOURS}</p>}
				<p class="contact__hours-line">We reply to messages {REPLY_TIME}.</p>
			</div>
			<div>
				<h2 class="contact__hours-label">Season</h2>
				<p class="contact__hours-line">Most tours run daily, {seasonLabel()}.</p>
			</div>
		</div>

		<section class="contact__form-card" aria-labelledby="form-heading">
			<h2 id="form-heading" class="contact__form-title">Send us a message</h2>
			<form id="contact-form" method="post" action="/api/contact">
				<input type="hidden" name="_startedAt" id="contact-started-at" value="" />
				<div class="contact__hp" aria-hidden="true">
					<label for={HONEYPOT_FIELD}>Company</label>
					<input id={HONEYPOT_FIELD} name={HONEYPOT_FIELD} type="text" tabindex="-1" autocomplete="off" />
				</div>
				<p class="contact__note">Fields marked <span aria-hidden="true">*</span><span class="sr-only">with an asterisk</span> are required.</p>
				<div class="contact__grid">
					<FormField label="First name" name="firstName" autocomplete="given-name" required maxlength={100} />
					<FormField label="Last name" name="lastName" autocomplete="family-name" required maxlength={100} />
					<FormField label="Email" name="email" type="email" autocomplete="email" required maxlength={254} />
					<FormField label="Phone (optional)" name="phone" type="tel" autocomplete="tel" maxlength={30} />
					<FormField
						class="contact__full"
						label="Subject"
						name="topic"
						as="select"
						options={CONTACT_TOPICS.map((t) => ({ value: t.id, label: t.label }))}
					/>
					<FormField
						class="contact__full contact__optional"
						id="tourSlug"
						label="Which tour?"
						name="tourSlug"
						as="select"
						options={[{ value: '', label: 'Not about a particular tour' }, ...tours.map((t) => ({ value: t.slug, label: t.title }))]}
						data-contact-tour
					/>
					<FormField
						class="contact__full contact__optional"
						label="Booking reference"
						name="bookingRef"
						hint="It's in your confirmation email, e.g. HBC-7K3QXM."
						maxlength={20}
						autocapitalize="characters"
						data-contact-ref
					/>
					<FormField class="contact__full" label="Message" name="message" as="textarea" required maxlength={5000} rows={5} />
				</div>
				{turnstileSiteKey && <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-theme="light" />}
				<p class="contact__privacy">
					We use your details only to answer your message. See our <a href="/legal/privacy/">Privacy policy</a>.
				</p>
				<Button type="submit" iconEnd="arrow-right" class="contact__submit">Send message</Button>
				<p id="contact-status" class="contact__status" role="status" aria-live="polite"></p>
			</form>
		</section>

		<MapLink href={MEETING_POINT_MAP_URL} caption={`${MEETING_POINT_LABEL} — open in Google Maps`} map={MAP_IMAGES.contact} />
		<p class="contact__meeting">
			<i class="ti ti-info-circle" aria-hidden="true"></i>
			<span>
				Meet at stand 14 on Split's Riva: look for the Hello Blue Cave sign near the boat berths. Be there at least 15
				minutes before departure; the waterfront gets busy in peak season.
			</span>
		</p>
	</main>
</SiteLayout>

<!-- Without JavaScript the tour and booking-reference fields always show. -->
<noscript><style>.contact__optional { display: flex !important; }</style></noscript>

{turnstileSiteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer />}

<script>
	import { initContactForm } from '../../client/contact-form';
	initContactForm();
</script>

<style>
	@layer pages {
		.contact {
			width: 100%;
			max-width: var(--content-max);
			margin: 0 auto;
			padding: calc(24px + 1.5rem) var(--page-gutter) 0;
		}

		.contact__title {
			margin: 0 0 var(--space-2);
			font-size: var(--font-size-hero);
			font-weight: var(--font-weight-medium);
			line-height: var(--line-height-tight);
		}

		.contact__lead {
			max-width: 560px;
			margin: 0 0 var(--space-6);
			font-size: var(--font-size-body-md);
			line-height: var(--line-height-body-md);
			color: var(--color-text-secondary);
		}

		.contact__cards {
			display: grid;
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: var(--space-3);
			margin: 0 0 var(--space-3);
			padding: 0;
			list-style: none;
		}

		/* board 14: grey, borderless tiles; every one is a real link */
		.contact__card {
			display: grid;
			grid-template-columns: auto 1fr;
			grid-template-rows: auto auto auto;
			column-gap: 14px;
			height: 100%;
			padding: var(--space-4) 18px;
			border-radius: var(--radius-lg);
			background: var(--color-background-secondary);
			color: var(--color-text-primary);
			text-decoration: none;
			transition: background-color var(--duration-fast) ease;
		}

		.contact__card:hover {
			background: var(--color-background-hover);
		}

		.contact__icon {
			display: flex;
			grid-row: span 3;
			align-items: center;
			justify-content: center;
			width: 36px;
			height: 36px;
			border-radius: var(--radius-md);
			font-size: 18px;
		}

		.contact__icon--brand {
			background: var(--color-background-brand-soft);
			color: var(--color-text-brand);
		}

		.contact__icon--info {
			background: var(--color-background-brand-soft);
			color: var(--color-text-info);
		}

		.contact__icon--warm {
			background: var(--color-category-tip-bg);
			color: var(--color-category-tip-text);
		}

		.contact__type {
			font-size: var(--font-size-xs);
			text-transform: uppercase;
			letter-spacing: var(--letter-spacing-label);
			color: var(--color-text-tertiary);
		}

		.contact__value {
			font-size: var(--font-size-md);
			font-weight: var(--font-weight-medium);
			overflow-wrap: anywhere;
		}

		.contact__sub {
			font-size: var(--font-size-base);
			color: var(--color-text-secondary);
		}

		.contact__hours {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: var(--space-5);
			margin-bottom: var(--space-6);
			padding: var(--space-4) 18px;
			border-radius: var(--radius-lg);
			background: var(--color-background-secondary);
		}

		.contact__hours-label {
			margin: 0 0 6px;
			font-size: var(--font-size-xs);
			font-weight: var(--font-weight-medium);
			text-transform: uppercase;
			letter-spacing: var(--letter-spacing-label);
			color: var(--color-text-tertiary);
		}

		.contact__hours-line {
			margin: 0;
			font-size: var(--font-size-base);
			color: var(--color-text-secondary);
		}

		.contact__form-card {
			margin-bottom: var(--space-6);
			padding: 1.25rem;
			border: 1px solid var(--color-border-card);
			border-radius: var(--radius-lg);
		}

		.contact__form-title {
			margin: 0 0 var(--space-2);
			font-size: var(--font-size-lg);
			font-weight: var(--font-weight-medium);
		}

		.contact__note,
		.contact__privacy {
			margin: 0 0 var(--space-4);
			font-size: var(--font-size-sm);
			color: var(--color-text-secondary);
		}

		.contact__privacy {
			margin: var(--space-4) 0 0;
		}

		.contact__grid {
			display: grid;
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: var(--space-4);
		}

		.contact :global(.contact__full) {
			grid-column: 1 / -1;
		}

		/* Shown by the script for the subjects that need them. */
		.contact :global(.contact__optional) {
			display: none;
		}

		.contact :global(.contact__optional.is-shown) {
			display: flex;
		}

		.contact__hp {
			position: absolute;
			left: -10000px;
			width: 1px;
			height: 1px;
			overflow: hidden;
		}

		.contact :global(.contact__submit) {
			margin-top: var(--space-4);
			padding: 11px 22px;
		}

		.contact__status {
			margin: var(--space-3) 0 0;
			font-size: var(--font-size-sm);
			color: var(--color-text-secondary);
		}

		.contact__status:empty {
			display: none;
		}

		.contact__meeting {
			display: flex;
			gap: var(--space-2);
			margin: 0;
			font-size: var(--font-size-body-sm);
			line-height: var(--line-height-body-sm);
			color: var(--color-text-secondary);
		}

		.contact__meeting .ti {
			flex-shrink: 0;
			margin-top: 2px;
			color: var(--color-text-tertiary);
		}

		@media (max-width: 768px) {
			.contact__cards,
			.contact__hours,
			.contact__grid {
				grid-template-columns: 1fr;
			}
		}
	}
</style>
