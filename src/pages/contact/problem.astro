---
export const prerender = true;

/**
 * Where the contact form lands without JavaScript when the message wasn't
 * sent (§3.5). Static: the reason is in ?error=, which only the browser's
 * Back button needs: the browser keeps what was typed there.
 */
import { pageTitle, SITE_EMAIL, SITE_PHONE, SITE_PHONE_DISPLAY } from '../../config/site';
import SiteLayout from '../../layouts/SiteLayout.astro';
import Button from '../../components/ui/Button.astro';
---

<SiteLayout title={pageTitle('Message not sent')} robots="noindex" footerGap="32px">
	<main id="main" class="contact-result">
		<span class="contact-result__icon" aria-hidden="true"><i class="ti ti-alert-circle"></i></span>
		<h1>Your message wasn't sent</h1>
		<p>Go back to the form: what you typed is still there. Please check that:</p>
		<ul>
			<li>your first and last name, email and message are filled in</li>
			<li>the email address is complete, like name@domain.com</li>
			<li>the message is at least 10 characters</li>
			<li>a booking reference, if you gave one, looks like HBC-7K3QXM</li>
		</ul>
		<p>
			If it still doesn't work, email <a href={`mailto:${SITE_EMAIL}`}>{SITE_EMAIL}</a> or call
			<a href={`tel:${SITE_PHONE}`}>{SITE_PHONE_DISPLAY}</a>.
		</p>
		<div class="contact-result__actions">
			<Button href="/contact/">Back to the form</Button>
		</div>
	</main>
</SiteLayout>

<style>
	@layer pages {
		.contact-result {
			width: 100%;
			max-width: 560px;
			margin: 0 auto;
			padding: calc(24px + 3rem) var(--page-gutter) var(--space-8);
		}

		.contact-result__icon {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			width: 56px;
			height: 56px;
			margin-bottom: var(--space-4);
			border-radius: 50%;
			background: var(--color-background-danger);
			color: var(--color-text-danger);
			font-size: 28px;
		}

		h1 {
			margin: 0 0 var(--space-3);
			font-size: var(--font-size-hero);
			font-weight: var(--font-weight-medium);
			line-height: var(--line-height-tight);
		}

		p,
		ul {
			margin: 0 0 var(--space-4);
			color: var(--color-text-secondary);
			line-height: var(--line-height-relaxed);
		}

		.contact-result__actions {
			margin-top: var(--space-6);
		}
	}
</style>
