---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import { formatEuro } from '../../../lib/price';
import { formatBookingDate, guestSummaryFromCounts, seatCount } from '../../../lib/booking';
import { departureHasLeft, formatTimestamp } from '../../../lib/bookings/dates';
import { isRecordId } from '../../../lib/bookings/ids';
import { applyAdminAction, bookingSettled, canConfirmOffline, quoteExpired, STATUS_LABELS, waitingForConfirmation, type AdminAction } from '../../../lib/bookings/service';
import { durationLabel } from '../../../config/charter';
import { byCreatedDesc, isCharterQuote, outbox, bookings, type BookingStatus, type OutboxEmail, type PaymentStatus } from '../../../lib/bookings/store';
import { overbookingsById, whatsappNumber } from '../../../lib/admin/manifest';
import { demoPaymentHoldsNoSeats, paidThroughOutdatedDeploy } from '../../../lib/bookings/capacity';
import { DELIVERY_LABELS } from '../../../lib/email/send';
import TourThumb from '../../../components/admin/TourThumb.astro';

const id = Astro.params.id;
if (!isRecordId(id)) return Astro.redirect('/admin/bookings/', 303);

const STAFF = 'Admin';
const PAYMENT_LABELS: Record<PaymentStatus, string> = {
	unpaid: 'Not paid',
	paid: 'Paid',
	failed: 'Payment declined',
	refunded: 'Refunded',
	offline: 'Pay offline',
};
const FLASH: Record<string, string> = {
	status: 'Status updated.',
	refund: 'Marked as refunded.',
	note: 'Note added.',
	resend: 'Confirmation email created again. Check Emails to see whether it was sent.',
	'resend-skipped': 'Not sent again: a confirmation went out less than a minute ago.',
	confirm_offline: 'Confirmed. The guest was sent the booking confirmation, saying our team will contact them about payment. Check Emails to see whether it was sent.',
	'confirm_offline-skipped': 'Not confirmed: the booking is no longer waiting for payment, or its departure has left.',
};

if (Astro.request.method === 'POST') {
	const form = await Astro.request.formData();
	const type = String(form.get('action') ?? '');
	let action: AdminAction | null = null;
	if (type === 'status') {
		const status = String(form.get('status') ?? '') as BookingStatus;
		if (Object.hasOwn(STATUS_LABELS, status)) action = { type: 'status', status };
	} else if (type === 'refund') {
		action = { type };
	} else if (type === 'resend' || type === 'confirm_offline') {
		action = { type, siteOrigin: Astro.url.origin };
	} else if (type === 'note') {
		action = { type: 'note', text: String(form.get('text') ?? '') };
	}
	const result = action ? await applyAdminAction(id, action, STAFF) : null;
	// A resend that the double-click guard ignored, or a confirmation that came too late, says so instead of claiming it was done.
	const done = (type === 'resend' || type === 'confirm_offline') && !result?.written ? `${type}-skipped` : type;
	return Astro.redirect(`/admin/bookings/${id}/?done=${encodeURIComponent(done)}`, 303);
}

const booking = await bookings().get(id);
if (!booking) return Astro.redirect('/admin/bookings/', 303);

const flash = FLASH[Astro.url.searchParams.get('done') ?? ''] ?? '';
const overbooking = overbookingsById((await bookings().list()).filter((b) => b.date === booking.date)).get(booking.id);
// Paid through an outdated deploy (capacity.ts GATE_CUTOVER): its seats aren't held, staff check the payment.
const outdatedDeploy = booking.status !== 'cancelled' && paidThroughOutdatedDeploy(booking);
// Only this booking's emails, by id: never a scan of the whole outbox.
const emails = (await Promise.all((booking.emailIds ?? []).map((emailId) => outbox().get(emailId))))
	.filter((email): email is OutboxEmail => email !== null)
	.sort(byCreatedDesc);
const wa = whatsappNumber(booking.phone);
const paid = booking.paymentStatus === 'paid';
// Paid online, or confirmed by staff with the payment arranged offline: the booking stands.
const settled = bookingSettled(booking);
const offline = booking.paymentStatus === 'offline';
const tripStarted = departureHasLeft(booking.date, booking.slot);

// Same allowed moves as before (the server re-checks them); ordered so the likeliest next step comes first.
const STATUS_ACTIONS: { status: BookingStatus; label: string; icon: string }[] = [
	{ status: 'completed', label: 'Mark completed', icon: 'ti-circle-check' },
	{ status: 'no_show', label: 'Mark no-show', icon: 'ti-user-check' },
	{ status: 'confirmed', label: 'Set back to confirmed', icon: 'ti-refresh' },
];
const statusActions = STATUS_ACTIONS.filter((a) => settled && a.status !== booking.status);
// Completed/no-show only make sense once the trip day has come.
const visibleStatusActions = statusActions.filter((a) => a.status === 'confirmed' || tripStarted);
// The trip has happened and nobody has said how it went: ask that first, in plain view.
const askOutcome = settled && booking.status === 'confirmed' && tripStarted;
const outcomeActions = askOutcome ? visibleStatusActions.filter((a) => a.status !== 'confirmed') : [];
const otherStatusActions = visibleStatusActions.filter((a) => !outcomeActions.includes(a));
const awaitingPayment = booking.status === 'pending_payment' && !paid;
// The guest couldn't pay online (payment not open to them): staff confirm it here, the guest pays offline.
const canOffline = canConfirmOffline(booking);
const waiting = waitingForConfirmation(booking);
const isPrivate = booking.kind === 'private';
// A charter quote staff sent, vs a private experience the customer booked on the site.
const isQuote = isPrivate && isCharterQuote(booking);
const expired = isQuote && awaitingPayment && quoteExpired(booking);
// While a quote can be paid, its link is shown so staff can send it again (e.g. by WhatsApp) without a new quote.
const payLink = isQuote && awaitingPayment && !expired ? `${Astro.url.origin}/booking/pay/?id=${booking.id}` : '';
// A private experience booked on the site: its boat, extras and pick-up, as charged.
const charges = isPrivate && !isQuote ? (booking.lineItems ?? []) : [];
const canCancel = booking.status !== 'cancelled';
const hasManage = otherStatusActions.length > 0 || settled || canCancel;
---

<AdminLayout
	title={`${booking.ref} ${booking.firstName} ${booking.lastName}`}
	heading={`${booking.firstName} ${booking.lastName}`}
	section="bookings"
	back={{ href: '/admin/bookings/', label: 'Bookings' }}
	wide
>
	<p class="admin-lede ref">
		<span class="a-tnum">{booking.ref}</span>
		{booking.sample && <span class="a-badge a-badge--demo">Demo data</span>}
		{demoPaymentHoldsNoSeats(booking) && <span class="a-badge a-badge--demo">Demo payment — holds no seats</span>}
	</p>

	{
		flash && (
			<div class="highlight-box" role="status">
				<i class="ti ti-circle-check" aria-hidden="true" />
				<p>{flash}</p>
			</div>
		)
	}

	{
		waiting && (
			<div class="warn-box" role="note" id="waiting-confirmation">
				<i class="ti ti-alert-circle" aria-hidden="true" />
				<p>
					<strong>Waiting for confirmation.</strong> The guest couldn't pay online (online payment isn't open yet) and was told we'd
					confirm by email. Contact them, then use “Confirm, pay offline” below, or cancel the booking.
				</p>
			</div>
		)
	}

	{
		offline && booking.status !== 'cancelled' && (
			<div class="highlight-box" role="note" id="confirmed-offline">
				<i class="ti ti-info-circle" aria-hidden="true" />
				<p>
					<strong>Confirmed without online payment.</strong> Nothing was charged and no invoice was issued. Payment is arranged with the
					guest offline.
				</p>
			</div>
		)
	}

	{
		awaitingPayment && !isQuote && !waiting && (
			<div class="warn-box" role="note">
				<i class="ti ti-alert-circle" aria-hidden="true" />
				<p>
					<strong>Not paid yet.</strong> The {isPrivate ? "boat isn't" : "seats aren't"} held until the customer pays. Contact them to finish the booking, or
					cancel it.
				</p>
			</div>
		)
	}

	{
		awaitingPayment && isQuote && !waiting && (
			<div class="warn-box" role="note">
				<i class="ti ti-alert-circle" aria-hidden="true" />
				<p>
					{expired ? (
						<>
							<strong>Quote expired, not paid.</strong> The customer can't pay this link any more.
						</>
					) : (
						<>
							<strong>Quote sent, not paid yet.</strong> Valid until {booking.quoteExpiresAt ? formatTimestamp(booking.quoteExpiresAt) : 'not set'}. The boat
							isn't held until the customer pays.
						</>
					)}
				</p>
			</div>
		)
	}

	{
		overbooking?.boats && (
			<div class="a-danger-box" role="note">
				<i class="ti ti-alert-triangle" aria-hidden="true" />
				<p>
					<strong>No private boat is left for this booking.</strong> {overbooking.boats.takenBefore} of {overbooking.boats.perDay} private{' '}
					{overbooking.boats.perDay === 1 ? 'boat' : 'boats'} that day {overbooking.boats.takenBefore === 1 ? 'was' : 'were'} already taken when it{' '}
					{offline ? 'was confirmed' : booking.seatsSince ? 'was put back' : 'was paid'}. Move it to another day or contact the guest.{' '}
					<a href={`/admin/?from=${booking.date}#day`}>See the day</a>
				</p>
			</div>
		)
	}
	{
		demoPaymentHoldsNoSeats(booking) && (
			<div class="highlight-box" role="note">
				<i class="ti ti-info-circle" aria-hidden="true" />
				<p>
					<strong>Demo payment — holds no seats.</strong> It was paid through the demo checkout ({booking.paymentRef}), which only staff can
					open on the live site. No money was taken and its {booking.kind === 'private' ? 'boat is' : 'seats are'} still for sale, though it
					shows on the passenger list.
				</p>
			</div>
		)
	}
	{
		outdatedDeploy && (
			<div class="a-danger-box" role="note">
				<i class="ti ti-alert-triangle" aria-hidden="true" />
				<p>
					<strong>Paid through an outdated deploy — check the payment before the trip.</strong> This payment came through an old version of the site, not
					the current checkout, so its {booking.kind === 'private' ? 'boat is' : 'seats are'} not held and the departure may be sold again. Check the
					payment ({booking.paymentRef ?? 'no reference'}) with the provider, then contact the guest or cancel the booking.
				</p>
			</div>
		)
	}
	{
		overbooking && !overbooking.boats && (
			<div class="a-danger-box" role="note">
				<i class="ti ti-alert-triangle" aria-hidden="true" />
				<p>
					<strong>This booking overbooked the boat by {overbooking.seatsOver}.</strong> {overbooking.seatsBefore} of{' '}
					{overbooking.capacity} seats were taken when it {offline ? 'was confirmed' : booking.seatsSince ? 'was put back' : 'was paid'}; its{' '}
					{seatCount(booking)} guests made it {overbooking.seatsAfter}. Move it to another departure or
					contact the guest. <a href={`/admin/?from=${booking.date}#day`}>See the departure</a>
				</p>
			</div>
		)
	}

	{
		askOutcome && (
			<section class="a-tile outcome" aria-labelledby="outcome-title">
				<h2 class="a-card-title" id="outcome-title">How did the trip go?</h2>
				<div class="a-btnrow">
					{outcomeActions.map((a) => (
						<form method="post">
							<input type="hidden" name="action" value="status" />
							<input type="hidden" name="status" value={a.status} />
							<button class={a.status === 'completed' ? 'btn-primary' : 'btn-secondary'} type="submit">
								<i class={`ti ${a.icon}`} aria-hidden="true" /> {a.status === 'completed' ? 'Completed' : 'No-show'}
							</button>
						</form>
					))}
				</div>
			</section>
		)
	}

	{/* Desktop: what was booked on the left, what staff do with it on the right. */}
	<div class="detail">
		<div class="detail-main">
			<section class="a-card" aria-labelledby="tour-title">
				<h2 class="a-card-title" id="tour-title">Tour details</h2>
				<div class="tour-row">
					<TourThumb slug={booking.tourSlug} size={64} />
					<div class="tour-body">
						<p class="tour-name">{booking.tourTitle}</p>
						<div class="badge-row">
							<span class={`a-badge a-badge--${booking.status}`}>{STATUS_LABELS[booking.status]}</span>
							<span class={`a-badge a-badge--${booking.paymentStatus}`}>{PAYMENT_LABELS[booking.paymentStatus]}</span>
							{isPrivate && <span class="a-badge a-badge--private">{isQuote ? 'Private charter' : 'Private experience'}</span>}
						</div>
					</div>
				</div>
				<dl class="a-rows">
					<div><dt><i class="ti ti-calendar" aria-hidden="true"></i>Date</dt><dd>{formatBookingDate(booking.date)}</dd></div>
					<div><dt><i class="ti ti-clock" aria-hidden="true"></i>Departure</dt><dd class="a-tnum">{booking.slot || 'To be confirmed'}</dd></div>
					{isPrivate && booking.durationHours && <div><dt><i class="ti ti-hourglass" aria-hidden="true"></i>Duration</dt><dd>{durationLabel(booking.durationHours)}</dd></div>}
					{isPrivate && booking.enquiryId && <div><dt><i class="ti ti-message" aria-hidden="true"></i>Request</dt><dd><a href={`/admin/enquiries/?show=all#enquiry-${booking.enquiryId}`}>Open the customer's request</a></dd></div>}
					{payLink && <div><dt><i class="ti ti-credit-card" aria-hidden="true"></i>Pay link</dt><dd class="pay-link"><a href={payLink} target="_blank" rel="noopener">{payLink}</a><span class="fees-note">Send it again if the customer lost the email.</span></dd></div>}
					<div><dt><i class="ti ti-users" aria-hidden="true"></i>Guests</dt><dd>{guestSummaryFromCounts(booking.adults, booking.children, booking.infants)}</dd></div>
					{booking.pickup && <div><dt><i class="ti ti-map-pin" aria-hidden="true"></i>Pick-up</dt><dd>{booking.pickup}</dd></div>}
				</dl>
				{
					booking.personalDataRemovedAt && (
						<p class="a-muted">Personal data removed on {formatBookingDate(booking.personalDataRemovedAt.slice(0, 10))} (retention policy).</p>
					)
				}
				{
					booking.customerNotes && (
						<p class="hold-warn request">
							<i class="ti ti-info-circle" aria-hidden="true" />
							<span>
								<strong>Customer's request:</strong> {booking.customerNotes}
							</span>
						</p>
					)
				}
			</section>

			<section class="a-card" aria-labelledby="guest-title">
				<h2 class="a-card-title" id="guest-title">Guest details</h2>
				<dl class="a-rows">
					<div><dt>Name</dt><dd>{booking.firstName} {booking.lastName}</dd></div>
					<div><dt>Email</dt><dd><a href={`mailto:${encodeURIComponent(booking.email)}`}>{booking.email}</a></dd></div>
					<div><dt>Phone</dt><dd>{booking.phone ? <a href={`tel:${booking.phone.replace(/\s/g, '')}`}>{booking.phone}</a> : 'Not given'}</dd></div>
				</dl>
				<div class="a-btnrow contact">
					{booking.phone && <a class="btn-secondary" href={`tel:${booking.phone.replace(/\s/g, '')}`}><i class="ti ti-phone" aria-hidden="true"></i> Call</a>}
					{wa && <a class="btn-secondary" href={`https://wa.me/${wa}`} target="_blank" rel="noopener noreferrer"><i class="ti ti-brand-whatsapp" aria-hidden="true"></i> WhatsApp</a>}
					<a class="btn-secondary" href={`mailto:${encodeURIComponent(booking.email)}?subject=${encodeURIComponent(`Your booking ${booking.ref}`)}`}><i class="ti ti-mail" aria-hidden="true"></i> Email</a>
				</div>
			</section>

			<section class="a-card" aria-labelledby="pay-title">
				<h2 class="a-card-title" id="pay-title">Payment</h2>
				<dl class="a-rows">
					<div><dt>Status</dt><dd>{PAYMENT_LABELS[booking.paymentStatus]}</dd></div>
					{offline && <div><dt>Payment</dt><dd>Arranged with staff, not taken online</dd></div>}
					{booking.paymentProvider && <div><dt>Paid with</dt><dd>{booking.paymentProvider === 'paypal' ? 'PayPal' : 'Card (Teya)'}</dd></div>}
					{booking.paidAt && <div><dt>Paid at</dt><dd>{formatTimestamp(booking.paidAt)}</dd></div>}
					{booking.paymentRef && <div><dt>Payment ref</dt><dd class="mono">{booking.paymentRef}</dd></div>}
					{booking.invoice && <div><dt>Invoice (račun)</dt><dd>{booking.invoice.number}<span class="fees-note">Demo, not fiscalized</span></dd></div>}
				</dl>
				{
					charges.length > 0 && (
						<>
							<hr class="a-divider" />
							<dl class="a-rows">
								{charges.map((item) => (
									<div><dt>{item.label}</dt><dd class="a-tnum">{formatEuro(item.amount)}</dd></div>
								))}
							</dl>
						</>
					)
				}
				<hr class="a-divider" />
				<div class="total-row">
					<span class="total-label">Total</span>
					<span class="total-amount a-tnum">{formatEuro(booking.total)}</span>
				</div>
			</section>
		</div>

		<div class="detail-side">
			<section class="a-card" aria-labelledby="notes-title">
				<h2 class="a-card-title" id="notes-title">Staff notes</h2>
				{
					booking.staffNotes.length > 0 && (
						<ul class="note-list">
							{[...booking.staffNotes].reverse().map((note) => (
								<li>
									<p>{note.text}</p>
									<p class="note-meta">{note.by} · {formatTimestamp(note.at)}</p>
								</li>
							))}
						</ul>
					)
				}
				<form method="post" class="a-field note-form">
					<input type="hidden" name="action" value="note" />
					<label class="a-label" for="note-text">Add a note <span class="a-hint">(only staff see notes)</span></label>
					<textarea class="a-textarea" id="note-text" name="text" rows="2" maxlength="1000" placeholder="e.g. paid extra for snorkel gear" required></textarea>
					<button class="btn-secondary" type="submit"><i class="ti ti-edit" aria-hidden="true"></i> Save note</button>
				</form>
			</section>

			{
				emails.length > 0 && (
					<section class="a-card a-card--flush" aria-labelledby="emails-title">
						<h2 class="a-card-title pad" id="emails-title">Emails</h2>
						<ul class="emails">
							{emails.map((email) => (
								<li>
									<a class="a-item" href={`/admin/emails/${email.id}/`}>
										<span class="a-item-main">
											<span class="a-item-title">{email.subject}</span>
											<span class="a-item-sub">
												{email.to || 'No address'} · {formatTimestamp(email.createdAt)}
											</span>
										</span>
										<span class={`a-badge a-badge--${email.delivery}`}>{DELIVERY_LABELS[email.delivery]}</span>
									</a>
								</li>
							))}
						</ul>
					</section>
				)
			}

			<section class="a-card" aria-labelledby="history-title">
				<h2 class="a-card-title" id="history-title">History</h2>
				<ol class="timeline">
					{
						[...booking.history].reverse().map((entry) => (
							<li>
								<span>{entry.action}</span>
								<span class="note-meta">{entry.by} · {formatTimestamp(entry.at)}</span>
							</li>
						))
					}
				</ol>
			</section>

			{
				hasManage && (
					<section class="manage" aria-labelledby="manage-title">
						<p class="section-label" id="manage-title"><span>Change this booking</span></p>
						<div class="manage-actions">
							{canOffline && (
								<details class="a-confirm">
									<summary class="btn-secondary a-block">
										<i class="ti ti-circle-check" aria-hidden="true" /> Confirm, pay offline…
									</summary>
									<div class="warn-box">
										<p>
											<strong>Confirm without online payment?</strong> Nothing is charged and no invoice is issued. The booking takes its{' '}
											{isPrivate ? 'boat' : 'seats'} now, and shows as overbooked if the departure is already full. The guest gets the booking
											confirmation email, saying our team will contact them about payment. Agree the payment with them yourself.
										</p>
										<form method="post">
											<input type="hidden" name="action" value="confirm_offline" />
											<button class="btn-primary" type="submit">Yes, confirm booking</button>
										</form>
									</div>
								</details>
							)}
							{otherStatusActions.map((a) => (
								<form method="post">
									<input type="hidden" name="action" value="status" />
									<input type="hidden" name="status" value={a.status} />
									<button class="btn-secondary a-block" type="submit">
										<i class={`ti ${a.icon}`} aria-hidden="true" /> {a.label}
									</button>
								</form>
							))}
							{settled && (
								<form method="post">
									<input type="hidden" name="action" value="resend" />
									<button class="btn-secondary a-block" type="submit">
										<i class="ti ti-mail" aria-hidden="true" /> Resend confirmation email
									</button>
								</form>
							)}
							{paid && (
								<details class="a-confirm">
									<summary class="btn-secondary a-danger a-block">
										<i class="ti ti-cash" aria-hidden="true" /> Mark refunded…
									</summary>
									<div class="a-danger-box">
										<p>
											<strong>Mark {formatEuro(booking.total)} as refunded?</strong> This only records the refund. In this demo no money goes back to the customer.
										</p>
										<form method="post">
											<input type="hidden" name="action" value="refund" />
											<button class="btn-primary a-danger" type="submit">Yes, mark refunded</button>
										</form>
									</div>
								</details>
							)}
							{canCancel && (
								<details class="a-confirm">
									<summary class="btn-secondary a-danger a-block">
										<i class="ti ti-calendar-x" aria-hidden="true" /> Cancel booking…
									</summary>
									<div class="a-danger-box">
										<p>
											<strong>Cancel this booking?</strong> The customer is not emailed. Contact them yourself.
										</p>
										<form method="post">
											<input type="hidden" name="action" value="status" />
											<input type="hidden" name="status" value="cancelled" />
											<button class="btn-primary a-danger" type="submit">Yes, cancel booking</button>
										</form>
									</div>
								</details>
							)}
						</div>
					</section>
				)
			}
		</div>
	</div>
</AdminLayout>

<style>
	/* "Confirm, pay offline": the question and its button stacked, like the danger confirms. */
	.a-confirm .warn-box {
		display: grid;
		gap: 10px;
		margin: 0;
	}

	.a-confirm .warn-box p {
		margin: 0;
	}

	@media (min-width: 1024px) {
		.detail {
			display: grid;
			grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
			gap: 0 24px;
			align-items: start;
		}
	}

	.ref {
		display: flex;
		align-items: center;
		gap: 8px;
	}

	.outcome {
		border: 0.5px solid var(--a-border-tertiary);
	}

	.tour-row {
		display: flex;
		gap: 14px;
		align-items: center;
		margin-bottom: 14px;
	}

	.tour-body {
		min-width: 0;
	}

