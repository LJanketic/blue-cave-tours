---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import { clearAllData, demoDataAllowed, loadSampleData } from '../../lib/admin/sample-data';
import { rebuildLedgers } from '../../lib/bookings/capacity';
import { adminEmail, emailSender, emailSendingOn } from '../../lib/email/send';
import { DEMO_CHECKOUT_OPEN, PAYMENTS_ARE_DEMO } from '../../config/payments';
import { createDemoAccessToken, DEMO_ACCESS_COOKIE, DEMO_ACCESS_DAYS, demoAccessConfigured, demoAccessCookieOptions, demoAccessExpiry } from '../../lib/demo-access';
import { formatTimestamp } from '../../lib/bookings/dates';

// Every /admin page needs the admin login (src/middleware.ts), so only staff reach these actions.
if (Astro.request.method === 'POST') {
	let form: FormData;
	try {
		form = await Astro.request.formData();
	} catch {
		return Astro.redirect('/admin/tools/', 303);
	}
	const action = form.get('action');
	// Showcase only, like clear-all, and never on production: sample bookings must never mix with real ones.
	if (action === 'load-sample') {
		if (!demoDataAllowed()) return Astro.redirect('/admin/tools/?flash=demo-data-refused', 303);
		await loadSampleData();
		return Astro.redirect('/admin/?flash=loaded', 303);
	}
	// Recomputes the seat and boat ledgers from the bookings (capacity.ts): after a rollback or overlapping deploys.
	if (action === 'rebuild-capacity' && form.get('confirm') === 'yes') {
		try {
			const result = await rebuildLedgers();
			return Astro.redirect(`/admin/tools/?flash=rebuilt&departures=${result.ledgers}&removed=${result.removed}`, 303);
		} catch (err) {
			console.error('[admin] capacity rebuild failed', err);
			return Astro.redirect('/admin/tools/?flash=rebuild-failed', 303);
		}
	}
	// Lets this browser use the demo checkout where it isn't open to everyone (production).
	if (action === 'demo-checkout-on' && PAYMENTS_ARE_DEMO) {
		const token = createDemoAccessToken();
		if (!token) return Astro.redirect('/admin/tools/?flash=demo-no-secret', 303);
		Astro.cookies.set(DEMO_ACCESS_COOKIE, token, demoAccessCookieOptions());
		return Astro.redirect('/admin/tools/?flash=demo-on', 303);
	}
	if (action === 'demo-checkout-off') {
		Astro.cookies.delete(DEMO_ACCESS_COOKIE, { path: '/' });
		return Astro.redirect('/admin/tools/?flash=demo-off', 303);
	}
	// Showcase only: once payments are real, the bookings and the invoice counter are accounting records.
	// Never on production either: it would delete real guests' bookings (sample-data.ts).
	if (form.get('action') === 'clear-all' && form.get('confirm') === 'yes') {
		if (!demoDataAllowed()) return Astro.redirect('/admin/tools/?flash=demo-data-refused', 303);
		await clearAllData();
		return Astro.redirect('/admin/tools/?flash=cleared', 303);
	}
	return Astro.redirect('/admin/tools/', 303);
}

const FLASHES: Record<string, string> = {
	cleared: 'All bookings, enquiries and emails deleted.',
	'demo-on': 'Demo checkout is on in this browser.',
	'demo-off': 'Demo checkout is off in this browser.',
	'demo-no-secret': 'Demo checkout could not be switched on: DEMO_ACCESS_SECRET is not set in Netlify.',
	'demo-data-refused': 'Demo data can’t be loaded or deleted here: this is the live site, with real bookings.',
	'rebuild-failed': 'Capacity could not be rebuilt (storage error). Nothing was lost; try again.',
};
const params = Astro.url.searchParams;
const count = (name: string) => Math.max(0, Number.parseInt(params.get(name) ?? '', 10) || 0);
const flash =
	params.get('flash') === 'rebuilt'
		? `Capacity rebuilt from the bookings: ${count('departures')} ${count('departures') === 1 ? 'departure' : 'departures'} checked, ${count('removed')} ${count('removed') === 1 ? 'claim' : 'claims'} removed.`
		: (FLASHES[params.get('flash') ?? ''] ?? '');
const canUseDemoData = demoDataAllowed();
const demoAccessUntil = demoAccessExpiry(Astro.cookies.get(DEMO_ACCESS_COOKIE)?.value);
const canIssueDemoAccess = demoAccessConfigured();
const sendingOn = emailSendingOn();
const sender = emailSender();
---

<AdminLayout title="More" section="more">
	{
		flash && (
			<div class="highlight-box" role="status">
				<i class="ti ti-circle-check" aria-hidden="true" />
				<p>{flash}</p>
			</div>
		)
	}

	<p class="section-label"><span>Export</span></p>
	<ul class="a-list">
		<li>
			<a class="a-item" href="/admin/export.csv">
				<span class="next-icon" aria-hidden="true"><i class="ti ti-list"></i></span>
				<span class="a-item-main">
					<span class="a-item-title">Download all bookings</span>
					<span class="a-item-sub">CSV file, opens in Excel or Google Sheets</span>
				</span>
				<i class="ti ti-chevron-right a-chevron" aria-hidden="true"></i>
			</a>
		</li>
		<li>
			<a class="a-item" href="/">
				<span class="next-icon" aria-hidden="true"><i class="ti ti-map"></i></span>
				<span class="a-item-main">
					<span class="a-item-title">Open the website</span>
					<span class="a-item-sub">See what customers see</span>
				</span>
				<i class="ti ti-chevron-right a-chevron" aria-hidden="true"></i>
			</a>
		</li>
	</ul>

	<p class="section-label"><span>Setup</span></p>
	<section class="a-card" aria-label="Setup">
		<dl class="a-rows">
			<div><dt>Admin notifications go to</dt><dd>{adminEmail() || 'Not set (ADMIN_EMAIL)'}</dd></div>
			<div>
				<dt>Email sending</dt>
				<dd>{sendingOn ? <span class="a-badge a-badge--sent">On</span> : <span class="a-badge a-badge--outbox">Off</span>}</dd>
			</div>
			{
				sendingOn && (
					<div>
						<dt>Sent from</dt>
						<dd>
							{sender.address}
							{sender.isTestSender && <span class="sender-note">Resend's test sender: it only delivers to the email your Resend account uses.</span>}
						</dd>
					</div>
				)
			}
			<div><dt>Payments</dt><dd>{PAYMENTS_ARE_DEMO ? 'Demo, no money taken' : 'Live'}</dd></div>
		</dl>
	</section>

	{
		PAYMENTS_ARE_DEMO && (
			<>
				<p class="section-label"><span>Demo checkout</span></p>
				<section class="a-tile demo" aria-label="Demo checkout">
					{DEMO_CHECKOUT_OPEN ? (
						<p>On this deploy the demo checkout is open to everyone (DEMO_CHECKOUT=open). No money is taken.</p>
					) : (
						<p>
							Guests can't use the demo checkout: they see that online payment isn't open yet, and you get an admin
							notification to confirm their booking by email. Switch it on in this browser to show the whole booking flow, for{' '}
							{DEMO_ACCESS_DAYS} days. No money is taken.
						</p>
					)}
					<p class="demo-state" id="demo-checkout-state">
						{demoAccessUntil ? `On in this browser until ${formatTimestamp(new Date(demoAccessUntil).toISOString())}.` : 'Off in this browser.'}
					</p>
					{demoAccessUntil ? (
						<form method="post">
							<input type="hidden" name="action" value="demo-checkout-off" />
							<button class="btn-secondary a-block" type="submit"><i class="ti ti-lock" aria-hidden="true" /> Disable demo checkout in this browser</button>
						</form>
					) : canIssueDemoAccess ? (
						<form method="post">
							<input type="hidden" name="action" value="demo-checkout-on" />
							<button class="btn-primary a-block" type="submit"><i class="ti ti-credit-card" aria-hidden="true" /> Enable demo checkout in this browser</button>
						</form>
					) : (
						<p>To switch it on, set DEMO_ACCESS_SECRET in Netlify (openssl rand -base64 32) and redeploy.</p>
					)}
				</section>

				<p class="section-label"><span>Demo data</span></p>
				{canUseDemoData ? (
					<section class="a-tile demo" aria-label="Demo data">
						<p>Fills the admin with about three weeks of example bookings and enquiries, so you can show it to someone. Demo data sends no emails and holds no seats.</p>
						<form method="post">
							<input type="hidden" name="action" value="load-sample" />
							<button class="btn-primary a-block" type="submit"><i class="ti ti-database" aria-hidden="true" /> Load demo data</button>
						</form>
						<details class="a-confirm">
							<summary class="btn-secondary a-danger a-block">Delete everything…</summary>
							<div class="a-danger-box">
								<p><strong>Delete every booking, enquiry and email?</strong> This can't be undone.</p>
								<form method="post">
									<input type="hidden" name="action" value="clear-all" />
									<input type="hidden" name="confirm" value="yes" />
									<button class="btn-primary a-danger" type="submit">Yes, delete everything</button>
								</form>
							</div>
						</details>
					</section>
				) : (
					<section class="a-tile demo" aria-label="Demo data">
						<p>
							Loading and deleting demo data is off on the live site: guests book here for real, and demo bookings would sit among theirs. Use a deploy
							preview to show the admin with demo data.
						</p>
					</section>
				)}
			</>
		)
	}

	<p class="section-label"><span>Capacity</span></p>
	<section class="a-tile demo" aria-label="Capacity">
		<p>
			Seats and private boats left are counted from a ledger kept next to the bookings. If a departure shows the wrong number of seats left (after a
			rollback, for example), rebuild it from the bookings. Payments in progress are kept.
		</p>
		<details class="a-confirm">
			<summary class="btn-secondary a-block">Rebuild capacity from bookings…</summary>
			<div class="a-danger-box">
				<p><strong>Recount every departure's seats and boats from the paid bookings?</strong> Demo data and demo payments on the live site hold no seats.</p>
				<form method="post">
					<input type="hidden" name="action" value="rebuild-capacity" />
					<input type="hidden" name="confirm" value="yes" />
					<button class="btn-primary" type="submit">Yes, rebuild capacity</button>
				</form>
			</div>
		</details>
	</section>

	<p class="section-label"><span>Account</span></p>
	<form method="post" action="/admin/logout/">
		<button class="btn-secondary a-block" type="submit"><i class="ti ti-lock" aria-hidden="true"></i> Log out</button>
	</form>
</AdminLayout>

<style>
	.sender-note {
		display: block;
		margin-top: 4px;
		font-size: 12px;
		font-weight: 400;
		color: var(--a-text-secondary);
	}

	.demo {
		display: grid;
		gap: 10px;
	}

	.demo p {
		margin: 0 0 4px;
		font-size: 13px;
		color: var(--a-text-secondary);
	}

	.demo p.demo-state {
		font-weight: 500;
		color: var(--a-text-primary);
	}

	.a-confirm .btn-primary {
		justify-self: start;
	}

	.next-icon {
		background: var(--a-background-secondary);
	}
</style>
