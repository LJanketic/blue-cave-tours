---
export const prerender = true;

import { getImage, Picture } from 'astro:assets';
import { HOME_PAGE_TITLE, SITE_DEFAULT_DESCRIPTION } from '../config/site';
import SiteLayout from '../layouts/SiteLayout.astro';
import TourCard from '../components/TourCard.astro';
import HeroCarousel from '../components/vue/HeroCarousel.vue';
import type { HeroPanel } from '../components/vue/HeroCarousel.vue';
import FAQAccordion from '../components/vue/FAQAccordion.vue';
import { getFeaturedTours } from '../lib/tours';
import { getAllDestinations } from '../lib/destinations';
import { ABOUT } from '../data/about';
import { FAQ_ITEMS } from '../data/faq';
import { HERO_IMAGE } from '../data/hero-image';
import { CTA_BAND, HERO_SLIDES, HOW_IT_WORKS, TYPE_CARDS } from '../data/marketing';
import { faqPageJsonLd, organizationJsonLd, websiteJsonLd } from '../lib/seo';

const siteUrl = Astro.site ? String(Astro.site).replace(/\/$/, '') : '';
const jsonLd = siteUrl
	? [organizationJsonLd(siteUrl), websiteJsonLd(siteUrl), faqPageJsonLd(FAQ_ITEMS.slice(0, 4))]
	: faqPageJsonLd(FAQ_ITEMS.slice(0, 4));

const featuredTours = getFeaturedTours();
const allDestinations = getAllDestinations();
const homeDestinationOrder = ['blue-cave', 'hvar', 'zlatni-rat', 'pakleni', 'blue-lagoon', 'vis'];
const destinationStrip = homeDestinationOrder
	.map((slug) => allDestinations.find((d) => d.slug === slug))
	.filter((d): d is (typeof allDestinations)[number] => Boolean(d));
const faqPreview = FAQ_ITEMS.slice(0, 4);

const HERO_WIDTHS = [800, 1280, 1600, 1920] as const;

const heroSources = await Promise.all(
	HERO_WIDTHS.map((width) =>
		getImage({
			src: HERO_IMAGE.src,
			width,
			format: 'webp',
			quality: 70,
		}),
	),
);
const heroLcp = heroSources[2] ?? heroSources[0];
const heroSrcset = heroSources.map((img, i) => `${img.src} ${HERO_WIDTHS[i]}w`).join(', ');

const heroPanels: HeroPanel[] = HERO_SLIDES;
---

<SiteLayout title={HOME_PAGE_TITLE} description={SITE_DEFAULT_DESCRIPTION} solidNav={false} jsonLd={jsonLd}>
	<link
		slot="head"
		rel="preload"
		as="image"
		href={heroLcp.src}
		type="image/webp"
		imagesrcset={heroSrcset}
		imagesizes="100vw"
		fetchpriority="high"
	/>
	<main id="main">
		<div class="page home-page">
			<h1 class="sr-only">Hello Blue Cave: speedboat tours and private charters from Split</h1>
			<section class="hero hero--home">
				<div class="hero-media">
					<div class="hero-media-fallback" aria-hidden="true">
						<i class="ti ti-sailboat"></i>
					</div>
					<Picture
						src={HERO_IMAGE.src}
						alt={HERO_IMAGE.alt}
						formats={['webp']}
						fallbackFormat="webp"
						widths={[800, 1280, 1600, 1920]}
						sizes="100vw"
						quality={70}
						layout="none"
						priority
						class="hero-banner"
						pictureAttributes={{ class: 'hero-banner-picture' }}
					/>
					<div class="hero-banner-overlay" aria-hidden="true"></div>
				</div>
				<HeroCarousel client:load panels={heroPanels} />
			</section>

			<div class="page-shell">
				<section aria-labelledby="featured-heading">
					<div class="section-header">
						<h2 id="featured-heading" class="section-title">Popular tours</h2>
						<a class="section-link" href="/tours/">See all tours →</a>
					</div>
					<div class="cards-scroll">
						{
							featuredTours.map((tour) => (
								<TourCard tour={tour} featured={tour.featured} />
							))
						}
					</div>
				</section>

				<section aria-labelledby="destinations-heading">
					<div class="section-header">
						<h2 id="destinations-heading" class="section-title">Where we go</h2>
						<a class="section-link" href="/destinations/">All destinations →</a>
					</div>
					<div class="dest-grid">
						{
							destinationStrip.map((dest) => (
								<a class="dest-card" href={`/destinations/${dest.slug}/`}>
									<i class="ti ti-sailboat bg-icon" aria-hidden="true" />
									<h3 class="dest-name">{dest.name}</h3>
									<span class="dest-count">
										{dest.tourSlugs.length} tour{dest.tourSlugs.length === 1 ? '' : 's'}
									</span>
								</a>
							))
						}
					</div>
				</section>

				<section aria-labelledby="how-heading">
					<div class="section-header">
						<h2 id="how-heading" class="section-title">How it works</h2>
					</div>
					<div class="steps">
						{
							HOW_IT_WORKS.map((step, index) => (
								<div class="step-card">
									<div class="step-num">{index + 1}</div>
									<p class="step-title">{step.title}</p>
									<p class="step-desc">{step.description}</p>
								</div>
							))
						}
					</div>
				</section>

				<section aria-labelledby="types-heading">
					<div class="section-header">
						<h2 id="types-heading" class="section-title">Group or private?</h2>
					</div>
					<div class="types-grid">
						{
							TYPE_CARDS.map((card) => (
								<div class:list={['type-card', card.kind === 'private' && 'featured']}>
									<div class={`type-icon type-icon--${card.kind}`}>
										<i class={`ti ti-${card.icon}`} aria-hidden="true"></i>
									</div>
									<p class="type-title">{card.title}</p>
									<p class="type-desc">{card.description}</p>
									<div class="type-features">
										{card.features.map((feature) => (
											<span class="type-feat"><i class="ti ti-circle-check" aria-hidden="true"></i> {feature}</span>
										))}
									</div>
									{card.kind === 'private' ? (
										<a class="btn-primary btn-primary--compact" href={card.ctaHref}>{card.ctaLabel}</a>
									) : (
										<a class="type-cta" href={card.ctaHref}>{card.ctaLabel}</a>
									)}
								</div>
							))
						}
					</div>
				</section>

				<section class="trust-bar" aria-label="Why guests trust us">
					{
						ABOUT.trustStats.map((stat) => (
							<div class="trust-item">
								<i class={`ti ti-${stat.icon}`} aria-hidden="true" />
								<span class="trust-num">{stat.value}</span>
								<span class="trust-label">{stat.label}</span>
							</div>
						))
					}
				</section>

				<section aria-labelledby="faq-heading">
					<div class="section-header">
						<h2 id="faq-heading" class="section-title">Common questions</h2>
						<a class="section-link" href="/faq/">All FAQs →</a>
					</div>
					<FAQAccordion client:visible items={faqPreview} />
				</section>

				<section class="cta-band" aria-labelledby="cta-heading">
					<h2 id="cta-heading">{CTA_BAND.heading}</h2>
					<p>{CTA_BAND.text}</p>
					<div class="cta-band-btns">
						<a class="btn-primary" href={CTA_BAND.primary.href}>{CTA_BAND.primary.label}</a>
						<a class="btn-secondary" href={CTA_BAND.secondary.href}>{CTA_BAND.secondary.label}</a>
					</div>
				</section>
			</div>
		</div>
	</main>
</SiteLayout>

<style>
	.home-page .page-shell {
		padding: 3.5rem var(--page-gutter) 4rem;
	}

	.home-page .cta-band-btns .btn-primary,
	.home-page .cta-band-btns .btn-secondary {
		min-height: unset;
	}

	.dest-card {
		height: 110px;
		text-decoration: none;
		color: inherit;
	}

	.type-icon--group {
		color: var(--color-accent);
	}

	.type-icon--private {
		color: var(--color-category-private-icon);
	}

	.type-cta {
		display: inline-block;
		text-decoration: none;
		color: var(--color-text-primary);
	}

	.btn-primary--compact {
		font-size: 12px;
		padding: 6px 14px;
		min-height: unset;
	}

	.home-page .cards-scroll .tour-card.featured {
		border: 0.5px solid var(--color-border-tertiary);
	}

	.home-page .cards-scroll .tour-card.featured:hover {
		border-color: var(--color-border-primary);
	}
</style>
