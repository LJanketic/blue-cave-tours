---
export const prerender = true;

import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { HOME_PAGE_TITLE, SITE_DEFAULT_DESCRIPTION } from '../config/site';
import SiteLayout from '../layouts/SiteLayout.astro';
import HeroCarousel, { type HeroSlideView } from '../components/vue/HeroCarousel.vue';
import FAQAccordion from '../components/vue/FAQAccordion.vue';
import TrustBand from '../components/home/TrustBand.astro';
import PopularTours from '../components/home/PopularTours.astro';
import TypeCards from '../components/home/TypeCards.astro';
import DestinationTile from '../components/home/DestinationTile.astro';
import HowItWorks from '../components/home/HowItWorks.astro';
import GuestReviews from '../components/home/GuestReviews.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import PillLink from '../components/ui/PillLink.astro';
import CtaBand from '../components/ui/CtaBand.astro';
import Button from '../components/ui/Button.astro';
import { getFeaturedTours, getTourCardPhoto, getAllTours } from '../lib/tours';
import { getAllDestinations, getDestinationPhoto, getDestinationsForTour, getToursForDestination } from '../lib/destinations';
import { toTourCardDTO } from '../lib/cards';
import { FAQ_ITEMS } from '../data/faq';
import { HERO_IMAGE } from '../data/hero-image';
import { firstPhotoForDestination } from '../data/destination-photos';
import { GALLERY_CARD_SIZE, toCardPhoto, type PhotoRef } from '../data/tour-photos';
import { REVIEWS } from '../data/reviews';
import { CTA_BAND, DESTINATIONS_INTRO, HERO_SLIDES, HOW_IT_WORKS, TRUST_ITEMS, TYPE_CARDS } from '../data/marketing';
import { organizationJsonLd, websiteJsonLd } from '../lib/seo';

const faqPreview = FAQ_ITEMS.slice(0, 4);
const siteUrl = Astro.site ? String(Astro.site).replace(/\/$/, '') : '';
// FAQPage markup lives on /faq/ only: the home page shows the first few of the same questions.
const jsonLd = siteUrl ? [organizationJsonLd(siteUrl), websiteJsonLd(siteUrl)] : undefined;

/*
 * Hero photos. The design's own images aren't cleared for use yet (C-17), so
 * the slides use the site's photos: the boat, the Pakleni islands from the
 * air, and the Blue Cave. Picked for contrast behind the text (measured).
 */
function requirePhoto(photo: PhotoRef | undefined, label: string): { src: ImageMetadata; alt: string } {
	if (!photo?.src) throw new Error(`Homepage photo missing: ${label}`);
	return { src: photo.src, alt: photo.alt };
}
const SLIDE_PHOTOS: Record<(typeof HERO_SLIDES)[number]['id'], { src: ImageMetadata; alt: string }> = {
	group: { src: HERO_IMAGE.src, alt: HERO_IMAGE.alt },
	charter: requirePhoto(firstPhotoForDestination('pakleni', 4), 'pakleni 05'),
	'blue-cave': requirePhoto(firstPhotoForDestination('blue-cave', 0), 'blue-cave 01'),
};
const CTA_PHOTO = requirePhoto(firstPhotoForDestination('blue-lagoon', 0), 'blue-lagoon 01');

const HERO_WIDTHS = [800, 1280, 1600, 1920];
const heroSlides: HeroSlideView[] = await Promise.all(
	HERO_SLIDES.map(async (slide) => {
		const photo = SLIDE_PHOTOS[slide.id];
		const image = await getImage({ src: photo.src, widths: HERO_WIDTHS, format: 'webp', quality: 70 });
		return { ...slide, image: { src: image.src, srcset: image.srcSet.attribute, alt: photo.alt } };
	}),
);
const lcp = heroSlides[0].image;

const popularTours = await Promise.all(
	getFeaturedTours().map(async (tour) =>
		toTourCardDTO(
			tour,
			getDestinationsForTour(tour.slug).map((d) => d.slug),
			await toCardPhoto(getTourCardPhoto(tour), GALLERY_CARD_SIZE),
		),
	),
);

// The bento (§6.1.7, board 01 v4): 2×2, wide, single, single, wide, wide.
// Zlatni Rat has no real photo yet (C-18), so its tile is the gradient fallback.
const BENTO_SIZES = ['a', 'wide', 'single', 'single', 'wide', 'wide'] as const;
const bento = getAllDestinations()
	.filter((d) => d.bentoOrder !== undefined)
	.sort((a, b) => (a.bentoOrder ?? 0) - (b.bentoOrder ?? 0))
	.map((destination, i) => ({
		destination,
		image: getDestinationPhoto(destination).src,
		tourCount: getToursForDestination(destination.slug).length,
		size: BENTO_SIZES[i] ?? 'single',
	}));

const tourNames = Object.fromEntries(getAllTours().map((t) => [t.slug, t.title]));
---

<SiteLayout title={HOME_PAGE_TITLE} description={SITE_DEFAULT_DESCRIPTION} solidNav={false} jsonLd={jsonLd} fontPreload>
	<link
		slot="head"
		rel="preload"
		as="image"
		href={lcp.src}
		type="image/webp"
		imagesrcset={lcp.srcset}
		imagesizes="100vw"
		fetchpriority="high"
	/>
	<main id="main" class="home">
		<h1 class="sr-only">Hello Blue Cave: speedboat tours and private charters from Split</h1>
		<HeroCarousel client:load slides={heroSlides} scrollTarget="trust" />
		<TrustBand items={TRUST_ITEMS} id="trust" />

		<PopularTours tours={popularTours} />

		<div class="home__wrap">
			<section aria-labelledby="types-heading">
				<SectionHeader title="Group or private?" id="types-heading" />
				<TypeCards cards={TYPE_CARDS} />
			</section>

			<section aria-labelledby="destinations-heading">
				<SectionHeader title="Destinations" sub={DESTINATIONS_INTRO} id="destinations-heading">
					<PillLink href="/destinations/" slot="actions">All destinations</PillLink>
				</SectionHeader>
				<div class="home__bento-scroller" data-scroll-region="Destinations, scrollable">
				<ul class="home__bento" role="list">
					{
						bento.map(({ destination, image, tourCount, size }) => (
							<DestinationTile
								slug={destination.slug}
								name={destination.name}
								tagline={destination.tagline}
								tourCount={tourCount}
								image={image}
								icon={destination.icon}
								size={size}
							/>
						))
					}
				</ul>
				</div>
			</section>

			<section aria-labelledby="how-heading">
				<SectionHeader title="How it works" id="how-heading" />
				<HowItWorks steps={HOW_IT_WORKS} />
			</section>

			<GuestReviews reviews={REVIEWS} tourNames={tourNames} />

			<section aria-labelledby="faq-heading">
				<SectionHeader title="Common questions" id="faq-heading">
					<PillLink href="/faq/" ghost slot="actions">All FAQs</PillLink>
				</SectionHeader>
				<FAQAccordion client:idle items={faqPreview} idPrefix="home-faq" />
			</section>

			<div class="home__cta">
				<CtaBand variant="photo" heading={CTA_BAND.heading} text={CTA_BAND.text} image={CTA_PHOTO.src} imagePosition="center 60%">
					<Button variant="on-image" size="md" href={CTA_BAND.primary.href}>{CTA_BAND.primary.label}</Button>
					<Button variant="on-image-ghost" size="md" href={CTA_BAND.secondary.href}>{CTA_BAND.secondary.label}</Button>
				</CtaBand>
			</div>
		</div>
	</main>
</SiteLayout>

<script>
	import '../client/scroll-regions';
</script>

<style>
	@layer pages {
		.home__wrap {
			max-width: var(--content-max);
			margin: 0 auto;
			padding: 0 var(--page-gutter);
		}

		/* The bento (board 01 v4): 4 columns, 190px rows. */
		.home__bento {
			display: grid;
			grid-template-columns: repeat(4, minmax(0, 1fr));
			grid-auto-rows: 190px;
			gap: var(--space-3);
			margin: 0;
			padding: 0;
			list-style: none;
		}

		.home__cta {
			margin: var(--section-gap) 0 48px;
		}

		/* Phones: the bento becomes a row of 3:2 tiles that scrolls sideways. */
		@media (max-width: 768px) {
			.home__bento-scroller {
				margin: 0 calc(-1 * var(--page-gutter));
				overflow-x: auto;
				scroll-padding-inline: var(--page-gutter);
				scroll-snap-type: x mandatory;
				scrollbar-width: none;
			}

			.home__bento {
				display: flex;
				width: max-content;
				padding: 0 var(--page-gutter) 4px;
			}

			.home__bento > :global(li) {
				flex: 0 0 280px;
				aspect-ratio: 3 / 2;
				scroll-snap-align: start;
			}
		}

		@media (max-width: 480px) {
			.home__bento > :global(li) {
				flex-basis: min(280px, 80vw);
			}
		}
	}
</style>
