---
export const prerender = false;

import { randomBytes } from 'node:crypto';
import { pageTitle } from '../../config/site';
import SiteLayout from '../../layouts/SiteLayout.astro';
import BookingShell from '../../components/booking/BookingShell.astro';
import SummaryCard from '../../components/booking/SummaryCard.astro';
import Notice from '../../components/ui/Notice.astro';
import Button from '../../components/ui/Button.astro';
import { DEMO_CHECKOUT_OPEN, PAYMENTS_ARE_DEMO, PAYMENTS_MODE, demoCheckoutAllowed } from '../../config/payments';
import { DEMO_ACCESS_COOKIE, testHeaderClosesGate, verifyDemoAccessToken } from '../../lib/demo-access';
import { getTourBySlug } from '../../lib/tours';
import { feeLabel } from '../../lib/cards';
import { formatEuro } from '../../lib/price';
import { formatBookingDate, guestSummaryFromCounts } from '../../lib/booking';
import { isRecordId } from '../../lib/bookings/ids';
import { BOOKING_ERRORS, finalizePaidBooking, isPayable, notifyPaymentNotOpen, quoteExpired, recordFailedPayment, termsDueOnPayment } from '../../lib/bookings/service';
import { capacityChecked, capacityError } from '../../lib/bookings/capacity';
import { formatTimestamp } from '../../lib/bookings/dates';
import { durationLabel } from '../../config/charter';
import { CANCELLATION_PRIVATE_HREF } from '../../config/cancellation';
import { TERMS_VERSION } from '../../config/legal';
import { checkRateLimit, clientIp } from '../../lib/rate-limit';
import { bookings, isCharterQuote, type PaymentProvider } from '../../lib/bookings/store';

/**
 * DEMO checkout. Stands in for Teya Hosted Checkout and the PayPal button
 * (plan Phases 2 and 6): the customer picks a method and the payment
 * "succeeds" or "declines" on a button press. No money moves. Everything
 * after the payment (račun, emails, admin) is the real flow.
 *
 * The buttons are gated (demoCheckoutAllowed): they only work where the build
 * opened the demo checkout to everyone (dev, deploy previews) or for a browser
 * an admin enabled from /admin/tools. Everyone else is told online payment
 * isn't open yet, the booking stays awaiting payment, and the admin is emailed
 * once to confirm it by hand. Once payments are live the buttons never work.
 */

const id = Astro.url.searchParams.get('id');
const booking = isRecordId(id) ? await bookings().get(id) : null;
if (!booking) return Astro.redirect('/tours/', 303);
if (booking.paymentStatus === 'paid' && booking.status !== 'cancelled') {
	return Astro.redirect(`/booking/success/?id=${booking.id}`, 303);
}
const payable = isPayable(booking);
const isPrivate = booking.kind === 'private';
// A charter quote, unlike a private experience booked on the site, came from staff.
const isQuote = isPrivate && isCharterQuote(booking);
// A charter quote has no review step: its terms are accepted here (S-4). Bookings made
// on the site (group, or a private experience) accepted them on the review page.
const askTerms = termsDueOnPayment(booking);
const demoCheckout = demoCheckoutAllowed({
	mode: PAYMENTS_MODE,
	openFlag: DEMO_CHECKOUT_OPEN && !testHeaderClosesGate(Astro.request.headers),
	cookieValid: verifyDemoAccessToken(Astro.cookies.get(DEMO_ACCESS_COOKIE)?.value),
});

// The buttons below only stand in for a gateway: without demo access, and always
// once payments are live, a POST here must never mark a booking paid. Real
// payments will confirm through their own return and webhook routes.
if (Astro.request.method === 'POST' && !demoCheckout) {
	return new Response('Online payment is not open yet.', { status: 403, headers: { 'Cache-Control': 'no-store', 'Content-Type': 'text/plain; charset=utf-8' } });
}

// The departure may have sold out since this booking was made: check again, leaving out its own claim, before
// offering or taking a payment. Not for a charter quote (staff chose the boat). If the check can't run, payment goes
// ahead and finalizePaidBooking notes it; two payments racing for the last seat are still caught there.
const soldOut =
	payable && capacityChecked(booking)
		? await capacityError(booking, new Date(), booking.id).catch((err) => {
				console.error(`[booking ${booking.id}] capacity not checked on the pay page`, err);
				return null;
			})
		: null;

if (Astro.request.method === 'POST' && payable && soldOut) {
	// Nothing is paid: the page shows why.
	return Astro.redirect(`/booking/pay/?id=${booking.id}`, 303);
}

if (Astro.request.method === 'POST' && payable) {
	const ip = clientIp(Astro.request);
	if (!(await checkRateLimit('pay', ip, { max: 20, failClosed: true })).ok) return Astro.redirect(`/booking/pay/?id=${booking.id}`, 303);
	let form: FormData;
	try {
		form = await Astro.request.formData();
	} catch {
		// Not a form post (or a broken one): show the page again, nothing is paid.
		return Astro.redirect(`/booking/pay/?id=${booking.id}`, 303);
	}
	// The demo's "simulate a declined payment" needs no terms: nothing is booked.
	if (askTerms && form.get('outcome') !== 'decline' && (form.get('terms') !== 'yes' || form.get('termsVersion') !== TERMS_VERSION)) {
		return Astro.redirect(`/booking/pay/?id=${booking.id}&terms=1`, 303);
	}
	const provider: PaymentProvider = form.get('provider') === 'paypal' ? 'paypal' : 'teya';
	if (form.get('outcome') === 'decline') {
		await recordFailedPayment(booking.id, provider);
		return Astro.redirect(`/booking/error/?id=${booking.id}`, 303);
	}
	const paymentRef = `DEMO-${provider === 'paypal' ? 'PP' : 'TEYA'}-${randomBytes(4).toString('hex').toUpperCase()}`;
	await finalizePaidBooking(booking.id, provider, paymentRef, Astro.url.origin);
	return Astro.redirect(`/booking/success/?id=${booking.id}`, 303);
}

// Cancelled, refunded or closed-departure bookings can't be paid: say so instead of offering a button.
const closedReason =
	booking.status === 'cancelled' || booking.paymentStatus === 'refunded'
		? isQuote && !booking.paidAt
			? 'This quote was withdrawn or replaced by a newer one. Please use the link in our latest email.'
			: isPrivate
				? 'This private experience was cancelled.'
				: 'This booking was cancelled.'
		: quoteExpired(booking)
			? 'This quote has expired. Contact us and we will check the date again and send a new one.'
			: 'This booking can no longer be paid, because booking for this departure has closed.';
const termsMissing = Astro.url.searchParams.get('terms') === '1';

// Online payment isn't open to this guest: tell the admin once, so they confirm it by email (not for a sold-out departure).
if (payable && !soldOut && !demoCheckout) {
	try {
		await notifyPaymentNotOpen(booking.id, Astro.url.origin);
	} catch (err) {
		console.error(`[booking ${booking.id}] admin not told about a booking awaiting payment`, err);
	}
}

const guests = guestSummaryFromCounts(booking.adults, booking.children, booking.infants);
const tour = getTourBySlug(booking.tourSlug);
const fee = tour ? feeLabel(tour) : undefined;
Astro.response.headers.set('Cache-Control', 'no-store');
---

<SiteLayout title={pageTitle('Payment')} description="Complete your booking payment." checkout robots="noindex, nofollow">
	<BookingShell step={isQuote ? undefined : 4} exitHref={`/tours/${booking.tourSlug}/`} heading={isQuote ? 'Your private experience quote' : 'Payment'} headingVisible>
		{
			PAYMENTS_ARE_DEMO && demoCheckout && payable && !soldOut && (
				<Notice tone="info" icon="info-circle" class="pay__demo">
					<strong>Demo checkout.</strong> No real payment is taken. When real payments are switched on, you'll pay here
					on Teya's payment page or with PayPal.
				</Notice>
			)
		}

		<SummaryCard
			title="Your booking"
			rows={[
				{ label: 'Tour', value: booking.tourTitle },
				{ label: 'Date', value: `${formatBookingDate(booking.date)}${booking.slot ? `, ${booking.slot}` : ''}` },
				...(isPrivate && booking.durationHours ? [{ label: 'Duration', value: durationLabel(booking.durationHours) }] : []),
				{ label: 'Guests', value: guests },
				...(booking.pickup ? [{ label: 'Pick-up', value: booking.pickup }] : []),
				// A private experience booked on the site: the boat and each extra, as charged.
				...(isPrivate && !isQuote ? (booking.lineItems ?? []).map((item) => ({ label: item.label, value: formatEuro(item.amount) })) : []),
				{ label: 'Booking ref', value: booking.ref },
				...(isPrivate && booking.quoteExpiresAt && payable ? [{ label: 'Quote valid until', value: formatTimestamp(booking.quoteExpiresAt) }] : []),
			]}
			total={{ label: 'Total (incl. VAT)', value: formatEuro(booking.total) }}
			note={fee}
		/>

		{
			!payable ? (
				<div class="pay__closed" role="status">
					<p>{closedReason}</p>
					<p>
						Questions? <a href="/contact/">Contact us</a> and quote <strong>{booking.ref}</strong>.
					</p>
					<Button href="/tours/">Browse tours</Button>
				</div>
			) : soldOut ? (
				<div class="pay__closed" role="status" id="pay-sold-out">
					<p>{BOOKING_ERRORS[soldOut]} Nothing has been charged.</p>
					<p>
						Questions? <a href="/contact/">Contact us</a> and quote <strong>{booking.ref}</strong>.
					</p>
					<Button href={soldOut === 'boat' ? '/private-charter/' : `/tours/${booking.tourSlug}/`}>
						{soldOut === 'boat' ? 'Send a request' : 'Choose another time'}
					</Button>
				</div>
			) : !demoCheckout ? (
				<div class="pay__closed" role="status" id="pay-not-open">
					<p>
						<strong>Online payment isn't open yet.</strong>{' '}
						{isQuote
							? "Nothing has been charged. We'll contact you by email to confirm your private experience."
							: "We've received your booking and will confirm it by email. Nothing has been charged."}
					</p>
					<p>
						Questions? <a href="/contact/">Contact us</a> and quote <strong>{booking.ref}</strong>.
					</p>
				</div>
			) : (
				<form method="post" class="pay__form">
					{booking.paymentStatus === 'failed' && (
						<Notice tone="warn" alert>
							Your last payment attempt was declined. Nothing was charged. You can try again.
						</Notice>
					)}
					<fieldset class="pay__methods">
						<legend>Pay with</legend>
						<label class="pay__method">
							<input type="radio" name="provider" value="teya" checked />
							<span class="pay__icon" aria-hidden="true"><i class="ti ti-credit-card" /></span>
							<span><strong>Card</strong><small>Visa, Mastercard and more, through Teya</small></span>
						</label>
						<label class="pay__method">
							<input type="radio" name="provider" value="paypal" />
							<span class="pay__icon" aria-hidden="true"><i class="ti ti-brand-paypal" /></span>
							<span><strong>PayPal</strong><small>Pay with your PayPal account</small></span>
						</label>
					</fieldset>
					{fee && <p class="pay__small">{fee}.</p>}
					{askTerms ? (
						<>
							<input type="hidden" name="termsVersion" value={TERMS_VERSION} />
							{termsMissing && (
								<Notice tone="warn" alert>
									Please accept the terms to book your private experience.
								</Notice>
							)}
							<label class="pay__terms">
								<input type="checkbox" name="terms" value="yes" required />
								<span>
									I accept the <a href="/legal/terms/">terms and conditions</a> and the
									<a href={CANCELLATION_PRIVATE_HREF}>cancellation terms for private experiences</a>. A leisure service on a
									fixed date: the 14-day right of withdrawal doesn't apply.
								</span>
							</label>
						</>
					) : (
						<p class="pay__small">
							A leisure service on a fixed date: the 14-day right of withdrawal doesn't apply; our
							<a href={isPrivate ? CANCELLATION_PRIVATE_HREF : '/legal/cancellation/'}>cancellation policy</a> does.
						</p>
					)}
					<Button type="submit" name="outcome" value="success" size="lg" block icon="lock">Pay {formatEuro(booking.total)}</Button>
					<button class="pay__decline" type="submit" name="outcome" value="decline" formnovalidate>Demo: simulate a declined payment</button>
				</form>
			)
		}
	</BookingShell>
</SiteLayout>

<script>
	// One payment per click: a double-click would otherwise post twice.
	document.querySelector('form.pay__form')?.addEventListener('submit', (event) => {
		const form = event.currentTarget as HTMLFormElement;
		const submitter = (event as SubmitEvent).submitter as HTMLButtonElement | null;
		// Keep the clicked button's value: disabled buttons aren't submitted.
		if (submitter?.name) {
			const hidden = document.createElement('input');
			hidden.type = 'hidden';
			hidden.name = submitter.name;
			hidden.value = submitter.value;
			form.append(hidden);
		}
		for (const button of form.querySelectorAll('button')) button.disabled = true;
	});
</script>

<style>
	@layer pages {
		:global(.pay__demo) {
			margin-bottom: var(--space-4);
		}

		.pay__form {
			display: grid;
			gap: var(--space-3);
			margin-top: var(--space-4);
		}

		.pay__methods {
			display: grid;
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 10px;
			margin: 0;
			padding: 0;
			border: 0;
		}

		.pay__methods legend {
			margin-bottom: var(--space-2);
			font-weight: var(--font-weight-medium);
		}

		.pay__method {
			display: flex;
			align-items: center;
			gap: var(--space-3);
			padding: 14px var(--space-4);
			border: 1px solid var(--color-border-card);
			border-radius: var(--radius-lg);
			cursor: pointer;
		}

		.pay__method:hover {
			border-color: var(--color-border-primary);
		}

		.pay__method input {
			width: 18px;
			height: 18px;
			margin: 0;
			accent-color: var(--color-brand);
		}

		.pay__icon {
			display: flex;
			align-items: center;
			justify-content: center;
			width: 36px;
			height: 36px;
			border-radius: var(--radius-md);
			background: var(--color-background-secondary);
			color: var(--color-text-brand);
			font-size: 18px;
		}

		.pay__method strong,
		.pay__method small {
			display: block;
		}

		.pay__method small {
			font-size: var(--font-size-xs);
			color: var(--color-text-secondary);
		}

		.pay__small {
			margin: 0;
			font-size: var(--font-size-sm);
			color: var(--color-text-secondary);
		}

		.pay__small a {
			color: var(--color-text-info);
		}

		.pay__decline {
			justify-self: center;
			min-height: 24px;
			padding: 0;
			border: 0;
			background: none;
			color: var(--color-text-secondary);
			font: inherit;
			font-size: var(--font-size-sm);
			text-decoration: underline;
			cursor: pointer;
		}

		.pay__terms {
			display: flex;
			gap: var(--space-2);
			align-items: flex-start;
			font-size: var(--font-size-sm);
			color: var(--color-text-secondary);
		}

		.pay__terms input {
			flex-shrink: 0;
			width: 18px;
			height: 18px;
			margin: 1px 0 0;
			accent-color: var(--color-brand);
		}

		.pay__terms a {
			color: var(--color-text-info);
		}

		.pay__closed {
			display: grid;
			gap: var(--space-2);
			justify-items: start;
			margin-top: var(--space-4);
		}

		.pay__closed p {
			margin: 0;
		}

		@media (max-width: 768px) {
			.pay__methods {
				grid-template-columns: 1fr;
			}
		}
	}
</style>
