---
export const prerender = false;

import { randomBytes } from 'node:crypto';
import { pageTitle } from '../../config/site';
import SiteLayout from '../../layouts/SiteLayout.astro';
import BookingShell from '../../components/booking/BookingShell.astro';
import SummaryCard from '../../components/booking/SummaryCard.astro';
import Notice from '../../components/ui/Notice.astro';
import Button from '../../components/ui/Button.astro';
import { PAYMENTS_ARE_DEMO } from '../../config/payments';
import { getTourBySlug } from '../../lib/tours';
import { mandatoryFeeLabel } from '../../lib/cards';
import { formatBookingDate, guestSummaryFromCounts } from '../../lib/booking';
import { isRecordId } from '../../lib/bookings/ids';
import { finalizePaidBooking, isPayable, recordFailedPayment } from '../../lib/bookings/service';
import { checkRateLimit } from '../../lib/rate-limit';
import { bookings, type PaymentProvider } from '../../lib/bookings/store';

/**
 * DEMO checkout. Stands in for Teya Hosted Checkout and the PayPal button
 * (plan Phases 2 and 6): the customer picks a method and the payment
 * "succeeds" or "declines" on a button press. No money moves. Everything
 * after the payment (račun, emails, admin) is the real flow.
 */

const id = Astro.url.searchParams.get('id');
const booking = isRecordId(id) ? await bookings().get(id) : null;
if (!booking) return Astro.redirect('/tours/', 303);
if (booking.paymentStatus === 'paid' && booking.status !== 'cancelled') {
	return Astro.redirect(`/booking/success/?id=${booking.id}`, 303);
}
const payable = isPayable(booking);

if (Astro.request.method === 'POST' && payable) {
	const ip = Astro.request.headers.get('x-nf-client-connection-ip') ?? 'unknown';
	if (!(await checkRateLimit('pay', ip, { max: 20, failClosed: true })).ok) return Astro.redirect(`/booking/pay/?id=${booking.id}`, 303);
	const form = await Astro.request.formData();
	const provider: PaymentProvider = form.get('provider') === 'paypal' ? 'paypal' : 'teya';
	if (form.get('outcome') === 'decline') {
		await recordFailedPayment(booking.id, provider);
		return Astro.redirect(`/booking/error/?id=${booking.id}`, 303);
	}
	const paymentRef = `DEMO-${provider === 'paypal' ? 'PP' : 'TEYA'}-${randomBytes(4).toString('hex').toUpperCase()}`;
	await finalizePaidBooking(booking.id, provider, paymentRef, Astro.url.origin);
	return Astro.redirect(`/booking/success/?id=${booking.id}`, 303);
}

// Cancelled, refunded or past-date bookings can't be paid: say so instead of offering a button.
const closedReason =
	booking.status === 'cancelled' || booking.paymentStatus === 'refunded'
		? 'This booking was cancelled.'
		: 'This booking can no longer be paid, because the tour date has passed.';

const guests = guestSummaryFromCounts(booking.adults, booking.children, booking.infants);
const tour = getTourBySlug(booking.tourSlug);
const fee = tour ? mandatoryFeeLabel(tour) : undefined;
Astro.response.headers.set('Referrer-Policy', 'no-referrer');
Astro.response.headers.set('Cache-Control', 'no-store');
---

<SiteLayout title={pageTitle('Payment')} description="Complete your booking payment." checkout robots="noindex, nofollow">
	<BookingShell step={4} exitHref={`/tours/${booking.tourSlug}/`} heading="Payment" headingVisible>
		{
			PAYMENTS_ARE_DEMO && (
				<Notice tone="info" icon="info-circle" class="pay__demo">
					<strong>Demo checkout.</strong> No real payment is taken. When real payments are switched on, you'll pay here
					on Teya's payment page or with PayPal.
				</Notice>
			)
		}

		<SummaryCard
			title="Your booking"
			rows={[
				{ label: 'Tour', value: booking.tourTitle },
				{ label: 'Date', value: `${formatBookingDate(booking.date)}${booking.slot ? `, ${booking.slot}` : ''}` },
				{ label: 'Guests', value: guests },
				{ label: 'Booking ref', value: booking.ref },
			]}
			total={{ label: 'Total', value: `€${booking.total}` }}
			note={fee}
		/>

		{
			!payable ? (
				<div class="pay__closed" role="status">
					<p>{closedReason}</p>
					<p>
						Questions? <a href="/contact/">Contact us</a> and quote <strong>{booking.ref}</strong>.
					</p>
					<Button href="/tours/">Browse tours</Button>
				</div>
			) : (
				<form method="post" class="pay__form">
					{booking.paymentStatus === 'failed' && (
						<Notice tone="warn" alert>
							Your last payment attempt was declined. Nothing was charged. You can try again.
						</Notice>
					)}
					<fieldset class="pay__methods">
						<legend>Pay with</legend>
						<label class="pay__method">
							<input type="radio" name="provider" value="teya" checked />
							<span class="pay__icon" aria-hidden="true"><i class="ti ti-credit-card" /></span>
							<span><strong>Card</strong><small>Visa, Mastercard and more, through Teya</small></span>
						</label>
						<label class="pay__method">
							<input type="radio" name="provider" value="paypal" />
							<span class="pay__icon" aria-hidden="true"><i class="ti ti-brand-paypal" /></span>
							<span><strong>PayPal</strong><small>Pay with your PayPal account</small></span>
						</label>
					</fieldset>
					{fee && <p class="pay__small">{fee}.</p>}
					<p class="pay__small">
						A leisure service on a fixed date: the 14-day right of withdrawal doesn't apply; our
						<a href="/legal/cancellation/">cancellation policy</a> does.
					</p>
					<Button type="submit" name="outcome" value="success" size="lg" block icon="lock">Pay €{booking.total}</Button>
					<button class="pay__decline" type="submit" name="outcome" value="decline">Demo: simulate a declined payment</button>
				</form>
			)
		}
	</BookingShell>
</SiteLayout>

<script>
	// One payment per click: a double-click would otherwise post twice.
	document.querySelector('form.pay__form')?.addEventListener('submit', (event) => {
		const form = event.currentTarget as HTMLFormElement;
		const submitter = (event as SubmitEvent).submitter as HTMLButtonElement | null;
		// Keep the clicked button's value: disabled buttons aren't submitted.
		if (submitter?.name) {
			const hidden = document.createElement('input');
			hidden.type = 'hidden';
			hidden.name = submitter.name;
			hidden.value = submitter.value;
			form.append(hidden);
		}
		for (const button of form.querySelectorAll('button')) button.disabled = true;
	});
</script>

<style>
	@layer pages {
		:global(.pay__demo) {
			margin-bottom: var(--space-4);
		}

		.pay__form {
			display: grid;
			gap: var(--space-3);
			margin-top: var(--space-4);
		}

		.pay__methods {
			display: grid;
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 10px;
			margin: 0;
			padding: 0;
			border: 0;
		}

		.pay__methods legend {
			margin-bottom: var(--space-2);
			font-weight: var(--font-weight-medium);
		}

		.pay__method {
			display: flex;
			align-items: center;
			gap: var(--space-3);
			padding: 14px var(--space-4);
			border: 1px solid var(--color-border-card);
			border-radius: var(--radius-lg);
			cursor: pointer;
		}

		.pay__method:hover {
			border-color: var(--color-border-primary);
		}

		.pay__method input {
			width: 18px;
			height: 18px;
			margin: 0;
			accent-color: var(--color-brand);
		}

		.pay__icon {
			display: flex;
			align-items: center;
			justify-content: center;
			width: 36px;
			height: 36px;
			border-radius: var(--radius-md);
			background: var(--color-background-secondary);
			color: var(--color-text-brand);
			font-size: 18px;
		}

		.pay__method strong,
		.pay__method small {
			display: block;
		}

		.pay__method small {
			font-size: var(--font-size-xs);
			color: var(--color-text-secondary);
		}

		.pay__small {
			margin: 0;
			font-size: var(--font-size-sm);
			color: var(--color-text-secondary);
		}

		.pay__small a {
			color: var(--color-text-info);
		}

		.pay__decline {
			justify-self: center;
			min-height: 24px;
			padding: 0;
			border: 0;
			background: none;
			color: var(--color-text-secondary);
			font: inherit;
			font-size: var(--font-size-sm);
			text-decoration: underline;
			cursor: pointer;
		}

		.pay__closed {
			display: grid;
			gap: var(--space-2);
			justify-items: start;
			margin-top: var(--space-4);
		}

		.pay__closed p {
			margin: 0;
		}

		@media (max-width: 768px) {
			.pay__methods {
				grid-template-columns: 1fr;
			}
		}
	}
</style>
