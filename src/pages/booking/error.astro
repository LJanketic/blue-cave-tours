---
export const prerender = false;

import { pageTitle, SITE_NAME, SITE_PHONE, SITE_PHONE_DISPLAY } from '../../config/site';
import SiteLayout from '../../layouts/SiteLayout.astro';
import BookingShell from '../../components/booking/BookingShell.astro';
import Notice from '../../components/ui/Notice.astro';
import Button from '../../components/ui/Button.astro';
import { getTourBySlug } from '../../lib/tours';
import { isRecordId } from '../../lib/bookings/ids';
import { bookings } from '../../lib/bookings/store';
import { isPayable } from '../../lib/bookings/service';

// A declined payment returns here with the booking id: retrying goes straight
// back to payment with the saved details. Without one (the booking couldn't be
// saved at all), the customer starts the tour's booking form again.
const id = Astro.url.searchParams.get('id');
const stored = isRecordId(id) ? await bookings().get(id) : null;
// Anything no longer payable (paid, cancelled, past) is handled by the pay page.
if (stored && !isPayable(stored)) return Astro.redirect(`/booking/pay/?id=${stored.id}`, 303);
const booking = stored;
const tourIdParam = Astro.url.searchParams.get('tourId');
const bookedTour = tourIdParam ? getTourBySlug(tourIdParam) : undefined;
const retryHref = booking
	? `/booking/pay/?id=${booking.id}`
	: bookedTour
		? `/book/${bookedTour.slug}/group/`
		: '/tours/';
Astro.response.headers.set('Cache-Control', 'no-store');

const REASONS = [
	{ icon: 'credit-card', text: 'Incorrect card number, expiry date or security code' },
	{ icon: 'building-bank', text: 'Your bank declined the payment: they can tell you why' },
	{ icon: 'wifi-off', text: 'The connection dropped during payment' },
	{ icon: 'lock', text: 'The 3D Secure check timed out or was declined' },
];
---

<SiteLayout
	title={pageTitle(booking ? 'Payment unsuccessful' : "We couldn't save your booking")}
	description={`There was a problem completing your payment with ${SITE_NAME}.`}
	checkout
	robots="noindex, nofollow"
>
	<BookingShell exitHref="/tours/" heading={booking ? 'Payment unsuccessful' : "We couldn't save your booking"} headingVisible>
		<span slot="lead" class="fail__icon" aria-hidden="true"><i class="ti ti-x"></i></span>
		<div class="fail__hero">
			<p>{booking ? "You haven't been charged." : 'Nothing was charged. Please start your booking again.'}</p>
		</div>

		<Notice tone="danger" alert>
			{
				booking?.kind === 'private'
					? "Your charter isn't booked until it's paid. You can try again now, while your quote is valid, or call us."
					: booking
						? "We don't hold seats until you pay. You can try again now, or call us and we'll book it for you."
					: 'Something went wrong saving your booking. Please try again, or call us and we\'ll book it for you.'
			}
		</Notice>

		{
			booking && (
				<section class="fail__card" aria-labelledby="reasons-heading">
					<h2 id="reasons-heading">
						<i class="ti ti-help-circle" aria-hidden="true" /> Common reasons
					</h2>
					<ul role="list">
						{REASONS.map((r) => (
							<li>
								<i class={`ti ti-${r.icon}`} aria-hidden="true" />
								{r.text}
							</li>
						))}
					</ul>
				</section>
			)
		}

		<div class="fail__help">
			<span class="fail__help-icon" aria-hidden="true"><i class="ti ti-headset"></i></span>
			<div>
				<p><strong>Need help?</strong> If it keeps failing, we can take your booking by phone.</p>
				<p><a href={`tel:${SITE_PHONE}`}>{SITE_PHONE_DISPLAY}</a> · <a href="/contact/">Contact us</a></p>
			</div>
		</div>

		<div class="fail__actions">
			<Button href={retryHref} size="lg" block icon="refresh">{booking ? 'Try payment again' : 'Start booking again'}</Button>
			<Button href="/tours/" variant="secondary" block>Back to tours</Button>
		</div>
	</BookingShell>
</SiteLayout>

<style>
	@layer pages {
		.fail__hero {
			margin-bottom: var(--space-4);
			text-align: center;
		}

		:global(.booking-shell h1) {
			text-align: center;
		}

		.fail__icon {
			display: flex;
			margin-inline: auto;
			align-items: center;
			justify-content: center;
			width: 72px;
			height: 72px;
			margin-bottom: var(--space-3);
			border-radius: 50%;
			background: var(--color-background-danger);
			color: var(--color-text-danger);
			font-size: 34px;
		}

		.fail__hero p {
			margin: 0;
			color: var(--color-text-secondary);
		}

		.fail__card {
			margin-top: var(--space-4);
			padding: 1.25rem;
			border: 1px solid var(--color-border-card);
			border-radius: var(--radius-lg);
		}

		.fail__card h2 {
			display: flex;
			align-items: center;
			gap: var(--space-2);
			margin: 0 0 var(--space-3);
			font-size: var(--font-size-lg);
			font-weight: var(--font-weight-medium);
		}

		.fail__card h2 .ti {
			font-size: 16px;
			color: var(--color-accent);
		}

		.fail__card ul {
			display: grid;
			gap: 10px;
			margin: 0;
			padding: 0;
			list-style: none;
		}

		.fail__card li {
			display: flex;
			gap: var(--space-3);
			color: var(--color-text-secondary);
		}

		.fail__card li .ti {
			flex-shrink: 0;
			margin-top: 3px;
			color: var(--color-text-tertiary);
		}

		.fail__help {
			display: flex;
			gap: var(--space-3);
			margin-top: var(--space-4);
			padding: var(--space-4);
			border-radius: var(--radius-lg);
			background: var(--color-background-secondary);
		}

		.fail__help p {
			margin: 0;
			font-size: var(--font-size-sm);
			color: var(--color-text-secondary);
		}

		.fail__help a {
			color: var(--color-text-info);
		}

		.fail__help-icon {
			display: flex;
			flex-shrink: 0;
			align-items: center;
			justify-content: center;
			width: 36px;
			height: 36px;
			border-radius: 50%;
			background: var(--color-background-primary);
			color: var(--color-text-brand);
			font-size: 18px;
		}

		.fail__actions {
			display: grid;
			gap: var(--space-2);
			margin-top: var(--space-5);
		}
	}
</style>
