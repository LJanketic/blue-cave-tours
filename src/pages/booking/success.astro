---
export const prerender = false;

/**
 * Booking confirmed (spec §8.1.5, board 08). Shows only what the customer
 * needs on a page anyone with the link could see: no name, phone or notes,
 * and a masked email (S-3). Clears the booking cookie (S-12).
 */
import { MEETING_POINT_LABEL, MEETING_POINT_MAP_URL, pageTitle, SITE_NAME } from '../../config/site';
import { WEATHER_UPDATE_NOTE } from '../../config/cancellation';
import { PAYMENTS_ARE_DEMO } from '../../config/payments';
import SiteLayout from '../../layouts/SiteLayout.astro';
import BookingShell from '../../components/booking/BookingShell.astro';
import SummaryCard from '../../components/booking/SummaryCard.astro';
import Notice from '../../components/ui/Notice.astro';
import Button from '../../components/ui/Button.astro';
import { getTourBySlug } from '../../lib/tours';
import { formatBookingDate, guestSummaryFromCounts } from '../../lib/booking';
import { formatEuro } from '../../lib/price';
import { isRecordId } from '../../lib/bookings/ids';
import { bookings } from '../../lib/bookings/store';
import { BOOKING_COOKIE } from '../../lib/bookings/session';

// Only a paid, active booking gets this page; anything else goes to the payment page.
const id = Astro.url.searchParams.get('id');
const booking = isRecordId(id) ? await bookings().get(id) : null;
if (!booking) return Astro.redirect('/tours/', 303);
if (booking.paymentStatus !== 'paid' || booking.status === 'cancelled') return Astro.redirect(`/booking/pay/?id=${booking.id}`, 303);

Astro.cookies.delete(BOOKING_COOKIE, { path: '/' });
Astro.response.headers.set('Cache-Control', 'no-store');

/** "i***@example.com" */
function maskEmail(email: string): string {
	const [user, domain] = email.split('@');
	return domain ? `${user.slice(0, 1)}***@${domain}` : '***';
}

const tour = getTourBySlug(booking.tourSlug);
const departure = tour?.departures.find((d) => d.time === booking.slot);
/** "07:05": 15 minutes before a "07:20" departure. */
function fifteenEarlier(slot: string): string {
	const [h, m] = slot.split(':').map(Number);
	const t = h * 60 + m - 15;
	return `${String(Math.floor(t / 60)).padStart(2, '0')}:${String(t % 60).padStart(2, '0')}`;
}
// Board 07: "07:05 (15 min early)". Blue Cave guests come for the departure itself (arriveOnTime, ClickUp 8 Nov 2026);
// a tour with a check-in uses it.
const arriveAt = departure?.arriveOnTime ? departure.time : (departure?.checkIn ?? (booking.slot ? fifteenEarlier(booking.slot) : null));
const arriveBy = arriveAt === null ? '15 minutes before departure' : departure?.arriveOnTime ? arriveAt : `${arriveAt} (15 min early)`;
const emailSent = booking.confirmationEmail?.delivery === 'sent';
const bring = tour?.whatToBring.slice(0, 3).join(', ') ?? 'Swimwear, towel, sunscreen';
---

<SiteLayout title={pageTitle('Booking confirmed')} description={`Your booking with ${SITE_NAME} is confirmed.`} checkout robots="noindex, nofollow">
	<BookingShell exitHref="/tours/" heading="You're booked!" headingVisible>
		<span slot="lead" class="done__icon" aria-hidden="true"><i class="ti ti-check"></i></span>
		<div class="done__hero">
			<p>
				{emailSent ? <>Confirmation sent to <strong>{maskEmail(booking.email)}</strong>. Check your inbox — including spam just in case.</> : <>Your confirmation email is saved in our system{PAYMENTS_ARE_DEMO ? ' (demo: not sent)' : ''}.</>}
			</p>
		</div>
		{PAYMENTS_ARE_DEMO && <Notice tone="info" icon="info-circle">Demo booking. No payment was taken.</Notice>}

		<div class="done__ref">
			<span>Booking ref: <strong id="booking-ref">{booking.ref}</strong></span>
			<button type="button" class="done__copy" data-copy="booking-ref" hidden>
				<i class="ti ti-copy" aria-hidden="true"></i> Copy
			</button>
			<span class="sr-only" role="status" data-copy-status></span>
		</div>

		<SummaryCard
			title={booking.kind === 'private' ? 'Your private experience' : 'Your booking'}
			rows={[
				{ label: 'Tour', value: booking.tourTitle },
				{ label: 'Date', value: formatBookingDate(booking.date) },
				// Board 07: "07:20 — Split Riva, stand number 14". The invoice number is in the confirmation email.
				{ label: 'Departure', value: booking.slot ? `${booking.slot} — ${booking.pickup ?? MEETING_POINT_LABEL}` : 'Confirmed by email' },
				{ label: 'Guests', value: guestSummaryFromCounts(booking.adults, booking.children, booking.infants) },
			]}
			total={{ label: 'Total paid', value: formatEuro(booking.total) }}
		/>

		<section class="done__card" aria-labelledby="meet-heading">
			{/* A private experience with a pick-up starts there, not at the stand: no meeting point, map or check-in. */}
			<h2 id="meet-heading"><i class="ti ti-map-pin" aria-hidden="true"></i> {booking.pickup ? 'Where we pick you up' : 'Where to meet us'}</h2>
			<dl class="done__meet">
				{
					booking.pickup ? (
						<>
							<div><dt>Pick-up</dt><dd>{booking.pickup}</dd></div>
							<div><dt>Pick-up time</dt><dd>We confirm it with you by email, in time for your {booking.slot} departure</dd></div>
						</>
					) : (
						<>
							<div><dt>Location</dt><dd>{MEETING_POINT_LABEL}</dd></div>
							<div><dt>Arrive by</dt><dd>{arriveBy}</dd></div>
						</>
					)
				}
				<div><dt>What to bring</dt><dd>{bring}</dd></div>
				{!booking.pickup && <div><dt>Captain</dt><dd>Your captain will meet you at the boat</dd></div>}
			</dl>
			{
				!booking.pickup && (
					<a class="done__map" href={MEETING_POINT_MAP_URL} target="_blank" rel="noopener">
						<i class="ti ti-map-2" aria-hidden="true" /> View meeting point on map<span class="sr-only"> (opens in a new tab)</span>
					</a>
				)
			}
		</section>

		<section class="done__card" aria-labelledby="next-heading">
			<h2 id="next-heading"><i class="ti ti-list-check" aria-hidden="true"></i> What happens next</h2>
			<ol class="done__next" role="list">
				<li>
					<i class="ti ti-mail" aria-hidden="true"></i>
					<span><strong>Check your email</strong> Full booking details, {booking.pickup ? 'pick-up' : 'meeting point'}, and what to bring{emailSent ? <> — sent to {maskEmail(booking.email)} right now.</> : '.'}</span>
				</li>
				<li><i class="ti ti-cloud-storm" aria-hidden="true"></i><span><strong>Weather update</strong> {WEATHER_UPDATE_NOTE}</span></li>
				<li>
					<i class="ti ti-anchor" aria-hidden="true"></i>
					<span>
						<strong>Show up and enjoy</strong>
						{booking.pickup ? 'Be ready at your pick-up point at the time we confirm.' : `Arrive at the Riva promenade, stand number 14, by ${arriveAt ?? 'your check-in'}.`} Your captain will be waiting — no need to print anything.
					</span>
				</li>
			</ol>
		</section>

		<div class="done__actions">
			<Button href="/tours/" variant="secondary">Browse more tours</Button>
		</div>
	</BookingShell>
</SiteLayout>

<script>
	// "Copy" for the booking reference; without clipboard access it selects the text instead.
	for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
		const target = document.getElementById(button.dataset.copy ?? '');
		const status = button.parentElement?.querySelector<HTMLElement>('[data-copy-status]');
		if (!target) continue;
		button.hidden = false;
		button.addEventListener('click', async () => {
			try {
				await navigator.clipboard.writeText(target.textContent ?? '');
				if (status) status.textContent = 'Copied';
				setTimeout(() => status && (status.textContent = ''), 1500);
			} catch {
				const range = document.createRange();
				range.selectNodeContents(target);
				window.getSelection()?.removeAllRanges();
				window.getSelection()?.addRange(range);
			}
		});
	}
</script>

<style>
	@layer pages {
		.done__hero {
			margin-bottom: var(--space-4);
			text-align: center;
		}

		.done__icon {
			display: flex;
			margin-inline: auto;
			align-items: center;
			justify-content: center;
			width: 72px;
			height: 72px;
			margin-bottom: var(--space-3);
			border-radius: 50%;
			background: var(--color-background-positive);
			color: var(--color-icon-positive);
			font-size: 34px;
		}

		.done__hero p {
			margin: 0;
			color: var(--color-text-secondary);
		}

		:global(.booking-shell h1) {
			text-align: center;
		}

		.done__ref {
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: var(--space-3);
			margin: var(--space-4) 0;
			padding: var(--space-3) var(--space-4);
			border-radius: var(--radius-md);
			background: var(--color-background-secondary);
		}

		.done__copy {
			display: inline-flex;
			align-items: center;
			gap: 4px;
			min-height: 28px;
			padding: 0 10px;
			border: 0.5px solid var(--color-border-secondary);
			border-radius: var(--radius-md);
			background: var(--color-background-primary);
			color: var(--color-text-primary);
			font: inherit;
			font-size: var(--font-size-sm);
			cursor: pointer;
		}

		.done__card {
			margin-top: var(--space-3);
			padding: 1.25rem;
			border: 1px solid var(--color-border-card);
			border-radius: var(--radius-lg);
		}

		.done__card h2 {
			display: flex;
			align-items: center;
			gap: var(--space-2);
			margin: 0 0 var(--space-3);
			font-size: var(--font-size-lg);
			font-weight: var(--font-weight-medium);
		}

		.done__card h2 .ti {
			font-size: 16px;
			color: var(--color-accent);
		}

		.done__meet {
			display: grid;
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: var(--space-2);
			margin: 0 0 var(--space-3);
		}

		.done__meet div {
			padding: 10px var(--space-3);
			border-radius: var(--radius-md);
			background: var(--color-background-secondary);
		}

		.done__meet dt {
			font-size: var(--font-size-micro);
			text-transform: uppercase;
			letter-spacing: var(--letter-spacing-label);
			color: var(--color-text-tertiary);
		}

		.done__meet dd {
			margin: 0;
			font-size: var(--font-size-body-sm);
			font-weight: var(--font-weight-medium);
		}

		.done__map {
			display: inline-flex;
			align-items: center;
			gap: 6px;
			color: var(--color-text-info);
		}

		.done__next {
			display: grid;
			gap: var(--space-3);
			margin: 0;
			padding: 0;
			list-style: none;
		}

		/* Board 07: each step a soft card, its icon in a small tile, the title on its own line. */
		.done__next li {
			display: flex;
			gap: var(--space-3);
			padding: var(--space-3);
			border-radius: var(--radius-md);
			background: var(--color-background-secondary);
			font-size: var(--font-size-sm);
			color: var(--color-text-secondary);
		}

		.done__next .ti {
			display: grid;
			flex-shrink: 0;
			place-items: center;
			width: 28px;
			height: 28px;
			border-radius: var(--radius-sm);
			background: var(--color-background-primary);
			color: var(--color-accent);
		}

		.done__next strong {
			display: block;
			margin-bottom: 2px;
			color: var(--color-text-primary);
			font-weight: var(--font-weight-medium);
		}

		.done__actions {
			margin-top: var(--space-5);
			text-align: center;
		}

		@media (max-width: 768px) {
			.done__meet {
				grid-template-columns: 1fr;
			}
		}

		/* Printing the confirmation: just the booking. */
		@media print {
			:global(.mini-nav),
			:global(.trust-strip),
			.done__copy,
			.done__actions {
				display: none;
			}
		}
	}
</style>
