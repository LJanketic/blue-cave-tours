---
export const prerender = true;

/** Where the charter form lands without JavaScript, after a successful send (§8.2). */
import { REPLY_TIME, SITE_PHONE, SITE_PHONE_DISPLAY, pageTitle } from '../../config/site';
import SiteLayout from '../../layouts/SiteLayout.astro';
import Button from '../../components/ui/Button.astro';
---

<SiteLayout title={pageTitle('Request received')} robots="noindex" footerGap="32px">
	<main id="main" class="contact-result">
		<span class="contact-result__icon" aria-hidden="true"><i class="ti ti-circle-check"></i></span>
		<h1>Request received</h1>
		<p>We'll check the boat and skipper are free and email you a quote, usually {REPLY_TIME}. Nothing has been charged. If it's urgent, call <a href={`tel:${SITE_PHONE}`}>{SITE_PHONE_DISPLAY}</a> or
			<a href={`https://wa.me/${SITE_PHONE.replace(/\D/g, '')}`}>WhatsApp us</a>.</p>
		<div class="contact-result__actions">
			<Button href="/tours/?type=group">Browse group tours</Button>
			<Button href="/" variant="secondary">Back to home</Button>
		</div>
	</main>
</SiteLayout>

<style>
	@layer pages {
		.contact-result {
			width: 100%;
			max-width: 520px;
			margin: 0 auto;
			padding: calc(24px + 3rem) var(--page-gutter) var(--space-8);
			text-align: center;
		}

		.contact-result__icon {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			width: 56px;
			height: 56px;
			margin-bottom: var(--space-4);
			border-radius: 50%;
			background: var(--color-background-brand-soft);
			color: var(--color-text-brand);
			font-size: 28px;
		}

		h1 {
			margin: 0 0 var(--space-2);
			font-size: var(--font-size-hero);
			font-weight: var(--font-weight-medium);
			line-height: var(--line-height-tight);
		}

		p {
			margin: 0 0 var(--space-6);
			color: var(--color-text-secondary);
		}

		.contact-result__actions {
			display: flex;
			flex-wrap: wrap;
			justify-content: center;
			gap: var(--space-3);
		}
	}
</style>
