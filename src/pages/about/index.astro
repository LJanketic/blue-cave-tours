---
export const prerender = true;

/**
 * About (spec §7.4, board 13; 20 Oct handoff): photo hero like Tours and
 * Destinations, the stats band, three sections and the photo CTA band.
 * Content from src/data/about.ts; only confirmed stats show, and no guest
 * quotes or press until they're backed (D-5, C-4).
 */
import { FOUNDING_YEAR, pageTitle } from '../../config/site';
import { charterUrl } from '../../config/routes';
import SiteLayout from '../../layouts/SiteLayout.astro';
import PhotoHero from '../../components/ui/PhotoHero.astro';
import TrustBand from '../../components/home/TrustBand.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import Timeline from '../../components/ui/Timeline.astro';
import CtaBand from '../../components/ui/CtaBand.astro';
import Button from '../../components/ui/Button.astro';
import { ABOUT } from '../../data/about';
import type { TrustItem } from '../../data/marketing';
import { MAX_GUESTS } from '../../lib/booking';
import { HERO_IMAGE } from '../../data/hero-image';
import { firstPhotoForDestination } from '../../data/destination-photos';

// The band takes the homepage's TrustItem shape; the About stats keep theirs.
const trustItems: TrustItem[] = ABOUT.trustStats
	.filter((stat) => stat.confirmed)
	.map((stat) => ({ icon: stat.icon, strong: stat.value, text: stat.label, confirmed: true }));

// The hero keeps the page's boat aerial (dark water behind the text); the CTA
// band gets its own photo rather than repeating the homepage's lagoon.
const ctaPhoto = firstPhotoForDestination('pakleni', 6);
if (!ctaPhoto?.src) throw new Error('About CTA photo missing');
---

<SiteLayout
	title={pageTitle('About us: Split locals running boat tours')}
	description="Split locals running small-group boat tours and private experiences: Blue Cave, islands, and routes that follow the weather."
	solidNav={false}
	fontPreload
	footerGap="48px"
>
	<main id="main">
		<PhotoHero image={HERO_IMAGE.src} imagePosition="70% center" eyebrow={`Since ${FOUNDING_YEAR} · Split`} title="About us" lead={ABOUT.headline} />

		{/* A single item reads as a stray line, not a band: shown from two. */}
		{trustItems.length >= 2 && <TrustBand items={trustItems} id="about-stats" label="Hello Blue Cave in numbers" />}

		<div class="about">
			<section class="about__section" aria-labelledby="intro-heading">
				<SectionHeader variant="plain" title={ABOUT.headings.intro} id="intro-heading" />
				<p class="about__text">{ABOUT.intro}</p>
			</section>

			<section class="about__section" aria-labelledby="history-heading">
				<SectionHeader variant="plain" title={ABOUT.headings.story} id="history-heading" />
				<Timeline variant="history" items={ABOUT.foundingTimeline} />
			</section>

			<section class="about__section" aria-labelledby="values-heading">
				<SectionHeader variant="plain" title={ABOUT.headings.values} id="values-heading" />
				<ul class="about__values" role="list">
					{
						ABOUT.values.map((value) => (
							<li class="about__value">
								<i class={`ti ti-${value.icon}`} aria-hidden="true" />
								<h3>{value.title}</h3>
								<p>{value.description}</p>
							</li>
						))
					}
				</ul>
			</section>

			<CtaBand
				variant="photo"
				heading="Come sailing with us"
				text={`Most group tours depart daily. Private experiences for up to ${MAX_GUESTS} persons.`}
				image={ctaPhoto.src}
				imagePosition="center 60%"
				id="about-cta"
			>
				<Button variant="on-image" size="md" href="/tours/">Browse tours</Button>
				<Button variant="on-image-ghost" size="md" href={charterUrl()}>Plan a private experience</Button>
			</CtaBand>
		</div>
	</main>
</SiteLayout>

<style>
	@layer pages {
		.about {
			width: 100%;
			max-width: var(--content-max);
			margin: 0 auto;
			padding: var(--section-gap) var(--page-gutter) 0;
		}

		.about__text {
			max-width: 680px;
			margin: 0;
			font-size: var(--font-size-body-md);
			line-height: var(--line-height-body-md);
			color: var(--color-text-secondary);
		}

		.about__section {
			margin-bottom: var(--detail-gap);
		}

		.about__values {
			display: grid;
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: var(--space-3);
			margin: 0;
			padding: 0;
			list-style: none;
		}

		.about__value {
			padding: 14px var(--space-4);
			border-radius: var(--radius-lg);
			background: var(--color-background-secondary);
		}

		.about__value .ti {
			font-size: 18px;
			color: var(--color-accent);
		}

		.about__value h3 {
			margin: 6px 0 4px;
			font-size: var(--font-size-base);
			font-weight: var(--font-weight-medium);
		}

		.about__value p {
			margin: 0;
			font-size: var(--font-size-body-md);
			line-height: var(--line-height-body-md);
			color: var(--color-text-secondary);
		}

		@media (max-width: 768px) {
			.about__values {
				grid-template-columns: minmax(0, 1fr);
			}
		}
	}
</style>
