---
export const prerender = true;

/**
 * Privacy policy. Facts that need no legal judgement are fixed here (PR 6,
 * spec §7.2): the real processors, what's stored on your device, how to
 * complain. Legal bases, transfers, retention and the controller's identity
 * go through the lawyer (PR 11, D-18); the controller shows once IMPRINT is set.
 */
import LegalLayout from '../../layouts/LegalLayout.astro';
import Notice from '../../components/ui/Notice.astro';
import { IMPRINT } from '../../config/legal';
import { SITE_EMAIL, SITE_NAME } from '../../config/site';

const SECTIONS = [
	{ id: 'collect', title: 'What we collect' },
	{ id: 'use', title: 'How we use it' },
	{ id: 'sharing', title: 'Who processes it' },
	{ id: 'device', title: 'Your device' },
	{ id: 'rights', title: 'Your rights' },
	{ id: 'contact', title: 'Contact and complaints' },
];

const SUMMARY = [
	'We collect only what we need to run your booking or answer your message',
	'We never sell your data',
	'Payment details go directly to Teya or PayPal: we never see them',
	'No tracking or analytics cookies',
	'You can ask us to see, correct or delete your data at any time',
];

// LAWYER (PR 11): confirm each processor's entity and the transfer mechanism
// (EU-US Data Privacy Framework or standard contractual clauses) for the US ones.
const PROCESSORS = [
	{ name: 'Teya', role: 'Card payments', data: 'Name, email, payment details', where: 'To be confirmed' },
	{ name: 'PayPal', role: 'PayPal payments', data: 'Name, email, payment details', where: 'Luxembourg (EU)' },
	{ name: 'Netlify', role: 'Website hosting and booking storage', data: 'Booking and contact form details', where: 'United States' },
	{ name: 'Resend', role: 'Sending booking and contact emails', data: 'Name, email, phone, booking details', where: 'United States' },
	{ name: 'Cloudflare Turnstile', role: 'Spam check on the contact form, when switched on', data: 'Technical data from your browser', where: 'United States' },
];
---

<LegalLayout
	doc="privacy"
	title="Privacy policy"
	description={`How ${SITE_NAME} handles personal data for bookings and enquiries.`}
	summary={SUMMARY}
	sections={SECTIONS}
>
	{
		IMPRINT && (
			<p class="privacy-controller">
				Data controller: {IMPRINT.legalName}, {IMPRINT.address}, OIB {IMPRINT.oib}.
			</p>
		)
	}

	<section id="collect">
		<h2><i class="ti ti-database" aria-hidden="true"></i> 1. What we collect</h2>
		<p>
			When you book or contact us, we collect your name, email address, phone number, booking details, and what you
			write to us. We don't collect payment card details: Teya or PayPal handle those directly.
		</p>
	</section>

	<section id="use">
		<h2><i class="ti ti-settings" aria-hidden="true"></i> 2. How we use it</h2>
		<p>
			We use it only to run and manage your booking, send confirmations and pre-departure information, tell you
			about weather changes, and answer your messages.
		</p>
		<Notice tone="info"><p>We don't use your data for marketing without your explicit consent.</p></Notice>
	</section>

	<section id="sharing">
		<h2><i class="ti ti-share" aria-hidden="true"></i> 3. Who processes it</h2>
		<p>These services process data for us, only for the purpose listed:</p>
		<div class="table-wrap">
			<table>
				<thead>
					<tr>
						<th scope="col">Service</th>
						<th scope="col">Purpose</th>
						<th scope="col">Data</th>
						<th scope="col">Where</th>
					</tr>
				</thead>
				<tbody>
					{
						PROCESSORS.map((p) => (
							<tr>
								<td>{p.name}</td>
								<td>{p.role}</td>
								<td>{p.data}</td>
								<td>{p.where}</td>
							</tr>
						))
					}
				</tbody>
			</table>
		</div>
	</section>

	<section id="device">
		<h2><i class="ti ti-cookie" aria-hidden="true"></i> 4. Your device</h2>
		<p>
			We set no tracking or analytics cookies. We use <code>hbc_booking</code>, which is strictly necessary: it
			keeps your booking between steps for 2 hours. Cloudflare Turnstile runs on the contact form as a security
			check. <code>hbc_admin</code> is for staff login only.
		</p>
	</section>

	<section id="rights">
		<h2><i class="ti ti-user-check" aria-hidden="true"></i> 5. Your rights</h2>
		<p>
			You can ask to see, correct or delete your data, and you can complain to the Croatian Personal Data
			Protection Agency (AZOP). We keep booking records for as long as Croatian accounting law requires.
		</p>
	</section>

	<section id="contact">
		<h2><i class="ti ti-mail" aria-hidden="true"></i> 6. Contact and complaints</h2>
		<Notice tone="neutral" icon="shield-check">
			<p>
				For privacy requests or complaints, email <a href={`mailto:${SITE_EMAIL}`}>{SITE_EMAIL}</a>{IMPRINT && <> or write to {IMPRINT.address}</>}. We confirm receipt and reply within 15 days.
			</p>
		</Notice>
	</section>
</LegalLayout>

<style>
	@layer pages {
		.privacy-controller {
			margin: 0 0 var(--space-5);
			font-size: var(--font-size-sm);
			color: var(--color-text-secondary);
		}

		code {
			font-size: 0.9em;
		}
	}
</style>
