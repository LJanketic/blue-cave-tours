---
type Props = { class?: string };

const { class: className } = Astro.props;
---

<!-- Wraps InfoTiles: a description list, 2 columns (1 on phones); tiles in a row share its height. -->
<dl class:list={['info-tile-grid', className]}>
	<slot />
</dl>

<style>
	@layer components {
		.info-tile-grid {
			display: grid;
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: var(--space-2);
			margin: 0;
		}

		@media (max-width: 768px) {
			.info-tile-grid {
				grid-template-columns: 1fr;
			}
		}
	}
</style>
