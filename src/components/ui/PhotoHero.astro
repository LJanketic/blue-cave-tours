---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

type Props = {
	image: ImageMetadata;
	/** CSS object-position, e.g. '70% center' (Tours) or 'center 79%' (Destinations). */
	imagePosition?: string;
	eyebrow: string;
	eyebrowIcon?: string;
	title: string;
	lead: string;
};

const { image, imagePosition = 'center', eyebrow, eyebrowIcon, title, lead } = Astro.props;
---

<!--
	Full-bleed photo hero for Tours and Destinations (spec §6.2.1), under the
	overlay header. The photo is decorative (alt=""); the default slot holds
	the filter chips.
-->
<section class="photo-hero">
	<Picture
		src={image}
		alt=""
		formats={['webp']}
		fallbackFormat="webp"
		widths={[800, 1280, 1600, 1920]}
		sizes="100vw"
		quality={70}
		priority
		class="photo-hero__img"
		style={`object-position: ${imagePosition}`}
		pictureAttributes={{ class: 'photo-hero__picture' }}
	/>
	<div class="photo-hero__inner">
		<p class="photo-hero__eyebrow">
			{eyebrowIcon && <i class={`ti ti-${eyebrowIcon}`} aria-hidden="true" />}
			{eyebrow}
		</p>
		<h1 class="photo-hero__title display">{title}</h1>
		<p class="photo-hero__lead">{lead}</p>
		<slot />
	</div>
</section>

<style>
	@layer components {
		.photo-hero {
			position: relative;
			height: 540px; /* board 02 */
			overflow: hidden;
			background: var(--color-background-hero);
			color: var(--color-text-on-image);
		}

		.photo-hero__picture,
		.photo-hero__img {
			position: absolute;
			inset: 0;
			width: 100%;
			height: 100%;
			object-fit: cover;
		}

		/* Header fade plus a scrim strong enough for the text ([DEVIATE, a11y]: the
		   board's measured as low as 1.9:1 on the Tours photo, PR 4). */
		.photo-hero::after {
			content: '';
			position: absolute;
			inset: 0;
			background: var(--color-overlay-header), var(--color-overlay-photo-hero);
			pointer-events: none;
		}

		.photo-hero__inner {
			position: relative;
			z-index: 1;
			display: flex;
			flex-direction: column;
			align-items: flex-start;
			justify-content: flex-end;
			height: 100%;
			max-width: var(--content-max);
			margin: 0 auto;
			padding: 0 var(--space-6) 28px;
		}

		.photo-hero__eyebrow {
			display: inline-flex;
			align-items: center;
			gap: 6px;
			margin: 0 0 var(--space-3);
			font-size: var(--font-size-xs);
			font-weight: var(--font-weight-semibold);
			text-transform: uppercase;
			letter-spacing: var(--letter-spacing-eyebrow);
			color: var(--color-text-on-image-eyebrow);
		}

		.photo-hero__eyebrow .ti {
			font-size: 15px;
		}

		.photo-hero__title {
			margin: 0 0 14px;
			font-size: var(--font-size-display-lg);
			line-height: var(--line-height-display-hero);
			letter-spacing: var(--letter-spacing-display-hero);
			text-shadow: var(--text-shadow-title);
		}

		.photo-hero__lead {
			max-width: 440px;
			margin: 0 0 22px;
			font-size: var(--font-size-base);
			line-height: var(--line-height-relaxed);
			color: var(--color-text-on-image-muted);
		}

		@media (max-width: 768px) {
			.photo-hero {
				height: 480px;
			}

			.photo-hero__inner {
				padding: 0 var(--space-4) var(--space-5);
			}
		}

		/* Short viewports: the hero takes the height it needs (§11.14). */
		@media (max-height: 480px) {
			.photo-hero {
				height: auto;
				min-height: 0;
			}

			.photo-hero__inner {
				padding-top: calc(var(--site-header-height) + var(--space-6));
				padding-bottom: var(--space-7);
			}
		}
	}
</style>
