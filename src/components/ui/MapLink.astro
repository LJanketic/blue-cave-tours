---
import { Image } from 'astro:assets';
import type { MapImage } from '../../data/map-images';

type Props = {
	/** A Google Maps link (opens in a new tab). */
	href: string;
	/** Names the place, so the map image itself is decorative. */
	caption: string;
	/** From MAP_IMAGES; without one the block is a plain text link. */
	map?: MapImage;
	/** Box height in px. */
	height?: number;
};

const { href, caption, map, height = 140 } = Astro.props;
// The link name says where it goes once: captions that already name Google Maps only add the new tab.
const newTabHint = /google maps/i.test(caption) ? ' (new tab)' : ' (opens Google Maps in a new tab)';
---

<!--
	Map block (20 Oct handoff, Hvar and Contact): a static map under an 80%
	scrim with the caption on top, the whole block one link. Without a
	licensed image (D7) it's the grey text link the pages had before. The
	attribution sits outside the link, so it isn't part of the link's name.
-->
<div class="map-link-wrap">
	<a
		class:list={['map-link', map && 'map-link--image']}
		href={href}
		target="_blank"
		rel="noopener"
		style={`--map-link-height: ${height}px`}
	>
		{
			map && (
				<Image
					src={map.src}
					alt=""
					widths={[480, 960, 1440]}
					sizes="(max-width: 1008px) calc(100vw - 32px), 960px"
					quality={70}
					format="webp"
					class="map-link__img"
				/>
			)
		}
		<span class="map-link__caption">
			<i class="ti ti-map-2" aria-hidden="true"></i>
			<span>{caption}<span class="sr-only">{newTabHint}</span></span>
		</span>
	</a>
	{map && <small class="map-link__credit">{map.attribution}</small>}
</div>

<style>
	@layer components {
		.map-link-wrap {
			position: relative;
			margin-bottom: var(--space-3);
		}

		.map-link {
			position: relative;
			display: flex;
			align-items: center;
			justify-content: center;
			height: var(--map-link-height);
			overflow: hidden;
			border: 1px solid var(--color-border-card);
			border-radius: var(--radius-lg);
			background: var(--color-background-secondary);
			color: var(--color-text-primary);
			font-size: var(--font-size-sm);
			font-weight: var(--font-weight-medium);
			text-decoration: none;
		}

		.map-link:hover {
			background: var(--color-background-hover);
		}

		.map-link:focus-visible {
			outline: 2px solid var(--color-focus-ring);
			outline-offset: 3px;
		}

		.map-link__caption {
			position: relative;
			z-index: 1;
			display: inline-flex;
			align-items: center;
			gap: var(--space-2);
			padding: 0 var(--space-4);
			text-align: center;
		}

		.map-link__caption .ti {
			flex-shrink: 0;
			font-size: 20px;
			color: var(--color-accent);
		}

		/* With a map image: the scrim keeps the white caption readable on any map. */
		.map-link--image {
			border-color: transparent;
			background: var(--color-background-hero);
			color: var(--color-text-on-image);
		}

		.map-link__img {
			position: absolute;
			inset: 0;
			width: 100%;
			height: 100%;
			object-fit: cover;
		}

		.map-link--image::after {
			content: '';
			position: absolute;
			inset: 0;
			background: var(--color-overlay-map);
			transition: opacity var(--duration-fast) ease;
		}

		.map-link--image:hover::after {
			opacity: 0.9;
		}

		.map-link--image .map-link__caption .ti {
			color: inherit;
		}

		/* Over the map, outside the link: clicks fall through to the link. */
		.map-link__credit {
			position: absolute;
			right: var(--space-2);
			bottom: var(--space-1);
			z-index: 1;
			pointer-events: none;
			font-size: var(--font-size-micro);
			color: var(--color-text-on-image-muted);
		}

		@media (prefers-reduced-motion: reduce) {
			.map-link--image::after {
				transition: none;
			}
		}
	}
</style>
