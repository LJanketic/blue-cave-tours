---
type Props = {
	/** `display`: home and Tours section titles. `plain`: detail pages and About. */
	variant?: 'display' | 'plain';
	title: string;
	/** Optional line under a display title. */
	sub?: string;
	id?: string;
	/** Heading level; sections are h2 (§11.2). */
	level?: 2 | 3;
};

const { variant = 'display', title, sub, id, level = 2 } = Astro.props;
const Heading = `h${level}` as 'h2' | 'h3';
const hasActions = Astro.slots.has('actions');
---

{
	variant === 'display' ? (
		<div class:list={['section-head', sub && 'section-head--sub', hasActions && 'section-head--actions']}>
			<div>
				<Heading id={id} class="section-head__title display">
					{title}
				</Heading>
				{sub && <p class="section-head__sub">{sub}</p>}
			</div>
			{hasActions && (
				<div class="section-head__actions">
					<slot name="actions" />
				</div>
			)}
		</div>
	) : (
		<Heading id={id} class="section-head-plain">
			{title}
		</Heading>
	)
}

<style>
	@layer components {
		/* Spec §3.2 (board 01 .section-header / .section-title). */
		.section-head {
			display: flex;
			align-items: baseline;
			justify-content: space-between;
			gap: var(--space-4);
			margin: var(--section-gap) 0 var(--space-5);
		}

		.section-head--actions:not(.section-head--sub) {
			align-items: center;
		}

		.section-head--sub {
			align-items: flex-start;
		}

		.section-head__title {
			margin: 0;
			font-size: var(--font-size-display-md);
			line-height: var(--line-height-display-section);
			letter-spacing: var(--letter-spacing-display-section);
		}

		.section-head__sub {
			max-width: 520px;
			margin: var(--space-2) 0 0;
			font-size: var(--font-size-body-md);
			line-height: var(--line-height-body-md);
			color: var(--color-text-secondary);
		}

		.section-head__actions {
			display: flex;
			flex-shrink: 0;
			align-items: center;
			gap: var(--space-4);
		}

		.section-head--sub .section-head__actions {
			margin-top: -4px;
		}

		/* Narrow phones: the intro gets the full width, the actions go under it. */
		@media (max-width: 480px) {
			.section-head--sub.section-head--actions {
				flex-direction: column;
				gap: var(--space-3);
			}

			.section-head--sub .section-head__actions {
				margin-top: 0;
			}
		}

		/* board 03 .section-title */
		.section-head-plain {
			margin: 0 0 14px;
			padding-bottom: 10px;
			border-bottom: 0.5px solid var(--color-border-tertiary);
			font-size: var(--font-size-lg);
			font-weight: var(--font-weight-medium);
			line-height: var(--line-height-tight);
		}
	}
</style>
