---
import { IMPRINT } from '../config/legal';
import { charterUrl } from '../config/routes';
import {
	INSTAGRAM_HANDLE,
	INSTAGRAM_URL,
	LICENCE_CONFIRMED,
	SITE_BLURB,
	SITE_EMAIL,
	SITE_NAME,
	SITE_PHONE,
	SITE_PHONE_DISPLAY,
	whatsappLink,
} from '../config/site';

type Props = { /** Space above the footer, e.g. 'var(--section-gap)'. */ gap?: string };

const { gap } = Astro.props;

// Board 11 footer (ClickUp "Instagram" and "Contact Details", 4–5 Nov 2026):
// Instagram, WhatsApp and the mobile number under the blurb. The footer number
// is the one the operator picked for it (+385 98 702 250).
const CONTACTS = [
	{ icon: 'brand-instagram', label: `@${INSTAGRAM_HANDLE}`, href: INSTAGRAM_URL, external: true, sr: 'Instagram' },
	{ icon: 'brand-whatsapp', label: SITE_PHONE_DISPLAY, href: whatsappLink(SITE_PHONE), external: true, sr: 'WhatsApp' },
	{ icon: 'device-mobile', label: SITE_PHONE_DISPLAY, href: `tel:${SITE_PHONE}`, external: false, sr: 'Phone' },
];

// Spec §5.2 and decision D-19 (no "Sunset cruises": there's no such product).
const COLUMNS = [
	{
		heading: 'Tours',
		links: [
			{ href: '/tours/?type=group', label: 'Group tours' },
			{ href: charterUrl(), label: 'Private experiences' },
			{ href: '/tours/', label: 'Day trips' },
		],
	},
	{
		heading: 'Info',
		links: [
			{ href: '/about/', label: 'About us' },
			{ href: '/destinations/', label: 'Destinations' },
			{ href: '/faq/', label: 'FAQs' },
			{ href: '/contact/', label: 'Contact' },
		],
	},
	{
		heading: 'Legal',
		links: [
			{ href: '/legal/terms/', label: 'Terms & conditions' },
			{ href: '/legal/privacy/', label: 'Privacy policy' },
			{ href: '/legal/cancellation/', label: 'Cancellation policy' },
		],
	},
];
---

<footer class="site-footer" style={gap ? `--footer-gap: ${gap}` : undefined}>
	<div class="site-footer__grid">
		<div class="site-footer__brand">
			<a class="site-footer__logo" href="/">
				<i class="ti ti-sailboat" aria-hidden="true"></i>
				{SITE_NAME}
			</a>
			<p>{SITE_BLURB}</p>
			<ul class="site-footer__contacts" role="list">
				{
					CONTACTS.map((c) => (
						<li>
							<a href={c.href} {...(c.external ? { target: '_blank', rel: 'noopener' } : {})}>
								<i class={`ti ti-${c.icon}`} aria-hidden="true" />
								<span class="sr-only">{c.sr}: </span>
								{c.label}
								{c.external && <span class="sr-only"> (opens in a new tab)</span>}
							</a>
						</li>
					))
				}
			</ul>
		</div>
		{
			COLUMNS.map((column) => (
				<div class="site-footer__col">
					<h2>{column.heading}</h2>
					<ul role="list">
						{column.links.map((link) => (
							<li>
								<a href={link.href}>{link.label}</a>
							</li>
						))}
					</ul>
				</div>
			))
		}
	</div>
	<div class="site-footer__bottom">
		<span>
			&copy; {new Date().getFullYear()} {SITE_NAME}{IMPRINT && ` · ${IMPRINT.legalName}, ${IMPRINT.address}`}
		</span>
		{
			IMPRINT && (
				<span>
					OIB {IMPRINT.oib}{IMPRINT.mb && ` · MB ${IMPRINT.mb}`}{IMPRINT.activity && ` · Djelatnost ${IMPRINT.activity}`} ·{' '}
					<a href={`mailto:${SITE_EMAIL}`}>{SITE_EMAIL}</a>
				</span>
			)
		}
		{LICENCE_CONFIRMED && <span>Licensed maritime operator · Croatia</span>}
	</div>
</footer>

<style>
	@layer components {
		/* Spec §5.2 (board hbc.css .footer). Pages set the space above it with SiteLayout's footerGap. */
		.site-footer {
			width: 100%;
			max-width: var(--content-max);
			margin: var(--footer-gap, 0) auto 0;
			padding: 0 var(--page-gutter) var(--space-6);
		}

		.site-footer__grid {
			display: grid;
			grid-template-columns: 2fr 1fr 1fr 1fr;
			gap: var(--space-4);
			padding-top: var(--space-5);
			border-top: 0.5px solid var(--color-border-tertiary);
		}

		.site-footer__logo {
			display: inline-flex;
			align-items: center;
			gap: 7px;
			margin-bottom: 6px;
			font-size: var(--font-size-md);
			font-weight: var(--font-weight-medium);
			color: var(--color-text-primary);
			text-decoration: none;
		}

		.site-footer__logo .ti {
			font-size: var(--font-size-lg);
			color: var(--color-brand);
		}

		.site-footer__brand p {
			max-width: 240px;
			margin: 0;
			font-size: var(--font-size-body-sm);
			line-height: var(--line-height-body-sm);
			color: var(--color-text-secondary);
		}

		.site-footer__contacts {
			display: flex;
			flex-direction: column;
			gap: 6px;
			margin: var(--space-3) 0 0;
			padding: 0;
			list-style: none;
		}

		.site-footer__contacts a {
			display: inline-flex;
			align-items: center;
			gap: 8px;
			font-size: var(--font-size-body-sm);
			line-height: var(--line-height-body-sm);
			color: var(--color-text-secondary);
			text-decoration: none;
		}

		.site-footer__contacts a:hover {
			color: var(--color-text-primary);
		}

		.site-footer__contacts .ti {
			font-size: var(--font-size-md);
		}

		/* h2 for a correct outline; styled as the board's small uppercase label. */
		.site-footer__col h2 {
			margin: 0 0 10px;
			font-size: var(--font-size-micro);
			font-weight: var(--font-weight-medium);
			text-transform: uppercase;
			letter-spacing: var(--letter-spacing-label);
			color: var(--color-text-tertiary);
		}

		.site-footer__bottom a {
			color: inherit;
		}

		.site-footer__col ul {
			margin: 0;
			padding: 0;
			list-style: none;
		}

		.site-footer__col a {
			display: inline-block;
			margin-bottom: var(--space-2);
			font-size: var(--font-size-body-sm);
			line-height: var(--line-height-body-sm);
			color: var(--color-text-secondary);
			text-decoration: none;
		}

		.site-footer__col a:hover {
			color: var(--color-text-primary);
		}

		.site-footer__bottom {
			display: flex;
			flex-wrap: wrap;
			justify-content: space-between;
			gap: var(--space-2);
			margin-top: var(--space-4);
			padding-top: 14px;
			border-top: 0.5px solid var(--color-border-tertiary);
			font-size: var(--font-size-body-sm);
			line-height: var(--line-height-body-sm);
			color: var(--color-text-tertiary);
		}

		@media (max-width: 768px) {
			.site-footer__grid {
				grid-template-columns: 1fr 1fr;
			}
		}

		@media (max-width: 480px) {
			.site-footer__grid {
				grid-template-columns: 1fr;
			}
		}
	}
</style>
