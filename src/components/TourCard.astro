---
import type { TourDetail } from '../types/tour';
import { contactHrefForTour, groupBookHref, isGroupTour, supportsInstantBook, tourPriceUnit } from '../lib/booking';
import { getTourCardPhoto } from '../lib/tours';
import TourImage from './TourImage.astro';

type Props = {
	tour: TourDetail;
	featured?: boolean;
};

const { tour, featured = false } = Astro.props;
const types = tour.types;
const metaIcon = isGroupTour(tour) ? 'users' : 'crown';
const metaLabel = types.map((type) => (type === 'group' ? 'Group' : 'Private')).join(' / ');
const cardPhoto = getTourCardPhoto(tour);
const instantBook = supportsInstantBook(tour);
const bookHref = instantBook ? groupBookHref(tour) : contactHrefForTour(tour);
const priceUnit = tourPriceUnit(tour);
---

<article class:list={['tour-card', featured && 'featured']}>
	<a href={`/tours/${tour.slug}/`} class="tour-card__link">
		<div class="tc-img card-img">
			<TourImage photo={cardPhoto} layout="card" />
			<div class="img-badges">
				{featured && <span class="tc-badge img-badge badge-bestseller">Best seller</span>}
				{tour.badge === 'new' && <span class="tc-badge img-badge badge-new">New</span>}
				{types.map((type) => (
					<span class:list={['tc-badge img-badge', type === 'group' ? 'badge-group' : 'badge-private']}>
						{type === 'group' ? 'Group' : 'Private'}
					</span>
				))}
			</div>
		</div>
		<div class="tc-body card-body">
			<h3 class="tc-name card-title">{tour.title}</h3>
			<div class="tc-meta card-meta">
				<span class="meta-item"><i class="ti ti-clock"></i> {tour.duration}</span>
				<span class="meta-item">
					<i class={`ti ti-${metaIcon}`}></i>
					{metaLabel}
				</span>
			</div>
			<p class="card-desc">{tour.shortDescription}</p>
			<div class="tc-foot card-footer">
				<div>
					{priceUnit && <span class="price-from">From </span>}
					<span class="tc-price price-val">{tour.fromPrice}</span>
					{priceUnit && <span class="price-per"> {priceUnit}</span>}
				</div>
			</div>
		</div>
	</a>
	<div class="tour-card__actions">
		<a class="btn-secondary tour-card__details" href={`/tours/${tour.slug}/`}>Details</a>
		<a class="btn-primary" href={bookHref}>{instantBook ? 'Book now' : 'Enquire'}</a>
	</div>
</article>
