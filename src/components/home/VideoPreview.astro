---
import type { ImageMetadata } from 'astro';
import { getImage, Picture } from 'astro:assets';
import type { HomeVideo } from '../../config/video';
import { assertHomeVideo, videoMetaText, videoPlayLabel } from '../../lib/video-preview';

type Props = {
	video: HomeVideo;
	/** Decorative photo behind the navy band (the CTA band's photo, spec §3.4). */
	bandImage?: ImageMetadata;
	/** CSS object-position for the band photo. */
	bandPosition?: string;
};

const { video, bandImage, bandPosition = 'center 93%' } = Astro.props;
assertHomeVideo(video);

const label = videoPlayLabel(video.durationSeconds);
const meta = videoMetaText(video.durationSeconds);
// The <video> poster: same still, one size, so the swap doesn't flash black.
const posterUrl = (await getImage({ src: video.poster, width: 1280, format: 'webp', quality: 70 })).src;
---

<!--
	Spec §6.1.4 (board 01 .vp), §3.4, §11.11. Without JavaScript the poster is a
	link to the MP4. The script turns it into a button that, on click, swaps in
	the <video> from the template (nothing is fetched before that: preload="none"
	and the template is inert), starts it and moves focus to it.
-->
<section class="vp" aria-labelledby="vp-title" data-video-preview>
	<div class="vp__band" aria-hidden="true">
		{
			bandImage && (
				<Picture
					src={bandImage}
					alt=""
					formats={['webp']}
					fallbackFormat="webp"
					widths={[640, 960, 1280, 1920]}
					sizes="100vw"
					quality={60}
					loading="lazy"
					class="vp__band-img"
					style={`object-position: ${bandPosition}`}
					pictureAttributes={{ class: 'vp__band-picture' }}
				/>
			)
		}
	</div>
	<div class="vp__inner">
		<p class="vp__eyebrow">Experience it first-hand</p>
		<h2 id="vp-title" class="vp__title display">Preview from our tours</h2>
		<div class="vp__media on-photo">
			<a class="vp__player" href={video.src} aria-label={label} aria-describedby="vp-desc" data-vp-player>
				<Picture
					src={video.poster}
					alt=""
					formats={['webp']}
					fallbackFormat="webp"
					widths={[480, 720, 960, 1280]}
					sizes="(max-width: 960px) calc(100vw - 32px), 912px"
					quality={70}
					loading="lazy"
					class="vp__poster"
					pictureAttributes={{ class: 'vp__poster-picture' }}
				/>
				<span class="vp__play" aria-hidden="true">
					<svg viewBox="0 0 24 24" focusable="false"><path d="M7 4.5v15a1 1 0 0 0 1.5.86l12.5-7.5a1 1 0 0 0 0-1.72L8.5 3.64A1 1 0 0 0 7 4.5z"></path></svg>
				</span>
				<span class="vp__meta" aria-hidden="true"><i class="ti ti-clock"></i>{meta}</span>
			</a>
			<template data-vp-video>
				<video class="vp__video" src={video.src} poster={posterUrl} controls playsinline preload="none" aria-label="Tour preview video" aria-describedby="vp-desc"></video>
			</template>
		</div>
		<p id="vp-desc" class="vp__desc">{video.description}</p>
	</div>
</section>

<script>
	import '../../client/video-preview';
</script>

<style>
	@layer components {
		.vp {
			position: relative;
			isolation: isolate;
			margin-top: 0; /* straight after the trust band (§6.1.3) */
		}

		/* Navy band behind the top of the player. */
		.vp__band {
			position: absolute;
			inset: 0 0 auto;
			z-index: -1;
			height: 54%;
			overflow: hidden;
			background: var(--color-background-hero);
		}

		.vp__band::after {
			content: '';
			position: absolute;
			inset: 0;
			background: var(--color-overlay-video-band);
		}

		.vp__band-picture,
		.vp__band-img {
			position: absolute;
			inset: 0;
			width: 100%;
			height: 100%;
			object-fit: cover;
		}

		.vp__inner {
			max-width: var(--content-max);
			margin: 0 auto;
			padding: 32px 24px 0;
			text-align: center;
		}

		.vp__eyebrow {
			margin: 0 0 8px;
			font-size: var(--font-size-sm);
			font-weight: var(--font-weight-medium);
			letter-spacing: 0.02em;
			color: var(--color-text-on-image-muted);
		}

		.vp__title {
			margin: 0 0 28px;
			font-size: var(--font-size-display-md);
			line-height: var(--line-height-display-section);
			letter-spacing: var(--letter-spacing-display-section);
			color: var(--color-text-on-image);
		}

		.vp__media {
			position: relative;
		}

		.vp__player,
		.vp__video {
			display: block;
			width: 100%;
			aspect-ratio: 16 / 9;
			border-radius: var(--radius-2xl);
			background: var(--color-background-media);
			box-shadow: var(--shadow-media);
		}

		.vp__player {
			position: relative;
			overflow: hidden;
			padding: 0;
			border: 0;
			color: var(--color-text-on-image);
			text-decoration: none;
			cursor: pointer;
		}

		.vp__player::after {
			content: '';
			position: absolute;
			inset: 0;
			background: var(--color-overlay-video-meta);
			pointer-events: none;
		}

		.vp__player :global(.vp__poster-picture),
		.vp__player :global(.vp__poster) {
			display: block;
			width: 100%;
			height: 100%;
			object-fit: cover;
		}

		.vp__player :global(.vp__poster) {
			transition: transform var(--duration-slow) ease;
		}

		.vp__player:hover :global(.vp__poster) {
			transform: scale(1.03);
		}

		.vp__play {
			position: absolute;
			top: 50%;
			left: 50%;
			z-index: 1;
			display: flex;
			align-items: center;
			justify-content: center;
			width: 84px;
			height: 84px;
			margin: -42px 0 0 -42px;
			border-radius: 50%;
			background: var(--color-cta-on-image);
			box-shadow: var(--shadow-play);
			transition:
				transform 0.25s ease,
				box-shadow 0.25s ease;
		}

		.vp__play svg {
			width: 28px;
			height: 28px;
			margin-left: 4px;
			fill: var(--color-text-on-image);
		}

		.vp__player:hover .vp__play,
		.vp__player:focus-visible .vp__play {
			transform: scale(1.08);
			box-shadow: var(--shadow-play-hover);
		}

		.vp__meta {
			position: absolute;
			bottom: 16px;
			left: 20px;
			z-index: 1;
			display: flex;
			align-items: center;
			gap: 8px;
			font-size: var(--font-size-sm);
			font-weight: var(--font-weight-medium);
		}

		.vp__meta .ti {
			font-size: 16px;
		}

		.vp__desc {
			max-width: 640px;
			margin: var(--space-3) auto 0;
			font-size: var(--font-size-sm);
			line-height: var(--line-height-relaxed);
			color: var(--color-text-secondary);
		}

		/* Reduced motion: no zoom on the poster or the disc, the shadow still changes. */
		@media (prefers-reduced-motion: reduce) {
			.vp__player:hover :global(.vp__poster),
			.vp__player:hover .vp__play,
			.vp__player:focus-visible .vp__play {
				transform: none;
			}
		}

		@media (max-width: 768px) {
			.vp__band {
				height: 49%;
			}

			.vp__inner {
				padding: 24px 16px 0;
			}

			.vp__title {
				margin-bottom: 20px;
			}

			.vp__player,
			.vp__video {
				border-radius: var(--radius-xl);
			}

			.vp__play {
				width: 64px;
				height: 64px;
				margin: -32px 0 0 -32px;
			}

			.vp__play svg {
				width: 22px;
				height: 22px;
			}

			.vp__meta {
				bottom: 12px;
				left: 14px;
			}
		}
	}
</style>
