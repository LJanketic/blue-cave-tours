---
import Marquee from '../ui/Marquee.astro';
import type { TrustItem } from '../../data/marketing';

type Props = {
	items: TrustItem[];
	id?: string;
	/** Accessible name of the band. */
	label?: string;
};

const { items, id = 'trust', label = 'Why book with us' } = Astro.props;
const shown = items.filter((item) => item.confirmed);
// Two items don't fill a marquee loop (an empty strip shows before it jumps
// back) or a 1040px row: they sit centred and wrap instead.
const still = shown.length <= 2;
---

<!--
	Spec §6.1.3. One row on wide screens; a slow marquee from 1040px down,
	which wraps into a 2×2 grid under reduced motion. The marquee copy has no
	links (its screen-reader list is visually hidden); the cancellation policy
	is in the footer too. Two items or fewer: one centred row at every width.
-->
<section class:list={['trust-band', still && 'trust-band--still']} id={id} aria-label={label}>
	<ul class="trust-band__row" role="list">
		{
			shown.map((item) => (
				<li class="trust-band__item">
					<i class={`ti ti-${item.icon}`} aria-hidden="true" />
					{item.href ? (
						<a href={item.href}>
							<strong>{item.strong}</strong> {item.text}
						</a>
					) : (
						<span>
							<strong>{item.strong}</strong> {item.text}
						</span>
					)}
				</li>
			))
		}
	</ul>
	{
		!still && (
			<Marquee label={label} duration={40} class="trust-band__marquee">
				{shown.map((item) => (
					<li class="trust-band__item">
						<i class={`ti ti-${item.icon}`} aria-hidden="true" />
						<span>
							<strong>{item.strong}</strong> {item.text}
						</span>
					</li>
				))}
			</Marquee>
		)
	}
</section>

<style>
	@layer components {
		.trust-band {
			--marquee-gap: 48px;
			--marquee-fade: 64px;
			background: var(--color-background-primary);
		}

		.trust-band__row {
			display: flex;
			justify-content: space-between;
			gap: var(--space-4);
			max-width: 1040px;
			margin: 0 auto;
			padding: var(--space-5) var(--space-6);
			list-style: none;
		}

		.trust-band--still .trust-band__row {
			flex-wrap: wrap;
			justify-content: center;
			gap: var(--space-3) var(--space-8);
		}

		.trust-band__item {
			display: flex;
			align-items: center;
			gap: var(--space-2);
			font-size: 0.9375rem; /* the board's 15px, between the sm and base tokens */
			color: var(--color-text-secondary);
			white-space: nowrap;
		}

		.trust-band__item strong {
			font-weight: var(--font-weight-semibold);
			color: var(--color-text-primary);
		}

		.trust-band__item .ti {
			font-size: 20px;
			color: var(--color-accent);
		}

		.trust-band__item a {
			color: inherit;
			text-decoration: none;
		}

		.trust-band__item a:hover {
			text-decoration: underline;
			text-underline-offset: 3px;
		}

		.trust-band :global(.trust-band__marquee) {
			display: none;
			padding: var(--space-5) 0;
		}

		/* [DEVIATE, layout] Our copy is longer than the board's ("…on group
		   tours", "Small boats, real skippers"): at 15px the four items need
		   ~1034px, so the row is wider than the 960 column and the marquee
		   starts at 1040px instead of 1024px. */
		@media (max-width: 1040px) {
			.trust-band:not(.trust-band--still) .trust-band__row {
				display: none;
			}

			.trust-band :global(.trust-band__marquee) {
				display: block;
			}
		}

		/* Still (reduced motion, no JavaScript): a 2×2 grid instead of a moving strip. */
		@media (max-width: 1040px) and (prefers-reduced-motion: reduce), (max-width: 1040px) and (scripting: none) {
			/* Not the loop's second copy: Marquee hides it here, and display: grid would bring it back. */
			.trust-band :global(.marquee__set:not(.marquee__copy)) {
				display: grid;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				gap: var(--space-3) var(--space-4);
				padding: 0 var(--page-gutter);
			}

			.trust-band :global(.trust-band__item) {
				white-space: normal;
			}
		}

		@media (max-width: 768px) {
			.trust-band {
				--marquee-gap: 40px;
			}

			.trust-band :global(.trust-band__marquee) {
				padding: var(--space-4) 0;
			}

			.trust-band__item {
				font-size: var(--font-size-sm);
			}

			.trust-band--still .trust-band__row {
				padding: var(--space-4) var(--page-gutter);
			}

			.trust-band--still .trust-band__item {
				white-space: normal;
			}
		}
	}
</style>
