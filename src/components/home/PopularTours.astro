---
import SectionHeader from '../ui/SectionHeader.astro';
import PillLink from '../ui/PillLink.astro';
import TourCard from '../vue/TourCard.vue';
import type { TourCardDTO } from '../../lib/cards';

type Props = { tours: TourCardDTO[] };

const { tours } = Astro.props;
---

<!--
	Spec §6.1.5, handoff H9. A native horizontal scroller: the arrows, trackpad,
	touch and the keyboard (it's a focusable region while it overflows) all move
	it, and it still scrolls without JavaScript. No mouse drag, so the cards keep
	their hover.
-->
<section class="popular" aria-labelledby="popular-heading" data-slider>
	<div class="popular__head">
		<SectionHeader title="Popular tours" id="popular-heading">
			<PillLink href="/tours/" slot="actions">See all tours</PillLink>
		</SectionHeader>
	</div>
	<div class="popular__frame">
		<!-- Before the cards in the DOM, as they were in the header: a keyboard reaches them without tabbing through every card. -->
		<button type="button" class="popular__arrow popular__arrow--prev" data-slider-prev aria-label="Previous tours" disabled>
			<i class="ti ti-chevron-left" aria-hidden="true"></i>
		</button>
		<button type="button" class="popular__arrow popular__arrow--next" data-slider-next aria-label="Next tours">
			<i class="ti ti-chevron-right" aria-hidden="true"></i>
		</button>
		<!-- The scroller wraps the list: it becomes a labelled region while it overflows, the list stays a list. -->
		<div class="popular__track" data-slider-track data-scroll-region="Popular tours, scrollable">
		<ul class="popular__list" role="list">
			{
				tours.map((tour) => (
					<li class="popular__item">
						<TourCard tour={tour} />
					</li>
				))
			}
			<li class="popular__item">
				<TourCard variant="see-all" href="/tours/" />
			</li>
		</ul>
		</div>
		<span class="popular__fade popular__fade--left" aria-hidden="true"></span>
		<span class="popular__fade popular__fade--right" aria-hidden="true"></span>
	</div>
</section>

<script>
	import '../../client/scroll-regions';

	for (const slider of document.querySelectorAll<HTMLElement>('[data-slider]')) {
		const track = slider.querySelector<HTMLElement>('[data-slider-track]');
		const prev = slider.querySelector<HTMLButtonElement>('[data-slider-prev]');
		const next = slider.querySelector<HTMLButtonElement>('[data-slider-next]');
		if (!track || !prev || !next) continue;
		const trackEl = track;

		// One card plus the gap per click.
		const stepWidth = () => (trackEl.querySelector('.popular__item')?.getBoundingClientRect().width ?? 300) + 16;
		const reduced = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		const move = (direction: 1 | -1) =>
			trackEl.scrollBy({ left: direction * stepWidth(), behavior: reduced() ? 'auto' : 'smooth' });

		/*
		 * At each end the arrow is disabled: it fades out and leaves the tab order
		 * (handoff H9). If it has focus, focus moves to the other arrow first, so
		 * it never drops to <body> (WCAG 2.4.3).
		 */
		const setDisabled = (button: HTMLButtonElement, other: HTMLButtonElement, disabled: boolean) => {
			if (button.disabled === disabled) return;
			if (disabled && document.activeElement === button) {
				const fallback = other.disabled ? trackEl.querySelector<HTMLElement>('a') : other;
				fallback?.focus({ preventScroll: true });
			}
			button.disabled = disabled;
		};
		const sync = () => {
			const max = trackEl.scrollWidth - trackEl.clientWidth - 2;
			const atStart = trackEl.scrollLeft <= 2;
			const atEnd = trackEl.scrollLeft >= max;
			// Enable before disabling, so the focus guard has somewhere to go.
			if (!atStart) setDisabled(prev, next, false);
			if (!atEnd) setDisabled(next, prev, false);
			setDisabled(prev, next, atStart);
			setDisabled(next, prev, atEnd);
		};
		prev.addEventListener('click', () => move(-1));
		next.addEventListener('click', () => move(1));
		trackEl.addEventListener('scroll', sync, { passive: true });
		new ResizeObserver(sync).observe(trackEl);
		sync();
	}
</script>

<style>
	@layer components {
		.popular__head {
			max-width: var(--content-max);
			margin: 0 auto;
			padding: 0 var(--page-gutter);
		}

		.popular__frame {
			--slider-gutter: max(var(--space-6), calc((100% - 912px) / 2));
			position: relative;
		}

		.popular__track {
			overflow-x: auto;
			scroll-padding-inline: var(--slider-gutter);
			scroll-snap-type: x mandatory;
			scrollbar-width: none;
		}

		.popular__list {
			display: flex;
			gap: var(--space-4);
			width: max-content;
			margin: 0;
			padding: 4px var(--slider-gutter) 8px;
			list-style: none;
		}

		.popular__track::-webkit-scrollbar {
			display: none;
		}

		.popular__track:focus-visible {
			outline-offset: -2px;
		}

		.popular__item {
			display: flex;
			flex: 0 0 300px; /* board 01 */
			scroll-snap-align: start;
		}

		.popular__item > :global(*) {
			flex: 1;
		}

		/* The board's edge fades: solid across the left gutter, a soft fade on the right. */
		.popular__fade {
			position: absolute;
			top: 0;
			bottom: 0;
			z-index: 1;
			width: var(--slider-gutter);
			pointer-events: none;
		}

		.popular__fade--left {
			left: 0;
			background: var(--color-background-primary);
		}

		.popular__fade--right {
			right: 0;
			background: linear-gradient(270deg, var(--color-background-primary) 0%, var(--color-surface-fade) 35%, transparent 100%);
		}

		/* On the cards (H9): white circles centred on the row, straddling the edges of the visible window. */
		.popular__arrow {
			position: absolute;
			top: 50%;
			z-index: 2;
			display: flex;
			align-items: center;
			justify-content: center;
			width: 44px;
			height: 44px;
			padding: 0;
			border: 0;
			border-radius: 50%;
			background: var(--color-background-primary);
			box-shadow: var(--shadow-pill);
			color: var(--color-text-primary);
			font-size: 20px;
			cursor: pointer;
			translate: 0 -50%;
			transition:
				opacity var(--duration-fast) ease,
				background-color var(--duration-fast) ease;
		}

		.popular__arrow--prev {
			left: calc(var(--slider-gutter) - 22px);
		}

		.popular__arrow--next {
			right: calc(var(--slider-gutter) - 22px);
		}

		.popular__arrow:hover {
			background: var(--color-background-secondary);
		}

		.popular__arrow:disabled {
			opacity: 0;
			pointer-events: none;
		}

		@media (prefers-reduced-motion: reduce) {
			.popular__arrow {
				transition: none;
			}
		}

		@media (max-width: 768px) {
			.popular__arrow {
				display: none;
			}

			.popular__frame {
				--slider-gutter: var(--space-4);
			}

			.popular__item {
				flex-basis: min(300px, 82vw); /* the row is full-bleed on phones */
			}

		}
	}
</style>
