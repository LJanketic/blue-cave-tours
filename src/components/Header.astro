---
import { SITE_NAME } from '../config/site';

type Props = {
	/** When false the bar floats (fixed) over a full-bleed hero (homepage). */
	solid?: boolean;
};

const { solid = false } = Astro.props;
// Production serves directory-style URLs (/about/), dev serves /about — strip the
// trailing slash so exact-match checks work in both.
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';

// `exact`: only highlight on the page itself, not on pages below it.
const NAV_LINKS = [
	{ href: '/tours/', label: 'Tours', exact: false },
	{ href: '/destinations/', label: 'Destinations', exact: false },
	{ href: '/about/', label: 'About', exact: true },
	{ href: '/faq/', label: 'FAQ', exact: false },
	{ href: '/contact/', label: 'Contact', exact: false },
];
---

<header class:list={['nav', !solid && 'nav--floating']} id="site-header" data-floating={String(!solid)}>
	<div class="nav-inner">
		<a class="nav-logo" href="/">
			<i class="ti ti-sailboat" aria-hidden="true"></i>
			{SITE_NAME}
		</a>
		<nav class="nav-links" id="primary-nav" aria-label="Main">
			<button type="button" class="nav-close" id="menu-close" aria-label="Close menu">
				<i class="ti ti-x" aria-hidden="true"></i>
			</button>
			{
				NAV_LINKS.map(({ href, label, exact }) => {
					const path = href.replace(/\/$/, '');
					const isPage = currentPath === path;
					const inSection = !exact && currentPath.startsWith(`${path}/`);
					return (
						<a
							class:list={['nav-link', (isPage || inSection) && 'nav-link--active']}
							aria-current={isPage ? 'page' : inSection ? 'location' : undefined}
							href={href}
						>
							{label}
						</a>
					);
				})
			}
		</nav>
		<a class="btn-primary nav-cta" href="/tours/">Book now</a>
		<button type="button" class="nav-toggle" id="menu-toggle" aria-expanded="false" aria-controls="primary-nav">
			<span class="sr-only">Menu</span>
			<i class="ti ti-menu-2" aria-hidden="true"></i>
		</button>
	</div>
</header>

<script>
	const header = document.getElementById('site-header');
	const toggle = document.getElementById('menu-toggle');
	const closeBtn = document.getElementById('menu-close');
	const nav = document.getElementById('primary-nav');

	if (header && toggle && nav) {
		const headerEl = header;
		const toggleEl = toggle;
		const navEl = nav;

		const focusableSelector =
			'a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])';

		// The open menu covers the whole screen, so the trap cycles through the panel
		// only (close button + links). getClientRects() also counts the close button,
		// which is position: fixed and so has no offsetParent.
		function getFocusables(): HTMLElement[] {
			return Array.from(navEl.querySelectorAll<HTMLElement>(focusableSelector)).filter(
				(el) => !el.hasAttribute('disabled') && el.getClientRects().length > 0,
			);
		}

		// Everything the panel covers is taken out of the tab order and the
		// accessibility tree while it's open.
		function coveredElements(): HTMLElement[] {
			const covered = [
				...headerEl.querySelectorAll<HTMLElement>('.nav-logo, .nav-cta, #menu-toggle'),
				...document.querySelectorAll<HTMLElement>('main, .footer-shell, .skip-link'),
			];
			return covered.filter((el) => !navEl.contains(el));
		}

		function setOpen(open: boolean) {
			headerEl.classList.toggle('nav--open', open);
			document.body.classList.toggle('nav-menu-open', open);
			toggleEl.setAttribute('aria-expanded', String(open));
			document.body.style.overflow = open ? 'hidden' : '';
			for (const el of coveredElements()) el.inert = open;

			if (open) {
				const firstNavLink = navEl.querySelector<HTMLElement>('a.nav-link');
				firstNavLink?.focus();
			} else if (toggleEl.getClientRects().length > 0) {
				// Skipped when the menu closes because the window widened past the
				// mobile breakpoint: the toggle is hidden there and can't take focus.
				toggleEl.focus();
			}
		}

		function closeMenu() {
			if (headerEl.classList.contains('nav--open')) {
				setOpen(false);
			}
		}

		toggleEl.addEventListener('click', () => {
			setOpen(!headerEl.classList.contains('nav--open'));
		});

		closeBtn?.addEventListener('click', closeMenu);

		// The overlay only exists below the mobile breakpoint. If the window grows
		// past it while open (rotation, resize), close it so the page isn't left
		// inert with scrolling locked. Same query as the mobile block in _base.css,
		// negated, so fractional widths (e.g. 768.4px when zoomed) can't fall between.
		window.matchMedia('(max-width: 768px)').addEventListener('change', (event) => {
			if (!event.matches) closeMenu();
		});

		document.addEventListener('click', (event) => {
			if (!headerEl.contains(event.target as Node)) {
				closeMenu();
			}
		});

		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape') {
				closeMenu();
				return;
			}

			if (event.key !== 'Tab' || !headerEl.classList.contains('nav--open')) {
				return;
			}

			const focusables = getFocusables();
			if (focusables.length === 0) {
				return;
			}

			const first = focusables[0];
			const last = focusables[focusables.length - 1];
			const active = document.activeElement;

			if (event.shiftKey && active === first) {
				event.preventDefault();
				last.focus();
			} else if (!event.shiftKey && active === last) {
				event.preventDefault();
				first.focus();
			}
		});

		// Scroll behaviour: solidify past 40px, hide on scroll-down / show on
		// scroll-up (never while the mobile menu is open). rAF-throttled.
		let lastY = window.scrollY;
		let ticking = false;

		function onScroll() {
			const y = window.scrollY;
			headerEl.classList.toggle('nav-solid', y > 40);

			const menuOpen = headerEl.classList.contains('nav--open');
			if (!menuOpen) {
				if (y > lastY && y > 80) {
					headerEl.classList.add('nav-hidden');
				} else {
					headerEl.classList.remove('nav-hidden');
				}
			}
			lastY = y;
			ticking = false;
		}

		window.addEventListener(
			'scroll',
			() => {
				if (!ticking) {
					requestAnimationFrame(onScroll);
					ticking = true;
				}
			},
			{ passive: true },
		);

		onScroll();
	}
</script>
