{
  "name": "hello-blue-cave-landing",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check": "node scripts/astro-check.mjs && node scripts/icons.mjs --check && node scripts/thumbs.mjs --check && node scripts/tokens-check.mjs",
    "icons": "node scripts/icons.mjs",
    "thumbs": "node scripts/thumbs.mjs",
    "test": "vitest run",
    "astro": "astro",
    "test:e2e": "playwright test tests/e2e",
    "test:visual": "playwright test tests/visual",
    "test:a11y": "playwright test tests/a11y --project=chromium",
    "tokens": "node scripts/tokens-check.mjs",
    "fonts": "node scripts/fonts.mjs"
  },
  "dependencies": {
    "@astrojs/netlify": "^8.2.12",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/vue": "^7.1.2",
    "@netlify/blobs": "^11.1.9",
    "astro": "^7.4.8",
    "sharp": "^0.35.5",
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "esbuild": "0.28.1",
    "subset-font": "^2.9.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
