{
  "name": "hello-blue-cave-landing",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check": "astro check && node scripts/icons.mjs --check && node scripts/thumbs.mjs --check && node scripts/tokens-check.mjs",
    "icons": "node scripts/icons.mjs",
    "thumbs": "node scripts/thumbs.mjs",
    "test": "vitest run",
    "astro": "astro",
    "test:e2e": "playwright test tests/e2e",
    "test:visual": "playwright test tests/visual",
    "test:a11y": "playwright test tests/a11y --project=chromium",
    "tokens": "node scripts/tokens-check.mjs",
    "fonts": "node scripts/fonts.mjs"
  },
  "dependencies": {
    "@astrojs/netlify": "^7.0.13",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/vue": "^6.0.1",
    "@netlify/blobs": "^10.7.13",
    "astro": "^6.4.8",
    "sharp": "^0.34.5",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "subset-font": "^2.9.0",
    "typescript": "^6.0.3",
    "vitest": "^3.2.7"
  }
}
